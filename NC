function Window:openSettings()
    local panel = self:buildSettings()
    if self.settingsOpen then return end
    self.settingsOpen = true

    panel.Visible = true
    if self.controls then self.controls.Visible = false end
    Anim.tween(panel, 0.4, {
        Position = UDim2.new(1, -(SETTINGS_WIDTH - 4), 0, 10),
        BackgroundTransparency = 0,
    }, Anim.Ease.spring)
end

function Window:closeSettings()
    if not self.settingsOpen then return end
    self.settingsOpen = false
    local panel = self.settingsPanel
    if not panel then return end

    Anim.tween(panel, 0.3, {
        Position = UDim2.new(1, SETTINGS_WIDTH, 0, 10),
        BackgroundTransparency = 1,
    }, Anim.Ease.soft, Anim.Dir.inward)
    task.delay(0.32, function()
        if not self.settingsOpen and panel then
            panel.Visible = false
            if self.controls and self.root.Visible then self.controls.Visible = true end
        end
    end)
end

function Window:toggleSettings()
    if self.settingsOpen then
        self:closeSettings()
    else
        self:openSettings()
    end
end

