local ROW_HEIGHT = 34

-- Shared row chrome: label, optional description, right-hand control slot.
local function createRow(section, props, options)
    props = type(props) == "table" and props or { name = tostring(props or "") }
    options = options or {}
    local hasDescription = (props.description or props.Description or "") ~= ""

    local row = Build.frame(section.contentHolder, {
        name = "Row_" .. (props.name or props.Name or "element"),
        size = UDim2.new(1, 0, 0, options.height or (hasDescription and 40 or ROW_HEIGHT)),
        transparency = 1,
        zindex = 6,
    })
    row.BackgroundTransparency = 1

    local labelOffset = 0
    if props.icon or props.Icon then
        local iconHolder = Build.frame(row, {
            size = UDim2.fromOffset(15, 15),
            position = UDim2.new(0, 0, 0.5, 0),
            anchor = Vector2.new(0, 0.5),
            transparency = 1,
            zindex = 7,
        })
        iconHolder.BackgroundTransparency = 1
        local resolved = normaliseAsset(props.icon or props.Icon)
        if resolved then
            local img = Instance.new("ImageLabel")
            img.BackgroundTransparency = 1
            img.Size = UDim2.fromScale(1, 1)
            img.Image = resolved
            img.Visible = false
            img.Parent = iconHolder
            img.Loaded:Connect(function() img.Visible = true end)
        else
            Glyph.new(iconHolder, Glyph.resolve(props.icon or props.Icon, "grid"),
                14, Theme.SubText, 0.2, 1.5, false)
        end
        labelOffset = 22
    end

    local label = Build.text(row, {
        name = "Label",
        text = props.name or props.Name or "",
        size = UDim2.new(1, -((options.rightPad or 120) + labelOffset), 0, hasDescription and 16 or 18),
        position = UDim2.new(0, labelOffset, 0, hasDescription and 4 or 8),
        font = Enum.Font.GothamMedium,
        textSize = 13,
        color = Theme.Text,
        zindex = 7,
        wrap = true,
        truncate = Enum.TextTruncate.None,
    })
    label.TextWrapped = true

    local description
    if hasDescription then
        description = Build.text(row, {
            name = "Description",
            text = props.description or props.Description,
            size = UDim2.new(1, -(options.rightPad or 120), 0, 14),
            position = UDim2.new(0, labelOffset, 0, 21),
            font = Enum.Font.Gotham,
            textSize = 11,
            color = Theme.SubText,
            zindex = 7,
            wrap = true,
            truncate = Enum.TextTruncate.None,
        })
    end

    return row, label, description
end

-- Registration shared by every value element so flags, saving and search
-- all behave the same way.
local function registerElement(section, handle, props, kind, extraSearch)
    local flag = props.flag or props.Flag or (props.name or props.Name or kind) .. "_" .. kind
    flag = tostring(flag)

    handle.flag = flag
    handle.kind = kind
    handle.name = props.name or props.Name or kind
    handle.description = props.description or props.Description or ""
    handle.value = props.value ~= nil and props.value or props.Value
    handle.locked = false
    handle.originalDescription = handle.description

    if props.forgetState or props.ForgetState then
        handle.forgetState = true
    end

    State.Elements[flag] = handle
    if handle.value ~= nil and not State.Flags[flag] then
        State.Flags[flag] = handle.value
    end

    local tabName = section.tab and section.tab.name or ""
    if section.addElement then
        section:addElement(handle, {
            kind = kind,
            name = handle.name,
            description = handle.description,
            keywords = table.concat({
                handle.name or "",
                handle.description or "",
                section.title or "",
                tabName,
            }, " "):lower(),
            label = handle,
        })
    end

    if handle.__container then
        handle.__container.tab = section.tab
        handle.__container.section = section
    end

    return handle
end

-- Locking: blocks user input and the callback, but not programmatic Set.
local function applyLockable(handle, row, visualParts)
    function handle:Lock(reason)
        self.locked = true
        if row and row:FindFirstChild("Label") then
            if reason then
                row.Label.Text = reason
                row.Label.TextColor3 = Theme.Warning
                if row:FindFirstChild("Description") then
                    row.Description.Visible = false
                end
            end
        end
        for _, part in ipairs(visualParts or {}) do
            if part then Anim.tween(part, 0.22, { BackgroundTransparency = 0.62 }, Anim.Ease.soft) end
        end
        return self
    end

    function handle:Unlock()
        self.locked = false
        if row and row:FindFirstChild("Label") then
            row.Label.Text = self.name
            row.Label.TextColor3 = Theme.Text
            if row:FindFirstChild("Description") then
                row.Description.Visible = true
            end
        end
        for _, part in ipairs(visualParts or {}) do
            if part then Anim.tween(part, 0.22, { BackgroundTransparency = 0 }, Anim.Ease.soft) end
        end
        return self
    end

    function handle:IsLocked()
        return self.locked == true
    end
end

