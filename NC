-- ═══════════════════════════════════════════════════════════════════════════

local Tab = {}
Tab.__index = Tab

local TAB_PILL_HEIGHT = 34

function Tab.new(window, props)
    local self = setmetatable({}, Tab)
    self.window = window
    self.name = props.name or props.Name or "Tab"
    self.icon = props.icon or props.Icon
    self.elements = {}
    self.sections = {}
    self.connections = {}
    self.visible = true

    ----------------------------------------------------------------
    -- rail pill
    ----------------------------------------------------------------
    self.pill = Build.frame(window.railScroll, {
        name = "Tab_" .. self.name,
        size = UDim2.new(1, 0, 0, TAB_PILL_HEIGHT),
        transparency = 1,
        zindex = 8,
    })
    self.pill.BackgroundColor3 = Theme.BackgroundTertiary
    self.pill.BackgroundTransparency = 1
    self.pillCorner = Build.corner(self.pill, 9)

    self.pillGlow = Build.frame(self.pill, {
        name = "PillGlow",
        size = UDim2.new(1, 0, 0, TAB_PILL_HEIGHT),
        transparency = 1,
        zindex = 7,
    })
    self.pillGlow.BackgroundColor3 = Theme.Accent
    self.pillGlow.BackgroundTransparency = 1
    Build.corner(self.pillGlow, 9)

    self.pillGradient = Build.gradient(self.pill, seq(
        shiftColor(Theme.Accent, -0.70),
        shiftColor(Theme.Accent, -0.86)
    ), 0)

    self.pillStroke = Build.stroke(self.pill, Theme.Border, 1, 1)

    local iconHolder = Build.frame(self.pill, {
        name = "IconHolder",
        size = UDim2.fromOffset(17, 17),
        position = UDim2.new(0, 13, 0.5, 0),
        anchor = Vector2.new(0, 0.5),
        transparency = 1,
        zindex = 10,
    })
    iconHolder.BackgroundTransparency = 1
    self.iconHolder = iconHolder

    if self.icon then
        local resolved = normaliseAsset(self.icon)
        if resolved then
            local img = Instance.new("ImageLabel")
            img.BackgroundTransparency = 1
            img.Size = UDim2.fromScale(1, 1)
            img.Image = resolved
            img.ImageColor3 = Theme.SubText
            img.Visible = false
            img.Parent = iconHolder
            img.Loaded:Connect(function() img.Visible = true end)
            task.delay(2, function()
                if img.Parent and not img.IsLoaded then
                    img:Destroy()
                    Glyph.new(iconHolder, "grid", 16, Theme.SubText, 0.25, 1.5, false)
                end
            end)
            self.iconImage = img
        else
            Glyph.new(iconHolder, Glyph.resolve(self.icon, "grid"),
                16, Theme.SubText, 0.25, 1.5, false)
        end
    else
        Glyph.new(iconHolder, "grid", 16, Theme.SubText, 0.25, 1.5, false)
    end

    self.pillLabel = Build.text(self.pill, {
        name = "Label",
        text = self.name,
        size = UDim2.new(1, -46, 1, 0),
        position = UDim2.new(0, 38, 0, 0),
        font = Enum.Font.GothamMedium,
        textSize = 13,
        color = Theme.SubText,
        zindex = 10,
        wrap = true,
        truncate = Enum.TextTruncate.None,
    })
    self.pillLabel.TextWrapped = true

    self.pillHit = Build.hitbox(self.pill, { zindex = 20 })

    ----------------------------------------------------------------
    -- content page
    ----------------------------------------------------------------
    self.page = Build.scroll(window.content, {
        name = "Page_" .. self.name,
        size = UDim2.fromScale(1, 1),
        padding = 14,
        gap = 10,
        barThickness = 3,
        zindex = 5,
        canvas = UDim2.new(1, 0, 0, 0),
    })
    self.page.Visible = false
    self.page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    self.page.CanvasSize = UDim2.new()

    table.insert(self.connections, self.pillHit.MouseEnter:Connect(function()
        if window.activeTab == self then return end
        Anim.tween(self.pill, 0.18, {
            BackgroundTransparency = math.max(0, 0.70 - Theme.Transparency),
        }, Anim.Ease.gentle)
        if self.pillLabel then Anim.tween(self.pillLabel, 0.18, { TextColor3 = Theme.Text }, Anim.Ease.gentle) end
    end))

    table.insert(self.connections, self.pillHit.MouseLeave:Connect(function()
        if window.activeTab == self then return end
        Anim.tween(self.pill, 0.22, { BackgroundTransparency = 1 }, Anim.Ease.gentle)
        if self.pillLabel then Anim.tween(self.pillLabel, 0.22, { TextColor3 = Theme.SubText }, Anim.Ease.gentle) end
    end))

    table.insert(self.connections, self.pillHit.MouseButton1Click:Connect(function()
        self:select()
    end))

    return self
end

-- Creates a tab, wires it into the rail and selects the first one.
function Window:CreateTab(props, icon)
    -- Accepts both the table form and Rayfield's positional (Name, Icon) form.
    if type(props) == "string" then props = { name = props, icon = icon } end
    props = props or {}

    local tab = Tab.new(self, props)

    table.insert(self.tabOrder, tab)
    table.insert(self.tabs, tab)
    if tab.name then
        self.tabsByName[tab.name] = tab
    end

    -- The first tab created becomes the landing tab.
    if #self.tabOrder == 1 then
        task.defer(function()
            if tab.page and tab.page.Parent then
                tab:select(true)
            end
        end)
    end

    return tab
end

-- Adds a section to this tab's page.
function Tab:CreateSection(props)
    if type(props) == "string" then props = { name = props } end
    props = props or {}

    local section = Section.new(self, props)
    table.insert(self.sections, section)

    -- Sections fade in staggered so a busy tab does not pop into existence.
    if self.window.activeTab == self then
        local target = section.baseTransparency
        section.shell.BackgroundTransparency = 1
        task.delay((#self.sections - 1) * 0.05, function()
            if section.shell and section.shell.Parent then
                Anim.tween(section.shell, 0.34, { BackgroundTransparency = target }, Anim.Ease.soft)
            end
        end)
    end

    return section
end

function Tab:select(noAnimation)
    local window = self.window
    if window.activeTab == self then return end

    local previous = window.activeTab
    window.activeTab = self

    -- move the indicator to this pill
    -- The indicator is parented to Rail, not RailScroll.  Rebasing against
    -- RailScroll was the source of the purple active background being offset.
    local targetY = self.pill.AbsolutePosition.Y - window.rail.AbsolutePosition.Y

    local indicatorY = targetY + math.floor((TAB_PILL_HEIGHT - 24) / 2)
    local glowY = targetY
    window.railIndicator.Position = UDim2.fromOffset(0, indicatorY)
    window.railIndicatorGlow.Position = UDim2.fromOffset(-22, glowY)

    Anim.tween(window.railIndicator, noAnimation and 0.01 or 0.32, {
        Position = UDim2.fromOffset(0, indicatorY),
        Size = UDim2.fromOffset(3, TAB_PILL_HEIGHT - 10),
    }, Anim.Ease.spring)

    Anim.tween(window.railIndicatorGlow, noAnimation and 0.01 or 0.36, {
        Position = UDim2.fromOffset(-22, glowY),
        BackgroundTransparency = 1 - 0.20 * (0.3 + Theme.GlowIntensity * 0.7),
    }, Anim.Ease.spring)

    -- swap pill states
    for _, other in ipairs(window.tabOrder) do
        if other == self then
            Anim.tween(other.pill, 0.26, {
                BackgroundTransparency = math.max(0, 0.66 - Theme.Transparency),
            }, Anim.Ease.soft)
            Anim.tween(other.pillStroke, 0.26, { Transparency = 0.45, Color = Theme.Accent }, Anim.Ease.soft)
            -- Same NumberSequence trap as the notification gradient: show or hide
            -- the pill's gradient by toggling the instance, never by tweening a
            -- numeric Transparency onto it.
            other.pillGradient.Enabled = Theme.GradientMode
            if other.pillLabel then
                Anim.tween(other.pillLabel, 0.24, { TextColor3 = Theme.Text }, Anim.Ease.soft)
            end
        else
            Anim.tween(other.pill, 0.24, { BackgroundTransparency = 1 }, Anim.Ease.soft)
            Anim.tween(other.pillStroke, 0.24, { Transparency = 1, Color = Theme.Border }, Anim.Ease.soft)
            other.pillGradient.Enabled = false
            if other.pillLabel then
                Anim.tween(other.pillLabel, 0.24, { TextColor3 = Theme.SubText }, Anim.Ease.soft)
            end
        end
    end

    -- cross-fade the pages
    if previous and previous ~= self then
        local old = previous.page
        if noAnimation then
            old.Visible = false
        else
            old.Visible = true
            local oldPos = old.Position
            Anim.tween(old, 0.16, {
                Position = UDim2.new(oldPos.X.Scale, oldPos.X.Offset - 14, oldPos.Y.Scale, oldPos.Y.Offset),
            }, Anim.Ease.soft, Anim.Dir.inward)
            task.delay(0.1, function()
                old.Visible = false
                old.Position = oldPos
            end)
        end
    end

    self.page.Visible = true
    if noAnimation then
        self.page.Position = UDim2.fromScale(0, 0)
    else
        self.page.Position = UDim2.new(0, 18, 0, 0)
        Anim.tween(self.page, 0.34, { Position = UDim2.fromScale(0, 0) }, Anim.Ease.spring)
    end

    -- stagger the section reveals
    if not noAnimation then
        for index, section in ipairs(self.sections) do
            if section.shell then
                section.shell.BackgroundTransparency = 1
                task.delay((index - 1) * 0.04, function()
                    if section.shell and section.shell.Parent then
                        Anim.tween(section.shell, 0.3, { BackgroundTransparency = section.baseTransparency }, Anim.Ease.soft)
                    end
                end)
            end
        end
    end
end

function Tab:recolour()
    if not self.pill or not self.pill.Parent then return end
    self.pill.BackgroundColor3 = Theme.BackgroundTertiary
    self.pillGlow.BackgroundColor3 = Theme.Accent
    self.pillGradient.Color = seq(Theme.Accent, Theme.AccentSecondary)
    self.pillGradient.Enabled = Theme.GradientMode and self:isActive()
    self.pillStroke.Color = self:isActive() and Theme.Accent or Theme.Border
    self.pillLabel.TextColor3 = self:isActive() and Theme.Text or Theme.SubText
    for _, child in ipairs(self.iconHolder:GetDescendants()) do
        if child:IsA("Frame") then child.BackgroundColor3 = Theme.Accent end
    end
end

function Tab:isActive()
    return self.window.activeTab == self
end

function Tab:setVisible(visible)
    if visible == self.visible then return end
    self.visible = visible
    if visible then
        self.pill.Visible = true
        Anim.tween(self.pill, 0.3, { BackgroundTransparency = 1 }, Anim.Ease.soft)
        Anim.tween(self.pillLabel, 0.3, { TextTransparency = 0 }, Anim.Ease.soft)
        Anim.tween(self.iconHolder, 0.3, { BackgroundTransparency = 1 }, Anim.Ease.soft)
    else
        if self:isActive() then
            local first = self.window.tabOrder[1]
            if first and first ~= self then first:select() end
        end
        Anim.tween(self.pillLabel, 0.24, { TextTransparency = 1 }, Anim.Ease.soft, Anim.Dir.inward)
        task.delay(0.26, function()
            if not self.visible then self.pill.Visible = false end
        end)
    end
end

function Tab:destroy()
    for _, conn in ipairs(self.connections) do
        pcall(function() conn:Disconnect() end)
    end
    self.pill:Destroy()
    self.page:Destroy()
end

