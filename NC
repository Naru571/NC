function Build.corner(frame, radius)
    -- Reuse an existing UICorner instead of adding a second one.
    --
    -- Build.frame already installs a UICorner (radius Theme.Corner), so every
    -- `Build.corner(obj, n)` that followed it created a SECOND UICorner -- and
    -- Roblox honours the first, silently discarding the requested radius. That
    -- is why every "circle" written as Build.corner(x, 999) rendered as a
    -- rounded square with the default 12px corners: the loading screen's bloom
    -- showed up as a visible box in the middle of the screen.
    local corner = frame:FindFirstChildOfClass("UICorner")
    if not corner then
        corner = Instance.new("UICorner")
        corner.Parent = frame
    end
    corner.CornerRadius = UDim.new(0, radius)
    return corner
end
--[[
    A soft radial glow, built from nested discs.

    Roblox has no radial gradient -- UIGradient is linear only -- so a glow made
    from one flat-coloured circle renders as a hard-edged disc. (That is exactly
    what the loading screen's bloom looked like once the duplicate-UICorner bug
    was fixed: a solid purple circle parked in the middle of the screen.)

    Stacking nested discs with a computed alpha ramp reproduces a smooth falloff
    with no texture asset. Each disc's alpha is derived so the accumulated
    opacity at radius f matches A(f) = peak * (1 - f)^2 exactly:

        alpha at f_i   = 1 - prod(j >= i)(1 - a_j) = A(f_i)
        alpha at f_i+1 = 1 - prod(j >= i+1)(1 - a_j) = A(f_i+1)

    Dividing the two gives each layer's own alpha.

    Returns the holder plus a setPeak(fn) so callers can pulse it.
]]
local function buildRadialGlow(parent, size, color, opts)
    opts = opts or {}
    local peak = opts.peak or 0.5
    local layers = opts.layers or 12

    local holder = Build.frame(parent, {
        name = opts.name or "Glow",
        size = UDim2.fromOffset(size, size),
        position = opts.position or UDim2.fromScale(0.5, 0.5),
        anchor = Vector2.new(0.5, 0.5),
        transparency = 1,
        corner = false,
        zindex = opts.zindex or 1,
    })
    holder.BackgroundTransparency = 1

    local function profile(f)
        local k = 1 - f
        if k < 0 then k = 0 end
        return peak * k * k
    end

    local discs = {}
    for i = 1, layers do
        local f = i / layers
        local alpha = 1 - (1 - profile(f)) / (1 - profile(math.min(1, (i + 1) / layers)))
        alpha = math.clamp(alpha, 0, 1)

        local disc = Instance.new("Frame")
        disc.Name = "Layer"
        disc.AnchorPoint = Vector2.new(0.5, 0.5)
        disc.Position = UDim2.fromScale(0.5, 0.5)
        disc.Size = UDim2.fromScale(f, f)
        disc.BackgroundColor3 = color
        disc.BackgroundTransparency = 1 - alpha
        disc.BorderSizePixel = 0
        disc.ZIndex = opts.zindex or 1
        disc.Parent = holder

        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0.5, 0)
        c.Parent = disc

        table.insert(discs, { frame = disc, alpha = alpha })
    end

    -- Scale every layer together, so the caller can pulse the whole glow.
    local function setPeak(newPeak)
        for _, d in ipairs(discs) do
            local scaled = math.clamp(d.alpha * (newPeak / peak), 0, 1)
            d.frame.BackgroundTransparency = 1 - scaled
        end
    end

    return holder, setPeak
end

function Build.stroke(frame, color, thickness, transparency)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color
    stroke.Thickness = thickness or 1
    stroke.Transparency = transparency or 0
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = frame
    return stroke
end

function Build.gradient(frame, colors, rotation)
    local gradient = Instance.new("UIGradient")
    gradient.Color = asColorSequence(colors)
    gradient.Rotation = rotation or Theme.GradientAngle
    gradient.Parent = frame
    return gradient
end

-- Animated gradient: drifts the offset continuously.
function Build.liveGradient(frame, colors, speed, rotation)
    local gradient = Build.gradient(frame, colors or Theme.Gradient, rotation)
    local conn = RunService.RenderStepped:Connect(function()
        if not gradient.Parent then return end
        gradient.Offset = Vector2.new(math.sin(tick() * (speed or 0.22)) * 0.35, 0)
    end)
    return gradient, conn
end

-- Particle field: tiny drifting dots inside a clipping container.
function Build.particles(parent, count, color, opts)
    opts = opts or {}
    local layer = Build.frame(parent, {
        name = "Particles",
        zindex = opts.zindex or 2,
        transparency = 1,
    })
    layer.BackgroundTransparency = 1

    local clip = Instance.new("UICorner")
    clip.CornerRadius = UDim.new(0, opts.corner or Theme.CornerLarge)
    clip.Parent = layer

    local dots = {}
    for index = 1, count do
        local size = math.random(opts.minSize or 1, opts.maxSize or 2)
        local dot = Instance.new("Frame")
        dot.BackgroundColor3 = color or Theme.AccentSoft
        dot.BackgroundTransparency = math.random(45, 80) / 100
        dot.BorderSizePixel = 0
        dot.Size = UDim2.fromOffset(size, size)
        dot.Position = UDim2.fromScale(math.random(), math.random())
        dot.ZIndex = opts.zindex or 2
        dot.Parent = layer

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(1, 0)
        corner.Parent = dot

        local driftX = (math.random() - 0.5) * (opts.drift or 0.25)
        local driftY = -math.random(6, 30) / 100

        table.insert(dots, { frame = dot, dx = driftX, dy = driftY, phase = math.random() * math.pi * 2 })
    end

    local elapsed = 0
    local conn = RunService.RenderStepped:Connect(function(dt)
        elapsed = elapsed + dt
        if not layer.Parent then return end
        for _, dot in ipairs(dots) do
            local base = dot.frame.Position
            local nx = base.X.Scale + dot.dx * dt * 0.55
            local ny = base.Y.Scale + dot.dy * dt
            if nx < -0.05 then nx = 1.05 elseif nx > 1.05 then nx = -0.05 end
            if ny < -0.05 then
                ny = 1.05
                nx = math.random()
            end
            dot.frame.Position = UDim2.fromScale(nx, ny)
            dot.frame.BackgroundTransparency = 0.45 + math.abs(math.sin(elapsed * 0.8 + dot.phase)) * 0.35
        end
    end)

    return layer, conn
end

-- Soft pulsing glow ring used by the pill, active tab and hovered controls.
function Build.pulse(frame, color, minAlpha, maxAlpha, period)
    local base = frame.BackgroundColor3
    local elapsed = 0
    return RunService.RenderStepped:Connect(function(dt)
        elapsed = elapsed + dt
        if not frame.Parent then return end
        local t = (math.sin(elapsed / (period or 1.6) * math.pi * 2) + 1) / 2
        local target = minAlpha + (maxAlpha - minAlpha) * t
        frame.BackgroundTransparency = target
    end)
end

