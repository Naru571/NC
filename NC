--  PLAYER INFO
--
--  A small button beside the profile block that opens a card with the details
--  people actually ask for in support: HWID, account age, how long they have
--  been in this place, executor, and so on. One Copy button puts the lot on the
--  clipboard as plain labelled text, so it can be pasted into a ticket.
-- ═══════════════════════════════════════════════════════════════════════════

-- When the script started, for the "time in this place" reading.
State.SessionStart = os.clock()

--[[
    Best-effort HWID.

    Every executor spells this differently, and plenty do not expose it at all,
    so each candidate is probed in isolation and the first usable string wins.
    Returns nil when nothing works, and the UI shows "Unavailable" rather than
    inventing a value.
]]
local function resolveHwid()
    local getters = {
        function() return gethwid and gethwid() end,
        function() return get_hwid and get_hwid() end,
        function() return getHWID and getHWID() end,
        function() return syn and syn.get_hwid and syn.get_hwid() end,
        function() return KRNL_IO and KRNL_IO.gethwid and KRNL_IO.gethwid() end,
    }
    for _, getter in ipairs(getters) do
        local ok, value = pcall(getter)
        if ok and type(value) == "string" and value ~= "" then
            return value
        end
    end
    return nil
end

local function resolveExecutor()
    local probe = rawget(getfenv and getfenv() or _G, "identifyexecutor")
    if type(probe) == "function" then
        local ok, name = pcall(probe)
        if ok and name and tostring(name) ~= "" then return tostring(name) end
    end
    return "Unknown"
end

-- Formats a duration in seconds as "2h 14m" / "14m 06s" / "38s".
local function formatDuration(seconds)
    seconds = math.max(0, math.floor(seconds))
    local hours = math.floor(seconds / 3600)
    local minutes = math.floor((seconds % 3600) / 60)
    local secs = seconds % 60
    if hours > 0 then
        return string.format("%dh %02dm", hours, minutes)
    elseif minutes > 0 then
        return string.format("%dm %02ds", minutes, secs)
    end
    return string.format("%ds", secs)
end

-- "3 years, 41 days" — Roblox reports AccountAge in whole days.
local function formatAccountAge(days)
    days = math.max(0, math.floor(days or 0))
    if days < 1 then return "Joined today" end
    if days < 30 then return days == 1 and "1 day" or (days .. " days") end

    local years = math.floor(days / 365)
    local months = math.floor((days % 365) / 30)
    if years < 1 then
        return months == 1 and "1 month" or (months .. " months")
    end
    local parts = { years == 1 and "1 year" or (years .. " years") }
    if months > 0 then
        table.insert(parts, months == 1 and "1 month" or (months .. " months"))
    end
    return table.concat(parts, ", ")
end

--[[
    Everything the card shows, in order.

    Each entry is { key, label, value }. `key` is the plain-text name used by the
    Copy button, so the pasted blob stays readable outside the UI.
]]
function LIBRARY:collectPlayerInfo()
    local player = Players.LocalPlayer
    local session = os.clock() - (State.SessionStart or os.clock())

    local platform = "Desktop"
    if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
        platform = "Mobile"
    elseif UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled then
        platform = "Console"
    end

    local hwid = resolveHwid()

    local rows = {
        { "username",  "Username",     "@" .. player.Name },
        { "userId",    "User ID",      tostring(player.UserId) },
        { "accountAge","Account age",  formatAccountAge(player.AccountAge) },
        { "playTime",  "Time in place", formatDuration(session) },
        { "hwid",      "HWID",         hwid or "Unavailable" },
        { "executor",  "Executor",     resolveExecutor() },
        { "platform",  "Platform",     platform },
        { "premium",   "Premium",      player.MembershipType == Enum.MembershipType.Premium and "Yes" or "No" },
        { "placeId",   "Place ID",     tostring(game.PlaceId) },
        { "jobId",     "Server",       (game.JobId ~= "" and game.JobId:sub(1, 12) .. "...") or "Studio" },
    }

    return rows
end

-- Plain-text form for the clipboard.
function LIBRARY:playerInfoText()
    local player = Players.LocalPlayer
    local lines = { player.DisplayName .. " (@" .. player.Name .. ")" }
    for _, row in ipairs(LIBRARY:collectPlayerInfo()) do
        table.insert(lines, row[2] .. ": " .. tostring(row[3]))
    end
    return table.concat(lines, "\n")
end

--[[
    Builds the player-info button (beside the profile block) and the card it
    opens.

    The card lives in window.overlay so it is never clipped by the rail, and is
    anchored above the button so it reads as belonging to it.
]]
function Window:buildPlayerInfo()
    if self.playerInfoButton then return self.playerInfoButton end

    -- The card lives in the overlay. Building this before the overlay exists
    -- parents the card to nil, which fails silently -- the button renders but
    -- pressing it does nothing. Fail loudly instead.
    if not self.overlay then
        warn("[NC] buildPlayerInfo must run after window.overlay is created")
        return nil
    end

    ----------------------------------------------------------------------
    -- the button
    ----------------------------------------------------------------------
    local button = Build.button(self.body, {
        name = "PlayerInfoButton",
        size = UDim2.fromOffset(28, PROFILE_HEIGHT),
        position = UDim2.new(0, 12 + PROFILE_WIDTH + 6, 1, -10),
        anchor = Vector2.new(0, 1),
        transparency = 1,
        zindex = 9,
    })
    button.BackgroundColor3 = Theme.BackgroundTertiary
    button.BackgroundTransparency = 0.55
    Build.corner(button, 11)
    local buttonStroke = Build.stroke(button, Theme.Border, 1, 0.6)

    local glyphHolder = Build.frame(button, {
        name = "Glyph",
        size = UDim2.fromScale(1, 1),
        transparency = 1,
        zindex = 10,
    })
    glyphHolder.BackgroundTransparency = 1
    local glyph = Glyph.new(glyphHolder, "badge", 16, Theme.SubText, 0.15, 1.5, false)

    local function tintGlyph(colour, transparency)
        for _, child in ipairs(glyphHolder:GetChildren()) do
            if child.Name:sub(1, 6) == "Glyph_" then
                for _, part in ipairs(child:GetChildren()) do
                    if part.Name == "Seg" then
                        Anim.tween(part, 0.15, { BackgroundColor3 = colour }, Anim.Ease.gentle)
                        if transparency then
                            Anim.tween(part, 0.15, { BackgroundTransparency = transparency }, Anim.Ease.gentle)
                        end
                    elseif part.Name == "Ring" then
                        local s = part:FindFirstChildOfClass("UIStroke")
                        if s then Anim.tween(s, 0.15, { Color = colour }, Anim.Ease.gentle) end
                    end
                end
            end
        end
    end

    ----------------------------------------------------------------------
    -- the card
    ----------------------------------------------------------------------
    local ROW_H = 19
    local PAD = 14
    local rows = LIBRARY:collectPlayerInfo()
    local headerH = 42
    local copyH = 30
    local cardH = PAD + headerH + 8 + (#rows * ROW_H) + 12 + copyH + PAD

    local card = Build.frame(self.overlay, {
        name = "PlayerInfoCard",
        size = UDim2.fromOffset(292, 0),
        position = UDim2.new(0, 12, 1, -(PROFILE_HEIGHT + 20)),
        anchor = Vector2.new(0, 1),
        transparency = 1,
        zindex = 620,
        visible = false,
    })
    card.BackgroundColor3 = Theme.BackgroundSecondary
    card.BackgroundTransparency = 0.02
    card.ClipsDescendants = true
    Build.corner(card, Theme.CornerLarge)
    local cardStroke = Build.stroke(card, Theme.AccentSoft, 1, 0.5)

    -- header: small avatar, display name, @handle
    local headHolder = Build.frame(card, {
        name = "Head",
        size = UDim2.fromOffset(30, 30),
        position = UDim2.fromOffset(PAD, PAD),
        transparency = 1,
        zindex = 622,
    })
    headHolder.BackgroundColor3 = Theme.Background
    headHolder.BackgroundTransparency = 0.3
    Build.corner(headHolder, 9)
    Build.stroke(headHolder, Theme.Accent, 1, 0.6)
    Glyph.new(headHolder, "person", 15, Theme.SubText, 0.2, 1.5, false)

    task.spawn(function()
        local ok, url = pcall(function()
            return Players:GetUserThumbnailAsync(
                Players.LocalPlayer.UserId,
                Enum.ThumbnailType.HeadShot,
                Enum.ThumbnailSize.Size100x100
            )
        end)
        if ok and url and headHolder.Parent then
            for _, child in ipairs(headHolder:GetChildren()) do
                if child:IsA("Frame") and child.Name:sub(1, 6) == "Glyph_" then child:Destroy() end
            end
            local img = Instance.new("ImageLabel")
            img.BackgroundTransparency = 1
            img.Size = UDim2.fromScale(1, 1)
            img.Image = url
            img.ZIndex = 623
            img.Parent = headHolder
            Build.corner(img, 9)
        end
    end)

    Build.text(card, {
        name = "Name",
        text = Players.LocalPlayer.DisplayName,
        size = UDim2.new(1, -(PAD * 2 + 38), 0, 17),
        position = UDim2.fromOffset(PAD + 38, PAD + 1),
        font = Enum.Font.GothamBold,
        textSize = 13,
        color = Theme.Text,
        xalign = Enum.TextXAlignment.Left,
        truncate = Enum.TextTruncate.AtEnd,
        zindex = 622,
    })
    Build.text(card, {
        name = "Handle",
        text = "@" .. Players.LocalPlayer.Name,
        size = UDim2.new(1, -(PAD * 2 + 38), 0, 14),
        position = UDim2.fromOffset(PAD + 38, PAD + 18),
        font = Enum.Font.Gotham,
        textSize = 11,
        color = Theme.SubText,
        xalign = Enum.TextXAlignment.Left,
        truncate = Enum.TextTruncate.AtEnd,
        zindex = 622,
    })

    local divider = Build.frame(card, {
        name = "Divider",
        size = UDim2.new(1, -PAD * 2, 0, 1),
        position = UDim2.fromOffset(PAD, PAD + headerH),
        transparency = 1,
        zindex = 622,
    })
    divider.BackgroundColor3 = Theme.Border
    divider.BackgroundTransparency = 0.45

    -- rows: label left, value right
    local rowTop = PAD + headerH + 8
    local valueLabels = {}
    for index, row in ipairs(rows) do
        local y = rowTop + (index - 1) * ROW_H

        Build.text(card, {
            name = "L_" .. row[1],
            text = row[2],
            size = UDim2.new(0.5, -PAD, 0, ROW_H),
            position = UDim2.fromOffset(PAD, y),
            font = Enum.Font.Gotham,
            textSize = 11,
            color = Theme.MutedText,
            xalign = Enum.TextXAlignment.Left,
            yalign = Enum.TextYAlignment.Center,
            truncate = Enum.TextTruncate.AtEnd,
            zindex = 622,
        })

        local valueLabel = Build.text(card, {
            name = "V_" .. row[1],
            text = tostring(row[3]),
            size = UDim2.new(0.5, -PAD, 0, ROW_H),
            position = UDim2.new(0.5, 0, 0, y),
            font = Enum.Font.GothamMedium,
            textSize = 11,
            color = Theme.Text,
            xalign = Enum.TextXAlignment.Right,
            yalign = Enum.TextYAlignment.Center,
            truncate = Enum.TextTruncate.AtEnd,
            zindex = 622,
        })
        valueLabels[row[1]] = valueLabel
    end

    -- copy button
    local copyBtn = Build.button(card, {
        name = "CopyInfo",
        size = UDim2.new(1, -PAD * 2, 0, copyH),
        position = UDim2.new(0, PAD, 1, -(PAD + copyH)),
        transparency = 1,
        zindex = 622,
    })
    copyBtn.BackgroundColor3 = Theme.Accent
    copyBtn.BackgroundTransparency = 0.08
    Build.corner(copyBtn, 8)
    local copyStroke = Build.stroke(copyBtn, Theme.AccentSoft, 1, 0.4)
    local copyLabel = Build.text(copyBtn, {
        name = "Label",
        text = "Copy all",
        size = UDim2.fromScale(1, 1),
        font = Enum.Font.GothamBold,
        textSize = 12,
        color = Theme.Text,
        xalign = Enum.TextXAlignment.Center,
        yalign = Enum.TextYAlignment.Center,
        zindex = 623,
    })

    copyBtn.MouseEnter:Connect(function()
        Anim.tween(copyBtn, 0.16, { BackgroundTransparency = 0 }, Anim.Ease.gentle)
        Anim.tween(copyStroke, 0.16, { Transparency = 0.1 }, Anim.Ease.gentle)
    end)
    copyBtn.MouseLeave:Connect(function()
        Anim.tween(copyBtn, 0.18, { BackgroundTransparency = 0.08 }, Anim.Ease.gentle)
        Anim.tween(copyStroke, 0.18, { Transparency = 0.4 }, Anim.Ease.gentle)
    end)

    copyBtn.MouseButton1Click:Connect(function()
        local text = LIBRARY:playerInfoText()
        local ok = pcall(function()
            if setclipboard then
                setclipboard(text)
            elseif toclipboard then
                toclipboard(text)
            else
                error("no clipboard function")
            end
        end)

        copyLabel.Text = ok and "Copied" or "No clipboard access"
        task.delay(1.4, function()
            if copyLabel.Parent then copyLabel.Text = "Copy all" end
        end)
    end)

    ----------------------------------------------------------------------
    -- open / close
    ----------------------------------------------------------------------
    local isOpen = false
    local outsideConn

    local function closeCard()
        if not isOpen then return end
        isOpen = false
        if outsideConn then outsideConn:Disconnect() outsideConn = nil end
        Anim.tween(card, 0.18, {
            Size = UDim2.fromOffset(292, 0),
            BackgroundTransparency = 1,
        }, Anim.Ease.soft, Anim.Dir.inward)
        Anim.tween(cardStroke, 0.18, { Transparency = 1 }, Anim.Ease.soft, Anim.Dir.inward)
        task.delay(0.2, function()
            if not isOpen then card.Visible = false end
        end)
        Anim.tween(button, 0.2, { BackgroundTransparency = 0.55 }, Anim.Ease.gentle)
        Anim.tween(buttonStroke, 0.2, { Color = Theme.Border, Transparency = 0.6 }, Anim.Ease.gentle)
        tintGlyph(Theme.SubText, 0.15)
    end

    local function openCard()
        if isOpen then return end
        isOpen = true

        -- Refresh the readings that move.
        for _, row in ipairs(LIBRARY:collectPlayerInfo()) do
            local label = valueLabels[row[1]]
            if label then label.Text = tostring(row[3]) end
        end

        card.Visible = true
        card.Size = UDim2.fromOffset(292, 0)
        Anim.tween(card, 0.34, {
            Size = UDim2.fromOffset(292, cardH),
            BackgroundTransparency = 0.02,
        }, Anim.Ease.spring)
        Anim.tween(cardStroke, 0.3, { Transparency = 0.5 }, Anim.Ease.soft)
        Anim.tween(button, 0.2, { BackgroundTransparency = 0.3 }, Anim.Ease.gentle)
        Anim.tween(buttonStroke, 0.2, { Color = Theme.AccentSoft, Transparency = 0.2 }, Anim.Ease.gentle)
        tintGlyph(Theme.AccentSoft, 0)

        outsideConn = UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1
                and input.UserInputType ~= Enum.UserInputType.Touch then return end
            local pos = input.Position
            local inside = function(inst)
                if not inst or not inst.Parent then return false end
                local a, s = inst.AbsolutePosition, inst.AbsoluteSize
                return pos.X >= a.X and pos.X <= a.X + s.X
                    and pos.Y >= a.Y and pos.Y <= a.Y + s.Y
            end
            if not inside(card) and not inside(button) then closeCard() end
        end)
        table.insert(State.Connections, outsideConn)
    end

    button.MouseEnter:Connect(function()
        if isOpen then return end
        Anim.tween(button, 0.16, { BackgroundTransparency = 0.35 }, Anim.Ease.gentle)
        Anim.tween(buttonStroke, 0.16, { Color = Theme.AccentSoft, Transparency = 0.25 }, Anim.Ease.gentle)
        tintGlyph(Theme.Text, 0.05)
    end)
    button.MouseLeave:Connect(function()
        if isOpen then return end
        Anim.tween(button, 0.18, { BackgroundTransparency = 0.55 }, Anim.Ease.gentle)
        Anim.tween(buttonStroke, 0.18, { Color = Theme.Border, Transparency = 0.6 }, Anim.Ease.gentle)
        tintGlyph(Theme.SubText, 0.15)
    end)

    button.MouseButton1Click:Connect(function()
        if isOpen then closeCard() else openCard() end
    end)

    -- Escape closes it, matching the rest of the UI.
    table.insert(self.connections, UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == Enum.KeyCode.Escape and isOpen then closeCard() end
    end))

    self.playerInfoButton = button
    self.playerInfoCard = card
    self.playerInfoParts = {
        button = button,
        buttonStroke = buttonStroke,
        glyph = glyph,
        card = card,
        cardStroke = cardStroke,
        valueLabels = valueLabels,
    }
    return button
end

function Window:buildProfile()
    local panel = Build.frame(self.body, {
        name = "Profile",
        size = UDim2.new(0, PROFILE_WIDTH, 0, PROFILE_HEIGHT),
        position = UDim2.new(0, 12, 1, -10),
        anchor = Vector2.new(0, 1),
        transparency = 1,
        zindex = 8,
    })
    panel.BackgroundColor3 = Theme.BackgroundTertiary
    panel.BackgroundTransparency = 0.55
    Build.corner(panel, 11)
    local stroke = Build.stroke(panel, Theme.Border, 1, 0.6)

    local avatarHolder = Build.frame(panel, {
        name = "AvatarHolder",
        size = UDim2.fromOffset(30, 30),
        position = UDim2.new(0, 8, 0.5, 0),
        anchor = Vector2.new(0, 0.5),
        transparency = 1,
        zindex = 9,
    })
    avatarHolder.BackgroundColor3 = Theme.Background
    avatarHolder.BackgroundTransparency = 0.3
    Build.corner(avatarHolder, 9)
    local avatarStroke = Build.stroke(avatarHolder, Theme.Accent, 1, 0.6)

    local avatar = Instance.new("ImageLabel")
    avatar.Name = "Avatar"
    avatar.BackgroundTransparency = 1
    avatar.Size = UDim2.fromScale(1, 1)
    avatar.ImageTransparency = 1
    avatar.Parent = avatarHolder
    local avatarCorner = Build.corner(avatar, 9)

    -- Resolve the headshot through the thumbnail API, with a retry because the
    -- service is occasionally slow right after joining.
    task.spawn(function()
        local attempts = 0
        local url
        while attempts < 3 and not url do
            attempts = attempts + 1
            local ok, result = pcall(function()
                return Players:GetUserThumbnailAsync(
                    LocalPlayer.UserId,
                    Enum.ThumbnailType.HeadShot,
                    Enum.ThumbnailSize.Size100x100
                )
            end)
            if ok then url = result end
            if not url then task.wait(1.2) end
        end

        if url and avatar.Parent then
            avatar.Image = url
            Anim.tween(avatar, 0.4, { ImageTransparency = 0 }, Anim.Ease.soft)
        else
            -- fall back to a drawn person glyph rather than a broken frame
            Glyph.new(avatarHolder, "person", 16, Theme.SubText, 0.2, 1.6, false)
        end
    end)

    local name = Build.text(panel, {
        name = "DisplayName",
        text = "Loading...",
        size = UDim2.new(1, -74, 0, 15),
        position = UDim2.new(0, 45, 0, 10),
        font = Enum.Font.GothamBold,
        textSize = 12,
        color = Theme.Text,
        zindex = 9,
        truncate = Enum.TextTruncate.AtEnd,
    })

    local handle = Build.text(panel, {
        name = "Username",
        text = "",
        size = UDim2.new(1, -74, 0, 13),
        position = UDim2.new(0, 45, 0, 25),
        font = Enum.Font.Gotham,
        textSize = 11,
        color = Theme.SubText,
        zindex = 9,
        truncate = Enum.TextTruncate.AtEnd,
    })

    name.Text = LocalPlayer.DisplayName
    handle.Text = "@" .. LocalPlayer.Name

    -- keep in step if the player changes their display name mid-session
    table.insert(self.connections, LocalPlayer.Changed:Connect(function(property)
        if property == "DisplayName" then name.Text = LocalPlayer.DisplayName end
    end))

    -- eye toggle
    local eyeHit = Build.hitbox(panel, {
        size = UDim2.fromOffset(26, 26),
        position = UDim2.new(1, -30, 0.5, 0),
        anchor = Vector2.new(0, 0.5),
        zindex = 12,
    })
    local eyeHolder = Build.frame(eyeHit, {
        size = UDim2.fromOffset(26, 26),
        transparency = 1,
        zindex = 11,
    })
    eyeHolder.BackgroundTransparency = 1
    local eyeGlow = Build.frame(eyeHit, {
        size = UDim2.fromOffset(26, 26),
        transparency = 1,
        zindex = 10,
    })
    eyeGlow.BackgroundColor3 = Theme.Accent
    eyeGlow.BackgroundTransparency = 1
    Build.corner(eyeGlow, 8)

    local eyeGlyph = Glyph.new(eyeHolder, "eye", 15, Theme.SubText, 0.1, 1.5, false)

    attachHover(eyeHit, eyeGlow, {
        baseTransparency = 1,
        hoverColor = Theme.Accent,
        glow = eyeGlow,
        onEnter = function()
            for _, child in ipairs(eyeHolder:GetChildren()) do
                if child.Name:sub(1, 6) == "Glyph_" then
                    for _, part in ipairs(child:GetChildren()) do
                        if part.Name == "Seg" then Anim.tween(part, 0.15, { BackgroundColor3 = Theme.Text }, Anim.Ease.gentle) end
                        if part.Name == "Ring" then
                            local s = part:FindFirstChildOfClass("UIStroke")
                            if s then Anim.tween(s, 0.15, { Color = Theme.Text }, Anim.Ease.gentle) end
                        end
                    end
                end
            end
        end,
        onLeave = function()
            for _, child in ipairs(eyeHolder:GetChildren()) do
                if child.Name:sub(1, 6) == "Glyph_" then
                    for _, part in ipairs(child:GetChildren()) do
                        if part.Name == "Seg" then Anim.tween(part, 0.15, { BackgroundColor3 = Theme.Text }, Anim.Ease.gentle) end
                        if part.Name == "Ring" then
                            local s = part:FindFirstChildOfClass("UIStroke")
                            if s then Anim.tween(s, 0.15, { Color = Theme.Text }, Anim.Ease.gentle) end
                        end
                    end
                end
            end
        end,
    })

    self.profilePanel = panel
    self.profileParts = {
        avatar = avatar,
        avatarHolder = avatarHolder,
        avatarStroke = avatarStroke,
        name = name,
        handle = handle,
        eyeHolder = eyeHolder,
        eyeGlyph = eyeGlyph,
        eyeHit = eyeHit,
        stroke = stroke,
    }
    self.profileHidden = false

    table.insert(self.connections, eyeHit.MouseButton1Click:Connect(function()
        self:setProfileVisible(self.profileHidden)
        LIBRARY:queueAutoSave()
    end))

    return panel
end

--[[
    Hides or shows the avatar, display name and username.

    Everything tweens out together, and the panel narrows once the text is
    gone so the rail does not keep a dead strip of empty space.
]]
function Window:setProfileVisible(visible, silent)
    local parts = self.profileParts
    if not parts then return end
    self.profileHidden = not visible
    State.ProfileHidden = self.profileHidden

    -- swap the eye glyph
    if parts.eyeGlyph and parts.eyeGlyph.Parent then
        parts.eyeGlyph:Destroy()
        parts.eyeGlyph = Glyph.new(parts.eyeHolder, visible and "eye" or "eyeClosed",
            15, Theme.SubText, 0.1, 1.5, false)
    end

    if visible then
        parts.avatarHolder.Visible = true
        parts.avatar.Visible = true
        Anim.tween(parts.avatarHolder, 0.32, { BackgroundTransparency = 0.3 }, Anim.Ease.soft)
        Anim.tween(parts.avatar, 0.32, { ImageTransparency = 0 }, Anim.Ease.soft)
        Anim.tween(parts.name, 0.3, { TextTransparency = 0 }, Anim.Ease.soft)
        Anim.tween(parts.handle, 0.3, { TextTransparency = 0 }, Anim.Ease.soft)
        Anim.tween(parts.name, 0.3, {
            Position = UDim2.new(0, 45, 0, 10),
            Size = UDim2.new(1, -74, 0, 15),
        }, Anim.Ease.soft)
        Anim.tween(parts.handle, 0.3, {
            Position = UDim2.new(0, 45, 0, 25),
            Size = UDim2.new(1, -74, 0, 13),
        }, Anim.Ease.soft)
    else
        Anim.tween(parts.avatar, 0.26, { ImageTransparency = 1 }, Anim.Ease.soft, Anim.Dir.inward)
        Anim.tween(parts.avatarHolder, 0.26, { BackgroundTransparency = 1 }, Anim.Ease.soft, Anim.Dir.inward)
        Anim.tween(parts.name, 0.24, { TextTransparency = 1 }, Anim.Ease.soft, Anim.Dir.inward)
        Anim.tween(parts.handle, 0.24, { TextTransparency = 1 }, Anim.Ease.soft, Anim.Dir.inward)
        Anim.tween(parts.name, 0.3, {
            Position = UDim2.new(0, 14, 0, 10),
            Size = UDim2.new(1, -46, 0, 15),
        }, Anim.Ease.soft)
        Anim.tween(parts.handle, 0.3, {
            Position = UDim2.new(0, 14, 0, 25),
            Size = UDim2.new(1, -46, 0, 13),
        }, Anim.Ease.soft)
        task.delay(0.28, function()
            parts.avatarHolder.Visible = false
            parts.avatar.Visible = false
        end)
    end

    if not silent then
        LIBRARY:Notify({
            Title = visible and "Profile shown" or "Profile hidden",
            Content = visible and "Avatar and name are back in the rail." or "Avatar and name are tucked away.",
            Type = "info",
            Duration = 2.6,
        })
    end
end

-- ═══════════════════════════════════════════════════════════════════════════
--  TOP-RIGHT CONTROLS
-- ═══════════════════════════════════════════════════════════════════════════

--[[
    One compact icon button.

    Hover brightens the plate, lifts the purple glow and nudges the icon
    colour; press scales down and release springs back. `onClick` receives the
    press only when the icon was actually tapped, never after a drag.
]]
-- ═══════════════════════════════════════════════════════════════════════════
--  TRAFFIC LIGHTS
--
--  The three dots macOS puts top-left, drawn from primitives like every other
--  icon here: red closes, yellow minimises, green zooms.
--
--  While they are on, the X and minimise buttons in the top-right control bar
--  are parked off-screen -- they would be a second, redundant way to do the
--  same two jobs, and the control bar reads cleaner as search + settings only.
--  Turning the dots off in Settings brings them straight back.
-- ═══════════════════════════════════════════════════════════════════════════

local TRAFFIC_SPECS = {
    { name = "Close",    color = Color3.fromRGB(255, 95, 87)  },   -- macOS red
    { name = "Minimise", color = Color3.fromRGB(254, 188, 46) },   -- macOS amber
    { name = "Zoom",     color = Color3.fromRGB(40, 200, 64)  },   -- macOS green
}

function Window:buildTrafficLights()
    if self.trafficRow then return self.trafficRow end

    local row = Build.frame(self.header, {
        name = "TrafficLights",
        size = UDim2.fromOffset(TRAFFIC_ROW_WIDTH, TRAFFIC_DOT),
        position = UDim2.new(0, TRAFFIC_X, 0.5, 0),
        anchor = Vector2.new(0, 0.5),
        transparency = 1,
        zindex = 14,
    })
    row.BackgroundTransparency = 1
    self.trafficRow = row
    self.trafficDots = {}

    local layout = Instance.new("UIListLayout")
    layout.FillDirection = Enum.FillDirection.Horizontal
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.VerticalAlignment = Enum.VerticalAlignment.Center
    layout.Padding = UDim.new(0, TRAFFIC_GAP)
    layout.Parent = row

    for index, spec in ipairs(TRAFFIC_SPECS) do
        -- Plain frames, not buttons: one hitbox over the whole row owns all the
        -- input. Three separate click targets left 8px dead gaps between them,
        -- so dragging across the row flickered the glyphs on and off.
        local dot = Build.frame(row, {
            name = "Dot_" .. spec.name,
            size = UDim2.fromOffset(TRAFFIC_DOT, TRAFFIC_DOT),
            transparency = 1,
            zindex = 15,
        })
        dot.BackgroundColor3 = spec.color
        dot.BackgroundTransparency = 0
        Build.corner(dot, 999)
        dot.LayoutOrder = index

        -- Soft bloom behind the dot, lit on hover. Starts fully transparent.
        local halo = Build.frame(dot, {
            name = "Halo",
            size = UDim2.fromScale(1.9, 1.9),
            position = UDim2.fromScale(0.5, 0.5),
            anchor = Vector2.new(0.5, 0.5),
            transparency = 1,
            zindex = 13,
        })
        halo.BackgroundColor3 = spec.color
        halo.BackgroundTransparency = 1
        Build.corner(halo, 999)

        -- The mark inside the dot. macOS hides these until you hover the row,
        -- so every bar starts fully transparent and is tweened in on hover.
        local glyphHolder = Build.frame(dot, {
            name = "Glyph",
            size = UDim2.fromScale(1, 1),
            transparency = 1,
            zindex = 17,
        })
        glyphHolder.BackgroundTransparency = 1

        local bars = {}
        local function bar(w, h, rotation)
            local b = Build.frame(glyphHolder, {
                name = "Bar",
                size = UDim2.fromOffset(w, h),
                position = UDim2.fromScale(0.5, 0.5),
                anchor = Vector2.new(0.5, 0.5),
                transparency = 1,
                zindex = 18,
            })
            -- A darkened version of the dot's own colour, which is what macOS
            -- uses -- near-black marks read as holes punched in the dot.
            b.BackgroundColor3 = shiftColor(spec.color, -0.62)
            b.BackgroundTransparency = 1
            b.Rotation = rotation
            Build.corner(b, math.max(w, h))
            table.insert(bars, b)
            return b
        end

        local len, thick = 6.4, 1.5
        if spec.name == "Close" then
            bar(len, thick, 45)
            bar(len, thick, -45)
        elseif spec.name == "Minimise" then
            bar(len, thick, 0)
        else
            -- macOS used a "+" for zoom for years before the two triangles.
            bar(len, thick, 0)
            bar(thick, len, 0)
        end

        self.trafficDots[index] = {
            spec = spec,
            dot = dot,
            halo = halo,
            bars = bars,
        }
    end

    ------------------------------------------------------------------
    -- one hitbox owns the whole row
    ------------------------------------------------------------------
    local hit = Build.hitbox(row, { zindex = 20 })
    local hovered = 0

    -- Dots sit on a 20px pitch (12px dot + 8px gap).
    local pitch = TRAFFIC_DOT + TRAFFIC_GAP
    local function indexAt(x)
        if type(x) ~= "number" then return hovered end
        return math.clamp(math.floor(x / pitch) + 1, 1, #self.trafficDots)
    end

    local function paint(index, lit)
        for i, entry in ipairs(self.trafficDots) do
            local want = (i == index and lit) and shiftColor(entry.spec.color, 0.20)
                or entry.spec.color
            Anim.tween(entry.dot, 0.14, { BackgroundColor3 = want }, Anim.Ease.gentle)
            Anim.tween(entry.halo, 0.18, {
                BackgroundTransparency = (i == index and lit) and 0.72 or 1,
            }, Anim.Ease.gentle)
        end
    end

    local function showGlyphs(visible)
        for _, entry in ipairs(self.trafficDots) do
            for _, b in ipairs(entry.bars) do
                Anim.tween(b, 0.15, {
                    BackgroundTransparency = visible and 0.15 or 1,
                }, Anim.Ease.gentle)
            end
        end
    end

    table.insert(self.connections, hit.MouseEnter:Connect(function()
        showGlyphs(true)
    end))

    table.insert(self.connections, hit.MouseLeave:Connect(function()
        showGlyphs(false)
        hovered = 0
        paint(0, false)
    end))

    table.insert(self.connections, hit.MouseMoved:Connect(function(x)
        local index = indexAt(x)
        if index ~= hovered then
            hovered = index
            paint(index, true)
        end
    end))

    table.insert(self.connections, hit.MouseButton1Down:Connect(function(x)
        hovered = indexAt(x)
        local entry = self.trafficDots[hovered]
        if entry then
            Anim.tween(entry.dot, 0.08, {
                BackgroundColor3 = shiftColor(entry.spec.color, -0.32),
            }, Anim.Ease.gentle)
        end
    end))

    table.insert(self.connections, hit.MouseButton1Up:Connect(function()
        paint(hovered, true)
    end))

    table.insert(self.connections, hit.MouseButton1Click:Connect(function()
        local entry = self.trafficDots[hovered]
        if not entry then return end
        local name = entry.spec.name
        if name == "Close" then
            self:requestClose()
        elseif name == "Minimise" then
            self:minimise()
        elseif name == "Zoom" then
            self:setZoomed(not self.zoomed)
        end
    end))

    -- Honour whatever Theme says right now, so a config restored before the
    -- window existed is respected on first paint rather than after a flash.
    self:setTrafficLights(Theme.TrafficLights ~= false, true)

    return row
end

-- Slides the header content left or right to make room for the dots.
function Window:applyTrafficLightLayout(enabled)
    local cols = enabled and HEADER_COLUMNS.on or HEADER_COLUMNS.off
    local speed = 0.34

    if self.iconHost then
        Anim.tween(self.iconHost, speed,
            { Position = UDim2.new(0, cols.icon, 0.5, 0) }, Anim.Ease.spring)
    end
    if self.title then
        Anim.tween(self.title, speed,
            { Position = UDim2.new(0, cols.text, 0, 17) }, Anim.Ease.spring)
    end
    if self.subtitle then
        Anim.tween(self.subtitle, speed,
            { Position = UDim2.new(0, cols.text, 0, 34) }, Anim.Ease.spring)
    end
    if self.tagRow then
        Anim.tween(self.tagRow, speed,
            { Position = UDim2.new(0, cols.tag, 0, 0) }, Anim.Ease.spring)
    end
end

-- Parks the redundant X / minimise buttons while the dots are on.
--
-- They are reparented to an off-screen holder as well as hidden: a
-- `Visible = false` child still occupies its slot in a UIListLayout, so simply
-- hiding them would leave a two-button gap in the control bar. This is the same
-- trick the notification cap uses for overflow cards.
function Window:parkControlButtons(park)
    if not self.controlPark then
        self.controlPark = Build.frame(self.header, {
            name = "ControlPark",
            size = UDim2.fromOffset(160, 30),
            position = UDim2.new(0, -500, 0.5, 0),
            transparency = 1,
            zindex = 1,
        })
        self.controlPark.BackgroundTransparency = 1
    end

    local home = park and self.controlPark or self.controls
    for _, button in ipairs({ self.minimiseButton, self.closeButton }) do
        if button and button.holder then
            button.holder.Parent = home
            button.holder.Visible = not park
        end
    end
end

function Window:setTrafficLights(enabled, silent)
    enabled = enabled and true or false
    Theme.TrafficLights = enabled

    if self.trafficRow then
        self.trafficRow.Visible = enabled
    end

    self:applyTrafficLightLayout(enabled)
    self:parkControlButtons(enabled)

    if not silent then LIBRARY:queueAutoSave() end
end

-- Green dot. The rail, content, profile block and settings panel are all sized
-- from the body's scale, so they follow the root on their own.
function Window:setZoomed(zoomed)
    zoomed = zoomed and true or false
    self.zoomed = zoomed

    local w = zoomed and ZOOM_WIDTH or WINDOW_WIDTH
    local h = zoomed and ZOOM_HEIGHT or WINDOW_HEIGHT
    self.windowWidth, self.windowHeight = w, h

    -- The fit-scale pass only recalculates when the viewport changes or this
    -- flag is set. Without it, zooming on a small screen would leave the window
    -- overflowing the screen edge until something else forced a re-check.
    self._scaleChanged = true

    Anim.tween(self.root, 0.42, { Size = UDim2.fromOffset(w, h) }, Anim.Ease.spring)
end

function Window:createControlButton(spec)
    local holder = Build.frame(self.controls, {
        name = "Ctrl_" .. (spec.name or "button"),
        size = UDim2.fromOffset(28, 28),
        transparency = 1,
        zindex = 13,
    })
    holder.BackgroundTransparency = 1

    local plate = Build.frame(holder, {
        name = "Plate",
        size = UDim2.fromScale(1, 1),
        transparency = 1,
        zindex = 13,
    })
    plate.BackgroundColor3 = Theme.BackgroundTertiary
    plate.BackgroundTransparency = 0.86
    Build.corner(plate, 8)

    local glow = Build.frame(holder, {
        name = "Glow",
        size = UDim2.fromScale(1, 1),
        transparency = 1,
        zindex = 12,
    })
    glow.BackgroundColor3 = spec.accent or Theme.Accent
    glow.BackgroundTransparency = 1
    Build.corner(glow, 8)

    local glyphHolder = Build.frame(holder, {
        name = "GlyphHolder",
        size = UDim2.fromOffset(28, 28),
        position = UDim2.fromScale(0, 0),
        transparency = 1,
        zindex = 15,
    })
    glyphHolder.BackgroundTransparency = 1

    local glyph = Glyph.new(glyphHolder, spec.glyph, 15,
        spec.color or Theme.SubText, 0.1, 1.55, false)

    local hit = Build.hitbox(holder, { zindex = 20 })
    holder:SetAttribute("RestSize", holder.Size)

    local function tintGlyph(color, transparency)
        for _, child in ipairs(glyphHolder:GetChildren()) do
            if child.Name:sub(1, 6) == "Glyph_" then
                for _, part in ipairs(child:GetChildren()) do
                    if part.Name == "Seg" then
                        Anim.tween(part, 0.15, { BackgroundColor3 = color }, Anim.Ease.gentle)
                        if transparency then Anim.tween(part, 0.15, { BackgroundTransparency = transparency }, Anim.Ease.gentle) end
                    elseif part.Name == "Ring" then
                        local s = part:FindFirstChildOfClass("UIStroke")
                        if s then
                            Anim.tween(s, 0.15, { Color = color }, Anim.Ease.gentle)
                            if transparency then Anim.tween(s, 0.15, { Transparency = transparency }, Anim.Ease.gentle) end
                        end
                    elseif part.Name == "Bead" then
                        Anim.tween(part, 0.15, { BackgroundColor3 = color }, Anim.Ease.gentle)
                    elseif part.Name == "Dot" then
                        Anim.tween(part, 0.15, { BackgroundColor3 = color }, Anim.Ease.gentle)
                    end
                end
            end
        end
    end

    table.insert(self.connections, hit.MouseEnter:Connect(function()
        Anim.tween(plate, 0.16, {
            BackgroundColor3 = spec.hoverPlate or Theme.BackgroundTertiary,
            BackgroundTransparency = math.max(0, 0.62 - Theme.Transparency),
        }, Anim.Ease.gentle)
        Anim.tween(plate, 0.16, {}, Anim.Ease.gentle)
        Anim.tween(glow, 0.2, { BackgroundTransparency = 1 - 0.30 * (0.35 + Theme.GlowIntensity * 0.65) }, Anim.Ease.gentle)
        Anim.tween(holder, 0.22, { Size = UDim2.fromOffset(30, 30) }, Anim.Ease.spring)
        tintGlyph(spec.accent or Theme.AccentSoft, 0)
    end))

    table.insert(self.connections, hit.MouseLeave:Connect(function()
        Anim.tween(plate, 0.22, {
            BackgroundColor3 = Theme.BackgroundTertiary,
            BackgroundTransparency = 0.86,
        }, Anim.Ease.gentle)
        Anim.tween(glow, 0.24, { BackgroundTransparency = 1 }, Anim.Ease.gentle)
        Anim.tween(holder, 0.28, { Size = UDim2.fromOffset(28, 28) }, Anim.Ease.spring)
        tintGlyph(spec.color or Theme.SubText, 0.1)
    end))

    table.insert(self.connections, hit.MouseButton1Down:Connect(function()
        Anim.tween(holder, 0.09, { Size = UDim2.fromOffset(25, 25) }, Anim.Ease.gentle)
    end))

    table.insert(self.connections, hit.MouseButton1Up:Connect(function()
        Anim.tween(holder, 0.24, { Size = UDim2.fromOffset(28, 28) }, Anim.Ease.spring)
    end))

    table.insert(self.connections, hit.MouseButton1Click:Connect(function()
        if spec.onClick then task.spawn(spec.onClick) end
    end))

    holder.LayoutOrder = spec.order or 1

    return {
        holder = holder,
        plate = plate,
        glow = glow,
        glyphHolder = glyphHolder,
        glyph = glyph,
        hit = hit,
        tintGlyph = tintGlyph,
    }
end

function Window:buildControls()
    -- search
    self.searchButton = self:createControlButton({
        name = "Search",
        glyph = "search",
        order = 1,
        onClick = function() self:toggleSearch() end,
    })

    -- settings
    self.settingsButton = self:createControlButton({
        name = "Settings",
        glyph = "settings",
        order = 2,
        onClick = function() self:toggleSettings() end,
    })

    -- minimise
    self.minimiseButton = self:createControlButton({
        name = "Minimise",
        glyph = "minimise",
        order = 3,
        onClick = function() self:minimise() end,
    })

    -- close
    self.closeButton = self:createControlButton({
        name = "Close",
        glyph = "close",
        order = 4,
        accent = Theme.Error,
        hoverPlate = Theme.Error,
        onClick = function() self:requestClose() end,
    })
end

-- Close confirmation -------------------------------------------------------
-- Closing hides the live window but does not destroy it. Require an explicit
-- second click so an accidental tap on the X cannot dismiss the interface.
function Window:buildCloseConfirm()
    if self.closeConfirmPanel and self.closeConfirmPanel.Parent then
        return self.closeConfirmPanel
    end

    local panel = Build.frame(self.overlay, {
        name = "CloseConfirm",
        size = UDim2.fromOffset(330, 166),
        position = UDim2.fromScale(0.5, 0.5),
        anchor = Vector2.new(0.5, 0.5),
        transparency = 0,
        zindex = 950,
        visible = false,
    })
    panel.BackgroundColor3 = Theme.BackgroundSecondary
    panel.BackgroundTransparency = 0.02
    panel.ClipsDescendants = true
    Build.corner(panel, Theme.CornerLarge)
    local stroke = Build.stroke(panel, Theme.AccentSoft, 1, 0.35)

    Build.text(panel, {
        name = "Title",
        text = "Close interface?",
        size = UDim2.new(1, -36, 0, 24),
        position = UDim2.fromOffset(18, 16),
        font = Enum.Font.GothamBold,
        textSize = 16,
        color = Theme.Text,
        zindex = 951,
    })
    Build.text(panel, {
        name = "Message",
        text = "Are you sure you want to close this UI? You can open it again with "
            .. LIBRARY:keyLabel(State.ToggleKey) .. ".",
        size = UDim2.new(1, -36, 0, 42),
        position = UDim2.fromOffset(18, 47),
        font = Enum.Font.Gotham,
        textSize = 12,
        color = Theme.SubText,
        wrap = true,
        truncate = Enum.TextTruncate.None,
        zindex = 951,
    })

    local cancel = Build.button(panel, {
        name = "Cancel",
        size = UDim2.fromOffset(112, 30),
        position = UDim2.new(1, -244, 1, -44),
        transparency = 0.15,
        color = Theme.BackgroundTertiary,
        zindex = 952,
    })
    Build.corner(cancel, 8)
    Build.text(cancel, {
        name = "Label",
        text = "Cancel",
        size = UDim2.fromScale(1, 1),
        font = Enum.Font.GothamMedium,
        textSize = 12,
        color = Theme.Text,
        align = Enum.TextXAlignment.Center,
        zindex = 953,
    })

    local confirm = Build.button(panel, {
        name = "Confirm",
        size = UDim2.fromOffset(112, 30),
        position = UDim2.new(1, -124, 1, -44),
        transparency = 0,
        color = Theme.Error,
        zindex = 952,
    })
    Build.corner(confirm, 8)
    Build.text(confirm, {
        name = "Label",
        text = "Close UI",
        size = UDim2.fromScale(1, 1),
        font = Enum.Font.GothamBold,
        textSize = 12,
        color = Theme.Text,
        align = Enum.TextXAlignment.Center,
        zindex = 953,
    })

    cancel.MouseButton1Click:Connect(function()
        self:cancelClose()
    end)
    confirm.MouseButton1Click:Connect(function()
        self:cancelClose()
        self:close()
    end)

    self.closeConfirmPanel = panel
    self.closeConfirmParts = { panel = panel, stroke = stroke, cancel = cancel, confirm = confirm }
    return panel
end

function Window:requestClose()
    local panel = self:buildCloseConfirm()
    if self.settingsOpen then self:closeSettings() end
    panel.Visible = true
    panel.Size = UDim2.fromOffset(330, 150)
    panel.BackgroundTransparency = 1
    Anim.tween(panel, 0.24, {
        Size = UDim2.fromOffset(330, 166),
        BackgroundTransparency = 0.02,
    }, Anim.Ease.spring)
end

function Window:cancelClose()
    local panel = self.closeConfirmPanel
    if not panel or not panel.Visible then return end
    Anim.tween(panel, 0.18, {
        Size = UDim2.fromOffset(330, 150),
        BackgroundTransparency = 1,
    }, Anim.Ease.soft, Anim.Dir.inward)
    task.delay(0.2, function()
        if panel and panel.Parent then panel.Visible = false end
    end)
end

-- ═══════════════════════════════════════════════════════════════════════════
--  SEARCH
-- ═══════════════════════════════════════════════════════════════════════════

function Window:toggleSearch()
    self.searchOpen = not self.searchOpen

    if self.searchOpen then
        self.searchButton.hit.Visible = false
        self.controls.Visible = false
        self.searchBar.Visible = true
        -- hideSearch retires the glyph, so bring it back with the bar.
        if self.searchGlyphHolder then self.searchGlyphHolder.Visible = true end

        Anim.tween(self.searchBar, 0.34, {
            Size = UDim2.new(0, 250, 0, 30),
        }, Anim.Ease.spring)
        Anim.tween(self.searchBar, 0.3, {
            BackgroundTransparency = math.max(0, 0.12 - Theme.Transparency),
        }, Anim.Ease.soft)
        Anim.tween(self.searchStroke, 0.3, { Transparency = 0.25 }, Anim.Ease.soft)

        self.searchBox.Visible = true
        self.searchClear.Visible = true
        task.wait(0.16)
        if self.searchBox.Parent then
            self.searchBox:CaptureFocus()
        end
    else
        self:hideSearch()
    end
end

-- Collapses the field and reports whether the search UI was open.
function Window:hideSearch()
    if not self.searchOpen then return false end
    self.searchOpen = false

    pcall(function() self.searchBox:ReleaseFocus() end)
    self.searchBox.Text = ""
    self:clearSearchResults()
    self:setSearchResultsOpen(false)

    -- Hide the magnifier as well as the field.
    --
    -- The bar only ever faded its BACKGROUND, so the 30x30 glyph stayed drawn
    -- at the header's top-right -- at zindex 20, above the controls at 13. It
    -- landed exactly on the close button, which is why the X appeared to turn
    -- into a search icon after minimising and restoring.
    if self.searchGlyphHolder then self.searchGlyphHolder.Visible = false end

    Anim.tween(self.searchBar, 0.28, {
        Size = UDim2.new(0, 30, 0, 30),
    }, Anim.Ease.soft, Anim.Dir.inward)
    Anim.tween(self.searchBar, 0.26, { BackgroundTransparency = 1 }, Anim.Ease.soft, Anim.Dir.inward)
    Anim.tween(self.searchStroke, 0.26, { Transparency = 1 }, Anim.Ease.soft, Anim.Dir.inward)

    task.delay(0.1, function()
        self.searchBox.Visible = false
        self.searchClear.Visible = false
    end)

    task.delay(0.2, function()
        self.controls.Visible = true
        self.searchButton.hit.Visible = true
        -- Fully retire the bar so nothing of it can draw over the controls.
        self.searchBar.Visible = false
    end)

    return true
end

-- ═══════════════════════════════════════════════════════════════════════════
--  WINDOW VISIBILITY
-- ═══════════════════════════════════════════════════════════════════════════

-- Scale-and-fade entrance.
function Window:open()
    if State.Destroyed or self.opened then return end
    self._visibilityToken = (self._visibilityToken or 0) + 1
    local token = self._visibilityToken
    self.opened = true
    State.Open = true
    State.Minimised = false

    self.root.Visible = true
    if self.closeConfirmPanel then self.closeConfirmPanel.Visible = false end
    self.root.Size = UDim2.fromOffset(WINDOW_WIDTH * 0.86, WINDOW_HEIGHT * 0.86)
    self.body.BackgroundTransparency = 1
    self.border.Transparency = 1
    self.borderGlow.Transparency = 1
    self.shadow.BackgroundTransparency = 1
    self.bloom.BackgroundTransparency = 1

    Anim.tween(self.root, 0.55, {
        Size = UDim2.fromOffset(WINDOW_WIDTH, WINDOW_HEIGHT),
    }, Anim.Ease.spring)

    Anim.tween(self.body, 0.42, {
        BackgroundTransparency = math.max(0, 0.06 + Theme.Transparency),
    }, Anim.Ease.soft)
    Anim.tween(self.shadow, 0.5, { BackgroundTransparency = 0.72 }, Anim.Ease.soft)
    Anim.tween(self.bloom, 0.6, {
        BackgroundTransparency = 1 - 0.10 * (0.3 + Theme.GlowIntensity * 0.7),
    }, Anim.Ease.soft)
    Anim.tween(self.border, 0.45, { Transparency = 0.35 }, Anim.Ease.soft)
    Anim.tween(self.borderGlow, 0.5, {
        Transparency = 1 - 0.42 * (0.3 + Theme.GlowIntensity * 0.7),
    }, Anim.Ease.soft)

    -- content staggers in behind the shell
    for _, child in ipairs({ self.header, self.rail, self.content, self.profilePanel }) do
        if child then
            child.Visible = true
        end
    end
end

-- Fades and shrinks away. `onDone` fires once the window is off screen.
function Window:close(onDone)
    self._visibilityToken = (self._visibilityToken or 0) + 1
    local token = self._visibilityToken
    State.Open = false
    self.opened = false

    Anim.tween(self.root, 0.34, {
        Size = UDim2.fromOffset(WINDOW_WIDTH * 0.90, WINDOW_HEIGHT * 0.90),
    }, Anim.Ease.soft, Anim.Dir.inward)
    Anim.tween(self.body, 0.3, { BackgroundTransparency = 1 }, Anim.Ease.soft, Anim.Dir.inward)
    Anim.tween(self.shadow, 0.28, { BackgroundTransparency = 1 }, Anim.Ease.soft, Anim.Dir.inward)
    Anim.tween(self.bloom, 0.28, { BackgroundTransparency = 1 }, Anim.Ease.soft, Anim.Dir.inward)
    Anim.tween(self.border, 0.26, { Transparency = 1 }, Anim.Ease.soft, Anim.Dir.inward)
    Anim.tween(self.borderGlow, 0.26, { Transparency = 1 }, Anim.Ease.soft, Anim.Dir.inward)

    task.delay(0.36, function()
        if self._visibilityToken ~= token or self.opened then return end
        self.root.Visible = false
        if onDone then task.spawn(onDone) end
    end)
end

--[[
    Minimise: shrink and fade the window out, then drop in the Show NC pill.

    The pill is only revealed once the window has actually left, so the two
    never occupy the screen at the same time.
]]
function Window:minimise()
    if State.Minimised or not self.opened then return end
    State.Minimised = true
    self.opened = false

    if self.searchOpen then self:hideSearch() end
    if self.settingsPanel then self:closeSettings() end

    self:close(function()
        if State.ShowPill then
            State.ShowPill:show()
        end
    end)

    LIBRARY:Notify({
        Title = "Minimised",
        Content = "Use the Show NC pill at the top of your screen.",
        Type = "info",
        Duration = 2.8,
    })
end

-- Clicking the pill brings the window back and retires the pill.
function Window:restore()
    if not State.Minimised then return end
    State.Minimised = false

    local pill = State.ShowPill
    if pill then pill:hide() end

    -- Restore the same live window.  Nothing is destroyed and the stale close
    -- callback cannot hide it after this point.
    self._visibilityToken = (self._visibilityToken or 0) + 1
    self.opened = false
    self.root.Visible = true
    self:open()
end

function Window:destroy()
    if self.disconnectDrag then pcall(self.disconnectDrag) end
    if self.particleConn then pcall(function() self.particleConn:Disconnect() end) end
    for _, conn in ipairs(self.connections) do
        pcall(function() conn:Disconnect() end)
    end
    self.root:Destroy()
end

-- Queue a single themed repaint for the next render frame.
function Window:queueRecolour()
    self._recolourQueued = true
end

-- Repaints every themed surface when the accent changes.
function Window:recolour()
    if not self.body or not self.body.Parent then return end

    local transparency = Theme.Transparency
    local glow = Theme.GlowIntensity
    local gradientOn = Theme.GradientMode
    local function alpha(base, multiplier)
        return math.clamp(base + transparency * (multiplier or 1), 0, 0.98)
    end

    self.body.BackgroundColor3 = Theme.Background
    self.body.BackgroundTransparency = alpha(0.06, 0.8)
    self.windowGradient.Color = seq(
        shiftColor(Theme.Accent, -0.90),
        Theme.Background,
        shiftColor(Theme.Accent, -0.94)
    )
    self.windowGradient.Enabled = gradientOn
    self.border.Color = Theme.Border
    self.border.Transparency = alpha(0.35, 0.5)
    self.borderGlow.Color = Theme.Accent
    self.borderGlow.Transparency = 1 - 0.42 * (0.3 + glow * 0.7)
    self.bloom.BackgroundColor3 = Theme.Accent
    self.bloom.BackgroundTransparency = 1 - 0.10 * (0.3 + glow * 0.7)

    self.headerLine.BackgroundColor3 = Theme.Border
    self.title.TextColor3 = Theme.Text
    self.subtitle.TextColor3 = Theme.SubText

    self.railIndicator.BackgroundColor3 = Theme.Accent
    self.railIndicatorGradient.Color = seq(Theme.AccentSoft, Theme.Accent)
    self.railIndicatorGradient.Enabled = gradientOn
    self.railIndicatorGlow.BackgroundColor3 = Theme.Accent
    self.railIndicatorGlow.BackgroundTransparency = 1

    self.searchBar.BackgroundColor3 = Theme.BackgroundTertiary
    self.searchStroke.Color = Theme.Border
    self.searchBox.TextColor3 = Theme.Text
    self.searchBox.PlaceholderColor3 = Theme.MutedText

    self.corner.CornerRadius = UDim.new(0, Theme.CornerLarge)

    if self.profilePanel then
        self.profilePanel.BackgroundColor3 = Theme.BackgroundTertiary
        self.profilePanel.BackgroundTransparency = alpha(0.55, 0.7)
        if self.profileParts then
            self.profileParts.stroke.Color = Theme.Border
            self.profileParts.avatarStroke.Color = Theme.Accent
            self.profileParts.avatarHolder.BackgroundColor3 = Theme.Background
            self.profileParts.name.TextColor3 = Theme.Text
            self.profileParts.handle.TextColor3 = Theme.SubText
        end
    end

    -- Sections, tabs, controls, popups, settings, strokes, gradients and
    -- corners all repaint from the current Theme instead of keeping the old
    -- purple/black literals that made the settings sliders appear broken.
    for _, tab in ipairs(self.tabOrder or {}) do
        if tab.recolour then tab:recolour() end
        for _, section in ipairs(tab.sections or {}) do
            if section.shell and section.shell.Parent then
                section.shell.BackgroundColor3 = Theme.BackgroundSecondary
                section.shell.BackgroundTransparency = alpha(0.45, 0.8)
                if section.stroke then section.stroke.Color = Theme.Border end
                if section.corner then section.corner.CornerRadius = UDim.new(0, Theme.Corner) end
            end
        end
    end

    for _, inst in ipairs(self.root:GetDescendants()) do
        local n = inst.Name or ""
        if inst:IsA("Frame") or inst:IsA("TextButton") then
            if n == "SettingsPanel" or n:sub(1, 6) == "Group_" or n:sub(1, 9) == "Dropdown_" then
                inst.BackgroundColor3 = Theme.BackgroundSecondary
            elseif n:sub(1, 8) == "Section_" then
                inst.BackgroundColor3 = Theme.BackgroundSecondary
                inst.BackgroundTransparency = alpha(0.45, 0.8)
            elseif n == "Field" or n == "Track" or n == "SearchBar" or n == "Profile" then
                inst.BackgroundColor3 = Theme.BackgroundTertiary
                if n ~= "SearchBar" then inst.BackgroundTransparency = alpha(0.20, 0.7) end
            elseif n == "Plate" then
                local owner = inst.Parent and inst.Parent.Name or ""
                inst.BackgroundColor3 = Theme.BackgroundTertiary
                inst.BackgroundTransparency = owner:sub(1, 5) == "Ctrl_"
                    and 0.86
                    or math.clamp(0.16 + transparency * 0.35, 0, 0.82)
            elseif n == "Fill" or n == "ProgressFill" or n == "Indicator" then
                inst.BackgroundColor3 = Theme.Accent
            elseif n == "Bloom" then
                inst.BackgroundColor3 = Theme.Accent
                inst.BackgroundTransparency = 1 - 0.10 * (0.3 + glow * 0.7)
            elseif n == "Glow" or n == "AccentGlow" or n == "PillGlow" or n == "KnobGlow" then
                -- These are hover/drag layers. They must start hidden and are
                -- revealed only by their interaction handlers.
                inst.BackgroundColor3 = Theme.Accent
                inst.BackgroundTransparency = 1
            end
        elseif inst:IsA("TextLabel") or inst:IsA("TextBox") then
            if n == "Title" or n == "ButtonLabel" or n == "Label" then
                inst.TextColor3 = Theme.Text
            elseif n == "Description" or n == "Sub" or n == "Handle" then
                inst.TextColor3 = Theme.SubText
            end
        elseif inst:IsA("UIStroke") then
            local parentName = inst.Parent and inst.Parent.Name or ""
            if parentName == "SettingsPanel" or parentName:sub(1, 8) == "Section_" or parentName:sub(1, 6) == "Group_" then
                inst.Color = Theme.Border
            elseif parentName == "Field" or parentName == "Track" then
                inst.Color = Theme.Border
            elseif parentName == "Plate" then
                inst.Color = Theme.Border
            elseif parentName == "Indicator" then
                inst.Color = Theme.AccentSoft
            end
        elseif inst:IsA("UIGradient") then
            local parentName = inst.Parent and inst.Parent.Name or ""
            if parentName == "Body" then
                inst.Color = seq(shiftColor(Theme.Accent, -0.90), Theme.Background, shiftColor(Theme.Accent, -0.94))
                inst.Enabled = gradientOn
            elseif parentName == "Fill" or parentName:sub(1, 4) == "Tab_" then
                inst.Color = seq(Theme.Accent, Theme.AccentSecondary)
                inst.Enabled = gradientOn
            elseif parentName == "Plate" then
                inst.Color = seq(Theme.Accent, Theme.AccentSecondary)
                inst.Enabled = false
            elseif parentName == "SettingsPanel" then
                inst.Enabled = gradientOn
            end
        elseif inst:IsA("UICorner") then
            local parentName = inst.Parent and inst.Parent.Name or ""
            local radius = Theme.Corner
            if parentName == "Body" or parentName == "SettingsPanel" then
                radius = Theme.CornerLarge
            elseif parentName == "Knob" or parentName == "KnobGlow" or parentName == "HueCursor" then
                radius = 999
            elseif parentName == "Track" then
                radius = 999
            end
            inst.CornerRadius = UDim.new(0, radius)
        end
    end

    if self.settingsPanel then
        self.settingsPanel.BackgroundColor3 = Theme.BackgroundSecondary
        self.settingsPanel.BackgroundTransparency = 0
    end
    if notifyStack and notifyStack.Parent then
        for _, inst in ipairs(notifyStack:GetDescendants()) do
            if inst:IsA("Frame") and (inst.Name == "Notification" or inst.Name == "IconHost") then
                inst.BackgroundColor3 = inst.Name == "Notification" and Theme.BackgroundSecondary or Theme.Accent
            elseif inst:IsA("UIStroke") and inst.Parent and inst.Parent.Name == "Notification" then
                inst.Color = Theme.AccentSoft
            elseif inst:IsA("UIGradient") and inst.Parent and inst.Parent.Name == "Notification" then
                inst.Color = seq(Theme.BackgroundTertiary, Theme.Background)
                inst.Enabled = gradientOn
            end
        end
    end
    if self.closeConfirmParts then
        self.closeConfirmParts.panel.BackgroundColor3 = Theme.BackgroundSecondary
        self.closeConfirmParts.stroke.Color = Theme.AccentSoft
        self.closeConfirmParts.cancel.BackgroundColor3 = Theme.BackgroundTertiary
        self.closeConfirmParts.confirm.BackgroundColor3 = Theme.Error
    end
    if State.ShowPill then State.ShowPill:recolour() end
    Glyph.recolour()
end

