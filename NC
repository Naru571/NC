        font = Enum.Font.GothamBold,
        textSize = 16,
        color = Theme.Text,
        align = Enum.TextXAlignment.Left,
        zindex = 703,
    })
    Build.text(head, {
        name = "Sub",
        text = "Appearance, configs and behaviour",
        size = UDim2.new(1, -30, 0, 14),
        position = UDim2.fromOffset(0, 20),
        font = Enum.Font.Gotham,
        textSize = 11,
        color = Theme.MutedText,
        align = Enum.TextXAlignment.Left,
        zindex = 703,
