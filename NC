Glyph.registry = {}

local function makeSegment(parent, x1, y1, x2, y2, scale, thickness, color, transparency)
    local dx, dy = x2 - x1, y2 - y1
    local length = math.sqrt(dx * dx + dy * dy)
    local segment = Instance.new("Frame")
    segment.Name = "Seg"
    segment.AnchorPoint = Vector2.new(0.5, 0.5)
    segment.Position = UDim2.fromOffset((x1 + x2) / 2 * scale, (y1 + y2) / 2 * scale)
    segment.Size = UDim2.fromOffset(length * scale, thickness)
    segment.Rotation = math.deg(math.atan2(dy, dx))
    segment.BackgroundColor3 = color
    segment.BackgroundTransparency = transparency
    segment.BorderSizePixel = 0
    segment.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = segment

    return segment
end

local function makeRing(parent, cx, cy, radius, scale, thickness, color, transparency)
    local ring = Instance.new("Frame")
    ring.Name = "Ring"
    ring.AnchorPoint = Vector2.new(0.5, 0.5)
    ring.Position = UDim2.fromOffset(cx * scale, cy * scale)
    ring.Size = UDim2.fromOffset(radius * 2 * scale, radius * 2 * scale)
    ring.BackgroundTransparency = 1
    ring.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = ring

    local stroke = Instance.new("UIStroke")
    stroke.Color = color
    stroke.Thickness = thickness
    stroke.Transparency = transparency
    stroke.Parent = ring

    return ring
end

local function makeDot(parent, cx, cy, radius, scale, color, transparency, name)
    local dot = Instance.new("Frame")
    dot.Name = name or "Dot"
    dot.AnchorPoint = Vector2.new(0.5, 0.5)
    dot.Position = UDim2.fromOffset(cx * scale, cy * scale)
    dot.Size = UDim2.fromOffset(radius * 2 * scale, radius * 2 * scale)
    dot.BackgroundColor3 = color
    dot.BackgroundTransparency = transparency
    dot.BorderSizePixel = 0
    dot.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = dot

    return dot
end

-- Theme keys a glyph's colour can be tied to. If a caller passes one of these
-- exact colours, the glyph remembers the ROLE rather than the literal value, so
-- a theme change re-resolves it. A colour that matches nothing stays literal,
-- which keeps deliberately-fixed icons (a custom hex) fixed.
local GLYPH_ROLES = {
    "Text", "SubText", "MutedText",
    "Accent", "AccentSoft", "AccentDeep", "AccentBright",
    "Border", "BorderBright",
    "Success", "Warning", "Error", "Info",
}

local function glyphRoleFor(color)
    if typeof(color) ~= "Color3" then return nil end
    for _, role in ipairs(GLYPH_ROLES) do
        local value = Theme[role]
        if typeof(value) == "Color3" and value == color then
            return role
        end
    end
    return nil
end

-- Resolves the colour a glyph should currently be painted.
local function glyphBaseColor(frame)
    local role = frame:GetAttribute("BaseColorRole")
    if role and role ~= "" and typeof(Theme[role]) == "Color3" then
        return Theme[role]
    end
    return frame:GetAttribute("BaseColor") or Theme.Text
end

-- Renders one glyph into `parent` at the given pixel size.
-- Beads default on above 15px, below which they crowd the strokes.
function Glyph.new(parent, name, size, color, transparency, thickness, beads)
    local frame = Instance.new("Frame")
    frame.Name = "Glyph_" .. tostring(name)
    frame.BackgroundTransparency = 1
    frame.Size = UDim2.fromOffset(size, size)
    frame.ClipsDescendants = false
    -- Centre inside the holder. Holders are routinely larger than the glyph --
    -- the notification badge is 30px around a 17px icon, the search field 30px
    -- around a 15px one -- and the frame defaulted to (0,0), which pinned every
    -- icon into the top-left corner. For an equal-size holder this is a no-op.
    frame.AnchorPoint = Vector2.new(0.5, 0.5)
    frame.Position = UDim2.fromScale(0.5, 0.5)
    frame.Parent = parent

    local data = Glyph.data[name]
    if not data then
        warn("[NC] unknown glyph: " .. tostring(name))
        return frame
    end

    color = color or Theme.Text
    transparency = transparency or 0

    -- Remember the colour this glyph was built with so a theme change restores
    -- it. Recolouring everything to Theme.Text used to flatten
    -- deliberately-coloured icons -- accent-tinted, error-red -- into plain
    -- body text.
    --
    -- Stored as ATTRIBUTES, not as a Lua field. Roblox Instances reject
    -- arbitrary property assignment, so `frame.__color = color` threw
    -- "__color is not a valid member of Frame" and took the entire loading
    -- stage down with it. Attributes are the supported place for extra data.
    --
    -- Also record WHICH theme role the colour came from, when it matches one.
    -- Restoring the literal colour alone froze accent-tinted icons on whatever
    -- accent was active at build time -- which is why the section header icons
    -- stayed purple after switching the accent to red. A role is re-resolved
    -- against the live Theme on every repaint; a literal stays put.
    frame:SetAttribute("BaseColor", color)
    frame:SetAttribute("BaseColorRole", glyphRoleFor(color) or "")
    frame:SetAttribute("BaseTransparency", transparency)

    local scale = size / 24
    local stroke = thickness or math.max(1.5, 2.0 * scale)
    if beads == nil then beads = size >= 15 end
    local beadRadius = math.max(1.05, 1.15 * scale)

    for _, part in ipairs(data) do
        local kind = part[1]
        if kind == "d" then
            makeSegment(frame, part[2], part[3], part[4], part[5], scale, stroke, color, transparency)
            if beads then
                makeDot(frame, part[2], part[3], beadRadius, scale, Theme.AccentSoft, transparency, "Bead")
                makeDot(frame, part[4], part[5], beadRadius, scale, Theme.AccentSoft, transparency, "Bead")
            end
        elseif kind == "c" then
            makeRing(frame, part[2], part[3], part[4], scale, stroke, color, transparency)
        elseif kind == "o" then
            makeDot(frame, part[2], part[3], part[4], scale, color, transparency)
        end
    end

    table.insert(Glyph.registry, frame)

    return frame
end

-- Uniformly fade or restore a glyph (used by dropdown option ticks).
function Glyph.setTransparency(frame, transparency)
    if not frame or not frame.Parent then return end
    for _, child in ipairs(frame:GetChildren()) do
        if child.Name == "Seg" or child.Name == "Bead" or child.Name == "Dot" then
            Anim.tween(child, 0.16, { BackgroundTransparency = transparency }, Anim.Ease.soft)
        elseif child.Name == "Ring" then
            local stroke = child:FindFirstChildOfClass("UIStroke")
            if stroke then Anim.tween(stroke, 0.16, { Transparency = transparency }, Anim.Ease.soft) end
        end
    end
end

function Glyph.setColor(frame, color)
    if not frame or not frame.Parent then return end
    -- Attribute, not a Lua field -- see the note in Glyph.new. The role is
    -- refreshed too, so a glyph tinted to a theme colour later still follows it.
    frame:SetAttribute("BaseColor", color)
    frame:SetAttribute("BaseColorRole", glyphRoleFor(color) or "")
    for _, child in ipairs(frame:GetChildren()) do
        if child.Name == "Seg" or child.Name == "Dot" then
            Anim.tween(child, 0.2, { BackgroundColor3 = color }, Anim.Ease.soft)
        elseif child.Name == "Bead" then
            Anim.tween(child, 0.2, { BackgroundColor3 = Theme.AccentSoft }, Anim.Ease.soft)
        elseif child.Name == "Ring" then
            local stroke = child:FindFirstChildOfClass("UIStroke")
            if stroke then Anim.tween(stroke, 0.2, { Color = color }, Anim.Ease.soft) end
        end
    end
end

-- Recolour every live glyph when the accent changes, so icons stay in step
-- with the theme without needing a rebuild.
function Glyph.recolour()
    for index = #Glyph.registry, 1, -1 do
        local frame = Glyph.registry[index]
        if not frame or not frame.Parent then
            table.remove(Glyph.registry, index)
        else
            -- Restore each glyph's own colour rather than forcing Theme.Text,
            -- which wiped out accent-tinted and error-red icons on every theme
            -- change. glyphBaseColor re-resolves a themed role against the live
            -- Theme, so accent icons follow the accent instead of freezing on
            -- whatever was active when they were built.
            local base = glyphBaseColor(frame)
            for _, child in ipairs(frame:GetChildren()) do
                if child.Name == "Seg" then
                    child.BackgroundColor3 = base
                elseif child.Name == "Bead" then
                    child.BackgroundColor3 = Theme.AccentSoft
                elseif child.Name == "Ring" then
                    local stroke = child:FindFirstChildOfClass("UIStroke")
                    if stroke then stroke.Color = base end
                end
            end
        end
    end
end

-- Returns a glyph name guaranteed to exist in Glyph.data. Callers used to pass
-- an icon name straight through whenever it happened to be a string, so a typo
-- or an unsupported name produced a warning and an invisible icon.
function Glyph.resolve(name, fallback)
    if type(name) == "string" and Glyph.data[name] then return name end
    return fallback or "grid"
end

