    closeHit.MouseEnter:Connect(function()
        Glyph.setColor(closeHolder.Glyph_close or closeHolder:FindFirstChild("Glyph_close"), Theme.Error)
    end)
    closeHit.MouseLeave:Connect(function()
        Glyph.setColor(closeHolder.Glyph_close or closeHolder:FindFirstChild("Glyph_close"), Theme.SubText)
    end)

    ----------------------------------------------------------------------
    -- Appearance
    ----------------------------------------------------------------------
    local appearance = settingsSection:CreateGroup({ name = "Appearance" })

    -- Declared before the call: the callback closes over `picker`, and writing
    -- `local picker = createColourPicker(... picker ...)` would capture the
    -- outer (nil) binding, so dragging the picker threw "attempt to index nil".
    local picker
    picker = createColourPicker(appearance.contentHolder, Theme.Accent, function(colour)
        LIBRARY:setAccent(colour)
        if picker.__setSwatch then picker.__setSwatch(colour) end
    end)
