local Build = {}

local function asColorSequence(colors)
    if typeof(colors) == "ColorSequence" then
        return colors
    end
    if type(colors) ~= "table" then
        return colors or Theme.Gradient
    end

    local count = #colors
    if count == 0 then
        return Theme.Gradient
    end
    if count == 1 then
        return ColorSequence.new(colors[1], colors[1])
    end

    if typeof(colors[1]) == "ColorSequenceKeypoint" then
        return ColorSequence.new(colors)
    end

    local points = {}
    for index, color in ipairs(colors) do
        if typeof(color) ~= "Color3" then
            return Theme.Gradient
        end
        table.insert(points, ColorSequenceKeypoint.new(
            (index - 1) / (count - 1),
            color
        ))
    end
    return ColorSequence.new(points)
end

function Build.frame(parent, props)
    local frame = Instance.new("Frame")
    frame.BackgroundColor3 = props.color or Theme.BackgroundSecondary
    frame.BackgroundTransparency = props.transparency or 0
    frame.BorderSizePixel = 0
    frame.Size = props.size or UDim2.fromScale(1, 1)
    frame.Position = props.position or UDim2.fromScale(0, 0)
    frame.AnchorPoint = props.anchor or Vector2.new(0, 0)
    frame.ZIndex = props.zindex or 1
    frame.Visible = props.visible ~= false
    if props.clips ~= nil then frame.ClipsDescendants = props.clips end
    if props.name then frame.Name = props.name end
    frame.Parent = parent

    if props.corner ~= false then
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, props.corner or Theme.Corner)
        corner.Parent = frame
    end

    if props.gradient then
        local gradient = Instance.new("UIGradient")
        gradient.Color = asColorSequence(props.gradient)
        gradient.Rotation = props.gradientRotation or Theme.GradientAngle
        gradient.Parent = frame
    end

    if props.stroke then
        local stroke = Instance.new("UIStroke")
        stroke.Color = props.stroke
        stroke.Thickness = props.strokeWidth or 1
        stroke.Transparency = props.strokeTransparency or 0
        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        stroke.Parent = frame
        frame:SetAttribute("StrokeIndex", 1)
    end

    if props.padding then
        local pad = Instance.new("UIPadding")
        pad.PaddingTop = UDim.new(0, props.padding)
        pad.PaddingBottom = UDim.new(0, props.padding)
        pad.PaddingLeft = UDim.new(0, props.padding)
        pad.PaddingRight = UDim.new(0, props.padding)
        pad.Parent = frame
    end

    return frame
end

function Build.text(parent, props)
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.BorderSizePixel = 0
    label.Text = props.text or ""
    label.Size = props.size or UDim2.new(1, 0, 0, 18)
    label.Position = props.position or UDim2.fromScale(0, 0)
    label.AnchorPoint = props.anchor or Vector2.new(0, 0)
    label.Font = props.font or Enum.Font.GothamMedium
    label.TextSize = props.size_ or props.textSize or 13
    label.TextColor3 = props.color or Theme.Text
    label.TextTransparency = props.transparency or 0
    label.TextXAlignment = props.xalign or props.align or Enum.TextXAlignment.Left
    label.TextYAlignment = props.yalign or props.valign or Enum.TextYAlignment.Center
    label.TextWrapped = (props.wrapped == true) or (props.wrap == true)
    label.RichText = props.rich == true
    label.ZIndex = props.zindex or 2
    label.Visible = props.visible ~= false
    label.TextTruncate = props.truncate or Enum.TextTruncate.None
    if props.name then label.Name = props.name end
    label.Parent = parent
    return label
end

function Build.button(parent, props)
