}

Anim.Dir = {
    out    = Enum.EasingDirection.Out,
    inward = Enum.EasingDirection.In,
    both   = Enum.EasingDirection.InOut,
}

Anim.Speed = {
    instant = 0.08,
    fast    = 0.16,
    normal  = 0.26,
    slow    = 0.42,
    reveal  = 0.55,
}

local activeTweens = {}

function Anim.tween(inst, duration, props, style, direction)
    if not inst or not inst.Parent then return end
    duration = (duration or Anim.Speed.normal) / math.max(Theme.AnimationSpeed, 0.1)
    local info = TweenInfo.new(duration, style or Anim.Ease.soft, direction or Anim.Dir.out)
    local tween = TweenService:Create(inst, info, props)
    tween:Play()
    table.insert(activeTweens, tween)
    tween.Completed:Once(function()
        for i = #activeTweens, 1, -1 do
            if activeTweens[i] == tween then table.remove(activeTweens, i) end
        end
    end)
    return tween
end

function Anim.stagger(items, fn, step)
    step = step or 0.035
    for index, item in ipairs(items) do
        task.delay((index - 1) * step, function()
            fn(item, index)
        end)
    end
end

function Anim.cancelAll()
    for _, tween in ipairs(activeTweens) do
        pcall(function() tween:Cancel() end)
    end
    table.clear(activeTweens)
end

