function Section:CreateToggle(props)
    props = props or {}
    local value = props.value or props.Value or false
    if props.flag and State.Flags[props.flag] ~= nil then
        value = State.Flags[props.flag]
    end

    local row, label = createRow(self, props, { rightPad = 70 })

    local track = Build.frame(row, {
        name = "Track",
        size = UDim2.fromOffset(42, 22),
        position = UDim2.new(1, -42, 0.5, 0),
        anchor = Vector2.new(0, 0.5),
        transparency = 1,
        zindex = 8,
    })
    track.BackgroundColor3 = Theme.BackgroundTertiary
    track.BackgroundTransparency = 0.35
    Build.corner(track, 11)
    local trackStroke = Build.stroke(track, Theme.Border, 1, 0.5)

    local knob = Build.frame(track, {
        name = "Knob",
        size = UDim2.fromOffset(16, 16),
        position = UDim2.fromOffset(3, 3),
        -- Visible. paint() animates this knob's Position and colour but never
        -- its transparency, so at transparency = 1 the switch was a bare pill
        -- with no handle.
        transparency = 0,
        zindex = 10,
    })
    knob.BackgroundColor3 = Theme.MutedText
    Build.corner(knob, 8)

    local glow = Build.frame(row, {
        name = "Glow",
        size = UDim2.fromOffset(52, 30),
        position = UDim2.new(1, -47, 0.5, 0),
        anchor = Vector2.new(0, 0.5),
        transparency = 1,
        zindex = 6,
    })
    glow.BackgroundColor3 = Theme.Accent
    glow.BackgroundTransparency = 1
    Build.corner(glow, 15)

    -- The hit is the switch itself, not the whole row. Parenting it to `row`
    -- at fromScale(1,1) made the label, the description and the empty space to
    -- the right all trigger the toggle, so it lit up from anywhere in the row.
    -- Parented to the track it follows the control, with a little padding so it
    -- is still a comfortable tap target on touch.
    local hit = Build.hitbox(track, {
        size = UDim2.fromOffset(56, 32),
        position = UDim2.fromScale(0.5, 0.5),
        anchor = Vector2.new(0.5, 0.5),
        zindex = 20,
    })

    local handle = {}
    handle.__container = nil
    handle.row = row
    handle.track = track
    handle.knob = knob
    handle.glow = glow

    local function paint(state, animate)
        local duration = animate == false and 0.01 or 0.26
        if state then
            Anim.tween(track, duration, { BackgroundColor3 = Theme.Accent, BackgroundTransparency = 0.05 }, Anim.Ease.soft)
            Anim.tween(knob, duration, {
                Position = UDim2.fromOffset(23, 3),
                BackgroundColor3 = Theme.Text,
            }, Anim.Ease.spring)
            Anim.tween(trackStroke, duration, { Color = Theme.AccentSoft, Transparency = 0.2 }, Anim.Ease.soft)
        else
            Anim.tween(track, duration, { BackgroundColor3 = Theme.BackgroundTertiary, BackgroundTransparency = 0.35 }, Anim.Ease.soft)
            Anim.tween(knob, duration, {
                Position = UDim2.fromOffset(3, 3),
                BackgroundColor3 = Theme.MutedText,
            }, Anim.Ease.spring)
            Anim.tween(trackStroke, duration, { Color = Theme.Border, Transparency = 0.5 }, Anim.Ease.soft)
        end
    end

    local function setValue(newValue, skipCallback)
        newValue = newValue and true or false
        handle.value = newValue
        State.Flags[handle.flag] = newValue
        paint(newValue)
        if not skipCallback and props.callback then
            task.spawn(props.callback, newValue)
        end
        LIBRARY:queueAutoSave()
    end

    handle.Set = function(_, newValue, skipCallback)
        setValue(newValue, skipCallback)
        return handle
    end
    handle.__apply = function(v) setValue(v == true, true) end

    table.insert(State.Connections, hit.MouseButton1Click:Connect(function()
        if handle.locked then return end
        setValue(not handle.value)
    end))

    table.insert(State.Connections, hit.MouseEnter:Connect(function()
        Anim.tween(track, 0.16, { BackgroundTransparency = handle.value and 0 or 0.24 }, Anim.Ease.gentle)
        Anim.tween(glow, 0.2, { BackgroundTransparency = 1 - 0.20 * (0.3 + Theme.GlowIntensity * 0.7) }, Anim.Ease.gentle)
        Anim.tween(label, 0.16, { TextColor3 = Theme.Text }, Anim.Ease.gentle)
    end))

    table.insert(State.Connections, hit.MouseLeave:Connect(function()
        Anim.tween(track, 0.2, { BackgroundTransparency = handle.value and 0.05 or 0.35 }, Anim.Ease.gentle)
        Anim.tween(glow, 0.24, { BackgroundTransparency = 1 }, Anim.Ease.gentle)
    end))

    applyLockable(handle, row, { track, knob })

    paint(value, false)

    registerElement(self, handle, props, "toggle")
    return handle
end

function Section:CreateSwitch(props)
    return self:CreateToggle(props)
end

