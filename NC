-- ═══════════════════════════════════════════════════════════════════════════
--  SLIDER
-- ═══════════════════════════════════════════════════════════════════════════

local function snapToStep(value, minimum, maximum, step)
    if step and step > 0 then
        local steps = math.floor(((value - minimum) / step) + 0.5)
        value = minimum + (steps * step)
    end
    value = math.clamp(value, minimum, maximum)
    -- Trim float drift (0.30000000000000004 → 0.3)
    if step and step > 0 then
        local decimals = 0
        local probe = step
        while probe ~= math.floor(probe) and decimals < 6 do
            probe = probe * 10
            decimals = decimals + 1
        end
        local mult = 10 ^ decimals
        value = math.floor(value * mult + 0.5) / mult
    end
    return value
end

local function formatNumber(value, suffix)
    local text
    if value == math.floor(value) then
        text = tostring(math.floor(value))
    else
        text = string.format("%.2f", value)
        text = text:gsub("0+$", ""):gsub("%.$", "")
    end
    if suffix and suffix ~= "" then
        text = text .. suffix
    end
    return text
end

local function formatSliderValue(value, isPercentage, suffix)
    if isPercentage then
        return formatNumber(value * 100, "%")
    end
    return formatNumber(value, suffix)
end

function Section:CreateSlider(props)
    props = props or {}

    local minimum = props.min or props.Min or props.minimum or props.Minimum or 0
    local maximum = props.max or props.Max or props.maximum or props.Maximum or 100
    local step = props.step or props.Step or 1
    local value = props.value or props.Value or props.default or props.Default or minimum
    value = snapToStep(value, minimum, maximum, step)
    if props.flag and State.Flags[props.flag] ~= nil then
        value = snapToStep(State.Flags[props.flag], minimum, maximum, step)
    end

    local suffix = props.suffix or props.Suffix or ""
    local isPercentage = props.percentage or props.Percentage

    local row, label = createRow(self, props, { height = props.description and 62 or 54, rightPad = 8 })

    local valueBox = Build.text(row, {
        name = "Value",
        text = formatSliderValue(value, isPercentage, suffix),
        size = UDim2.fromOffset(56, 18),
        position = UDim2.new(1, -56, 0, 2),
        font = Enum.Font.GothamMedium,
        textSize = 12,
        color = Theme.AccentSoft,
        align = Enum.TextXAlignment.Right,
        zindex = 8,
    })

    local trackHeight = 4
    local track = Build.frame(row, {
        name = "Track",
        size = UDim2.new(1, 0, 0, trackHeight),
        -- Keep the track below the label so the knob never covers the text.
        position = UDim2.new(0, 0, 0, props.description and 44 or 32),
        transparency = 1,
        zindex = 7,
    })
    track.BackgroundColor3 = Theme.BackgroundTertiary
    track.BackgroundTransparency = 0.25
    Build.corner(track, trackHeight / 2)

    local fill = Build.frame(track, {
        name = "Fill",
        size = UDim2.fromScale(0, 1),
        transparency = 1,
        zindex = 8,
    })
    fill.BackgroundColor3 = Theme.Accent
    fill.BackgroundTransparency = 0.02
    Build.corner(fill, trackHeight / 2)
    local fillGradient = Build.gradient(fill, { Theme.Accent, Theme.AccentSecondary }, Theme.GradientAngle)

    local knob = Build.frame(track, {
        name = "Knob",
        size = UDim2.fromOffset(12, 12),
        position = UDim2.new(0, 0, 0.5, 0),
        anchor = Vector2.new(0.5, 0.5),
        transparency = 0,
        zindex = 11,
    })
    knob.BackgroundColor3 = Theme.Text
    Build.corner(knob, 6)
    local knobStroke = Build.stroke(knob, Theme.AccentSoft, 2, 0.05)

    local knobGlow = Build.frame(track, {
        name = "KnobGlow",
        size = UDim2.fromOffset(26, 26),
        position = UDim2.new(0, 0, 0.5, 0),
        anchor = Vector2.new(0.5, 0.5),
        transparency = 1,
        zindex = 9,
    })
    knobGlow.BackgroundColor3 = Theme.Accent
    knobGlow.BackgroundTransparency = 1
    Build.corner(knobGlow, 13)

    -- Grab strip over the track only, not the whole row. The old row-wide
    -- hitbox meant pressing the label or the value readout started a drag.
    local hit = Build.hitbox(track, {
        size = UDim2.new(1, 0, 0, 24),
        position = UDim2.new(0, 0, 0.5, 0),
        anchor = Vector2.new(0, 0.5),
        zindex = 20,
    })
    hit.Active = true

    local handle = {}
    handle.row = row
    handle.track = track
    handle.fill = fill
    handle.knob = knob
    handle.min = minimum
    handle.max = maximum
    handle.step = step
    handle.value = value

    local function ratio()
        if maximum == minimum then return 0 end
        return math.clamp((handle.value - minimum) / (maximum - minimum), 0, 1)
    end

    local function paint(animate, skipCallback)
        local r = ratio()
        local duration = animate == false and 0.01 or 0.14
        Anim.tween(fill, duration, { Size = UDim2.fromScale(r, 1) }, Anim.Ease.out, Anim.Dir.out)
        Anim.tween(knob, duration, { Position = UDim2.new(r, 0, 0.5, 0) }, Anim.Ease.out, Anim.Dir.out)
        Anim.tween(knobGlow, duration, { Position = UDim2.new(r, 0, 0.5, 0) }, Anim.Ease.out, Anim.Dir.out)
        valueBox.Text = formatSliderValue(handle.value, isPercentage, suffix)
        if not skipCallback and props.callback then
            task.spawn(props.callback, handle.value)
        end
    end

    local function setValue(newValue, skipCallback, animate)
        newValue = snapToStep(newValue, minimum, maximum, step)
        if newValue == handle.value and animate ~= false then return newValue end
        handle.value = newValue
        State.Flags[handle.flag] = newValue
        paint(animate, skipCallback)
        if not skipCallback then LIBRARY:queueAutoSave() end
        return newValue
    end

    handle.Set = function(self, newValue, skipCallback)
        return setValue(newValue, skipCallback, true)
    end
    handle.__apply = function(newValue)
        setValue(newValue, true, false)
        paint(false, true)
    end

    -- Dragging ------------------------------------------------------------
    local dragging = false

    --[[
        Track geometry, frozen for the duration of one drag.

        pointerToValue used to read AbsolutePosition / AbsoluteSize live on every
        sample. That is fine until the control's own container resizes mid-drag
        -- which is exactly what the UI scale slider does, because the settings
        panel lives inside the scale container. Each sample then re-mapped the
        pointer against a different origin and width, so the value jittered and
        snapped instead of tracking the cursor.
    ]]
    local dragOriginX, dragWidth

    local function pointerToValue(x)
        local originX = dragOriginX or track.AbsolutePosition.X
        local width = dragWidth or track.AbsoluteSize.X
        if width <= 0 then return handle.value end
        local r = math.clamp((x - originX) / width, 0, 1)
        return minimum + (r * (maximum - minimum))
    end

    local inputChanged, inputEnded

    local function endDrag()
        if not dragging then return end
        dragging = false
        dragOriginX, dragWidth = nil, nil
        Anim.tween(knob, 0.22, { Size = UDim2.fromOffset(12, 12) }, Anim.Ease.spring)
        Anim.tween(knobGlow, 0.22, { BackgroundTransparency = 1 }, Anim.Ease.soft)
        if inputChanged then inputChanged:Disconnect() end
        if inputEnded then inputEnded:Disconnect() end
        inputChanged, inputEnded = nil, nil
    end

    hit.Active = true
    hit.InputBegan:Connect(function(input)
        if handle.locked then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end

        dragging = true
        -- Freeze the geometry before the first value is derived from it.
        dragOriginX = track.AbsolutePosition.X
        dragWidth = track.AbsoluteSize.X
        Anim.tween(knob, 0.18, { Size = UDim2.fromOffset(15, 15) }, Anim.Ease.spring)
        Anim.tween(knobGlow, 0.18, { BackgroundTransparency = 0.78 }, Anim.Ease.soft)
        setValue(pointerToValue(input.Position.X), false, true)

        inputChanged = UserInputService.InputChanged:Connect(function(moved)
            if not dragging then return end
            if moved.UserInputType == Enum.UserInputType.MouseMovement
                or moved.UserInputType == Enum.UserInputType.Touch then
                setValue(pointerToValue(moved.Position.X), false, true)
            end
        end)
        inputEnded = UserInputService.InputEnded:Connect(function(ended)
            if ended.UserInputType == Enum.UserInputType.MouseButton1
                or ended.UserInputType == Enum.UserInputType.Touch then
                endDrag()
            end
        end)
    end)

    -- Keyboard nudge -------------------------------------------------------
    table.insert(State.Connections, hit.MouseEnter:Connect(function()
        if handle.locked then return end
        Anim.tween(knobGlow, 0.2, { BackgroundTransparency = 0.86 }, Anim.Ease.soft)
    end))
    table.insert(State.Connections, hit.MouseLeave:Connect(function()
        if dragging then return end
        Anim.tween(knobGlow, 0.2, { BackgroundTransparency = 1 }, Anim.Ease.soft)
    end))

    applyLockable(handle, row, { knob, fill })
    registerElement(self, handle, props, "slider")

    handle.__setRange = function(newMin, newMax)
        minimum, maximum = newMin, newMax
        handle.min, handle.max = newMin, newMax
        paint(false, true)
    end
    handle.__refreshTheme = function()
        fill.BackgroundColor3 = Theme.Accent
        fillGradient.Color = ColorSequence.new(Theme.Accent, Theme.AccentSecondary)
        knobStroke.Color = Theme.AccentSoft
        knobGlow.BackgroundColor3 = Theme.Accent
        valueBox.TextColor3 = Theme.AccentSoft
    end

    paint(false, true)
    return handle
end

-- ═══════════════════════════════════════════════════════════════════════════
--  DROPDOWN  (single + multi select)
-- ═══════════════════════════════════════════════════════════════════════════

local DROPDOWN_OPTION_HEIGHT = 30
local DROPDOWN_MAX_VISIBLE = 6

local function optionsFrom(list)
    local out = {}
    if type(list) ~= "table" then return out end
    for _, entry in ipairs(list) do
        if type(entry) == "table" then
            table.insert(out, {
                label = tostring(entry.label or entry.name or entry.value or ""),
                value = entry.value ~= nil and entry.value or entry.label or entry.name,
                description = entry.description or entry.Description,
                icon = entry.icon or entry.Icon,
            })
        else
            table.insert(out, { label = tostring(entry), value = entry })
        end
    end
    return out
end

-- Dropdown("Select Players", { "P1", "P2" }, { Multi = true, Default = {}, Callback = fn })
function Section:Dropdown(titleOrProps, options, config)
    local props
    if type(titleOrProps) == "table" then
        props = titleOrProps
        options = props.options or props.Options or options
        config = props.config or props.Config or config
    else
        props = {}
        props.name = titleOrProps
        props.options = options
    end
    config = config or {}
    props.callback = config.Callback or config.callback or props.callback
    if config.Multi ~= nil then
        props.multi = config.Multi
    elseif config.multi ~= nil then
        props.multi = config.multi
    elseif props.multi == nil then
        props.multi = props.multiple or props.Multiple or props.allowMultiple or props.AllowMultiple
    end
    props.default = config.Default or config.default or props.default
    if config.Flag then props.flag = config.Flag end
    props.description = props.description or config.Description
    return self:CreateDropdown(props)
end

function Section:CreateDropdown(props)
    props = props or {}
    local multi = props.multi
    if multi == nil then multi = props.Multi end
    if multi == nil then multi = props.multiple or props.Multiple or props.allowMultiple or props.AllowMultiple end
    multi = multi == true
    local choices = optionsFrom(props.options or props.Options or {})
    local searchable = props.searchable
    if searchable == nil then searchable = props.Searchable end
    if searchable == nil then searchable = multi and false or (#choices > 7) end

    local placeholder = props.placeholder or props.Placeholder or "Select..."

    -- Resolve the starting selection.
    local selected = {}
    local singleValue

    if multi then
        local default = props.default or props.Default
        if props.flag and State.Flags[props.flag] ~= nil then
            default = State.Flags[props.flag]
        end
        if type(default) == "table" then
            for _, wanted in ipairs(default) do
                for _, choice in ipairs(choices) do
                    if choice.value == wanted or choice.label == wanted then
                        selected[choice.value] = true
                    end
                end
            end
        end
    else
        local default = props.default or props.Default
        if props.flag and State.Flags[props.flag] ~= nil then
            default = State.Flags[props.flag]
        end
        if default ~= nil then
            for _, choice in ipairs(choices) do
                if choice.value == default or choice.label == default then
                    singleValue = choice.value
                end
            end
        end
    end

    local row, label = createRow(self, props, { rightPad = 0, height = props.description and 46 or ROW_HEIGHT + 4 })
    row.Size = UDim2.new(1, 0, 0, props.description and 46 or ROW_HEIGHT + 4)

    -- ── The closed "field" ────────────────────────────────────────────────
    local fieldWidth = props.width or props.Width or 150
    local field = Build.button(row, {
        name = "Field",
        size = UDim2.fromOffset(fieldWidth, 28),
        position = UDim2.new(1, -fieldWidth, 0, props.description and 16 or 3),
        transparency = 1,
        zindex = 10,
    })
    field.BackgroundColor3 = Theme.BackgroundTertiary
    field.BackgroundTransparency = 0.2
    field.Active = true
    field.ClipsDescendants = true
    Build.corner(field, 7)
    local fieldStroke = Build.stroke(field, Theme.Border, 1, 0.45)

    local fieldText = Build.text(field, {
        name = "FieldText",
        text = placeholder,
        size = UDim2.new(1, -42, 1, 0),
        position = UDim2.new(0, 11, 0, 0),
        font = Enum.Font.GothamMedium,
        textSize = 12,
        color = Theme.MutedText,
        align = Enum.TextXAlignment.Left,
        zindex = 11,
        truncate = Enum.TextTruncate.AtEnd,
    })

    local chevronHolder = Build.frame(field, {
        name = "Chevron",
        size = UDim2.fromOffset(14, 14),
        position = UDim2.new(1, -22, 0.5, 0),
        anchor = Vector2.new(0, 0.5),
        transparency = 1,
        zindex = 11,
    })
    chevronHolder.BackgroundTransparency = 1
    local chevron = Glyph.new(chevronHolder, "chevron", 13, Theme.SubText, 0.25, 1.8, false)

    local badge = Build.text(field, {
        name = "Badge",
        text = "",
        size = UDim2.fromOffset(24, 16),
        position = UDim2.new(1, -46, 0.5, 0),
        anchor = Vector2.new(1, 0.5),
        font = Enum.Font.GothamBold,
        textSize = 11,
        color = Theme.AccentSoft,
        align = Enum.TextXAlignment.Right,
        zindex = 11,
        visible = false,
    })

    -- ── The popup panel ───────────────────────────────────────────────────
    -- Parented into the window's overlay so it is never clipped by the
    -- scrolling content frame.
    local overlay = self.tab.window.overlay
    local panel = Build.frame(overlay, {
        name = "Dropdown_" .. (props.name or "menu"),
        size = UDim2.fromOffset(fieldWidth + 40, 0),
        transparency = 1,
        zindex = 500,
        visible = false,
    })
    panel.BackgroundColor3 = Theme.BackgroundSecondary
    panel.BackgroundTransparency = 0.02
    panel.ClipsDescendants = true
    Build.corner(panel, 9)
    local panelStroke = Build.stroke(panel, Theme.AccentSoft, 1, 0.55)
    panel.AnchorPoint = Vector2.new(1, 0)

    -- Do not put a UIListLayout directly on the popup. The popup contains
    -- separately-positioned search/scroll layers; laying those children out
    -- together makes the dropdown overlap and prevents option clicks.
    local panelPad = Instance.new("UIPadding")
    panelPad.PaddingTop = UDim.new(0, 6)
    panelPad.PaddingBottom = UDim.new(0, 6)
    panelPad.PaddingLeft = UDim.new(0, 6)
    panelPad.PaddingRight = UDim.new(0, 6)
    panelPad.Parent = panel

    local searchBox
    if searchable then
        searchBox = Build.button(panel, {
            name = "Search",
            size = UDim2.new(1, 0, 0, 28),
            transparency = 1,
            zindex = 510,
        })
        searchBox.BackgroundColor3 = Theme.BackgroundTertiary
        searchBox.BackgroundTransparency = 0.3
        Build.corner(searchBox, 6)
    local searchInput = Instance.new("TextBox")
    -- Named so the rest of the dropdown can reach it as searchBox.Search.
    -- Four later reads (focus, text filtering, changed-signal) go through
    -- searchBox.Search, which did not exist and indexed nil.
    searchInput.Name = "Search"
    searchInput.BackgroundTransparency = 1
        searchInput.Size = UDim2.new(1, -18, 1, 0)
        searchInput.Position = UDim2.fromOffset(10, 0)
        searchInput.Font = Enum.Font.Gotham
        searchInput.TextSize = 11
        searchInput.PlaceholderText = "Search..."
        searchInput.PlaceholderColor3 = Theme.MutedText
        searchInput.TextColor3 = Theme.Text
        searchInput.Text = ""
        searchInput.ClearTextOnFocus = false
        searchInput.TextXAlignment = Enum.TextXAlignment.Left
        searchInput.ZIndex = 511
        searchInput.Parent = searchBox
    end

    local scroller = Instance.new("ScrollingFrame")
    scroller.BackgroundTransparency = 1
    scroller.BorderSizePixel = 0
    scroller.Size = UDim2.new(1, 0, 0, 0)
    scroller.CanvasSize = UDim2.new(0, 0, 0, 0)
    scroller.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroller.ScrollBarThickness = 5
    scroller.ScrollBarImageColor3 = Theme.Accent
    scroller.ScrollBarImageTransparency = 0.15
    scroller.ScrollingEnabled = true
    scroller.Active = true
    scroller.ZIndex = 505
    scroller.Parent = panel

    -- The options themselves need their own vertical layout. Without this,
    -- every option is created at (0, 0) and they render on top of each other.
    local optionLayout = Instance.new("UIListLayout")
    optionLayout.FillDirection = Enum.FillDirection.Vertical
    optionLayout.SortOrder = Enum.SortOrder.LayoutOrder
    optionLayout.Padding = UDim.new(0, 1)
    optionLayout.Parent = scroller

    local scrollHint = Build.frame(panel, {
        name = "ScrollHint",
        size = UDim2.fromOffset(20, 12),
        position = UDim2.new(0.5, 0, 1, -2),
        anchor = Vector2.new(0.5, 1),
        transparency = 1,
        zindex = 520,
        visible = false,
    })
    scrollHint.BackgroundTransparency = 1
    Glyph.new(scrollHint, "chevron", 12, Theme.AccentSoft, 0.15, 1.6, false)

    local optionButtons = {}

    -- Per-option state, keyed by the button instance.
    --
    -- This used to live on the button itself (option.__label = ..., etc), but
    -- Roblox Instances reject arbitrary property assignment, so every one of
    -- those lines threw "<field> is not a valid member of TextButton". A side
    -- table keeps the same shape without touching the instance -- and it can
    -- hold Instances and tables, which attributes cannot.
    local optionData = {}

    local function refreshFieldText()
        if multi then
            local picked = {}
            for _, choice in ipairs(choices) do
                if selected[choice.value] then
                    table.insert(picked, choice.label)
                end
            end
            if #picked == 0 then
                fieldText.Text = placeholder
                fieldText.TextColor3 = Theme.MutedText
                badge.Visible = false
            elseif #picked == 1 then
                fieldText.Text = picked[1]
                fieldText.TextColor3 = Theme.Text
                badge.Text = "1"
                badge.Visible = true
            elseif #picked == 2 then
                fieldText.Text = picked[1] .. " +1"
                fieldText.TextColor3 = Theme.Text
                badge.Text = "2"
                badge.Visible = true
            else
                fieldText.Text = "Various"
                fieldText.TextColor3 = Theme.Text
                badge.Text = tostring(#picked)
                badge.Visible = true
            end
        else
            if singleValue == nil then
                fieldText.Text = placeholder
                fieldText.TextColor3 = Theme.MutedText
            else
                -- Fall back to the raw value when it is not in the list. The old
                -- loop simply matched nothing and left the previous text in
                -- place, so a deleted config stayed visible on the field.
                local found
                for _, choice in ipairs(choices) do
                    if choice.value == singleValue then
                        found = choice.label
                    end
                end
                fieldText.Text = found or tostring(singleValue)
                fieldText.TextColor3 = Theme.Text
            end
            badge.Visible = false
        end
    end

    local function currentSelection()
        if multi then
            local out = {}
            for _, choice in ipairs(choices) do
                if selected[choice.value] then table.insert(out, choice.value) end
            end
            return out
        end
        return singleValue
    end

    -- Declare the handle before the option callbacks are created. Lua closures
    -- otherwise capture a global `handle` (nil), causing the dropdown click
    -- error: "attempt to index nil with 'locked'".
    local handle = {}

    local function fireCallback()
        local value = currentSelection()
        State.Flags[handle.flag] = multi and value or value
        if props.callback then task.spawn(props.callback, value) end
    end

    local paintOption
    local function buildOptions(filter)
        for _, button in ipairs(optionButtons) do
            button:Destroy()
        end
        optionButtons = {}
        optionData = {}

        filter = (filter or ""):lower()
        local visibleCount = 0
        local shown = {}

        for _, choice in ipairs(choices) do
            local matches = filter == ""
                or choice.label:lower():find(filter, 1, true) ~= nil
                or (choice.description and choice.description:lower():find(filter, 1, true) ~= nil)

            if matches then
                shown[choice.value] = true
                visibleCount = visibleCount + 1

                local option = Build.button(scroller, {
                    name = "Option_" .. choice.label,
                    size = UDim2.new(1, 0, 0, DROPDOWN_OPTION_HEIGHT),
                    transparency = 1,
                    zindex = 506,
                })
                option.BackgroundColor3 = Theme.Accent
                option.BackgroundTransparency = 1
                option.Active = true
                Build.corner(option, 6)

                local optionLabel = Build.text(option, {
                    name = "OptionLabel",
                    text = choice.label,
                    size = UDim2.new(1, -34, 1, 0),
                    position = UDim2.fromOffset(10, 0),
                    font = Enum.Font.GothamMedium,
                    textSize = 12,
                    color = Theme.SubText,
                    align = Enum.TextXAlignment.Left,
                    zindex = 507,
                    truncate = Enum.TextTruncate.AtEnd,
                })

                local tick = Build.frame(option, {
                    name = "Tick",
                    size = UDim2.fromOffset(14, 14),
                    position = UDim2.new(1, -21, 0.5, 0),
                    anchor = Vector2.new(0, 0.5),
                    transparency = 1,
                    zindex = 508,
                })
                tick.BackgroundTransparency = 1
                local tickGlyph = Glyph.new(tick, "check", 12, Theme.Text, 1, 2, false)

                table.insert(optionButtons, option)

                local function isPicked()
                    if multi then return selected[choice.value] == true end
                    return singleValue == choice.value
                end

                paintOption = paintOption or function(btn)
                    local data = optionData[btn]
                    -- The "No matches" label and the clear button share this
                    -- list but have no entry, so they are skipped.
                    if not data then return end
                    local picked = data.isPicked and data.isPicked() or false
                    local hovered = data.hovered
                    if picked then
                        Anim.tween(btn, 0.18, { BackgroundTransparency = 0.86 }, Anim.Ease.soft)
                        data.label.TextColor3 = Theme.Text
                        data.tick.BackgroundTransparency = 1
                        Glyph.setTransparency(data.tick, 0)
                    elseif hovered then
                        Anim.tween(btn, 0.16, { BackgroundTransparency = 0.94 }, Anim.Ease.soft)
                        data.label.TextColor3 = Theme.Text
                        Glyph.setTransparency(data.tick, 1)
                    else
                        Anim.tween(btn, 0.16, { BackgroundTransparency = 1 }, Anim.Ease.soft)
                        data.label.TextColor3 = Theme.SubText
                        Glyph.setTransparency(data.tick, 1)
                    end
                end

                optionData[option] = {
                    isPicked = isPicked,
                    hovered = false,
                    label = optionLabel,
                    tick = tick,
                    choice = choice,
                }

                option.MouseEnter:Connect(function()
                    local data = optionData[option]
                    if data then data.hovered = true end
                    paintOption(option)
                end)
                option.MouseLeave:Connect(function()
                    local data = optionData[option]
                    if data then data.hovered = false end
                    paintOption(option)
                end)

                option.MouseButton1Click:Connect(function()
                    if handle.locked then return end
                    if multi then
                        selected[choice.value] = not selected[choice.value] or nil
                        refreshFieldText()
                        fireCallback()
                        -- Multi-select deliberately stays open.
                    else
                        singleValue = choice.value
                        refreshFieldText()
                        fireCallback()
                        handle:closePanel()
                    end
                    for _, btn in ipairs(optionButtons) do
                        paintOption(btn)
                    end
                    LIBRARY:queueAutoSave()
                end)

                paintOption(option)
            end
        end

        if visibleCount == 0 then
            local empty = Build.text(scroller, {
                name = "Empty",
                text = "No matches",
                size = UDim2.new(1, 0, 0, 28),
                font = Enum.Font.Gotham,
                textSize = 11,
                color = Theme.MutedText,
                zindex = 506,
            })
            table.insert(optionButtons, empty)
        end

        local listHeight = math.min(visibleCount == 0 and 1 or visibleCount, DROPDOWN_MAX_VISIBLE) * (DROPDOWN_OPTION_HEIGHT + 1)
        local totalHeight = listHeight + 12 + (searchBox and 32 or 0)
        scroller.Size = UDim2.new(1, 0, 0, listHeight)
        scroller.Position = UDim2.fromOffset(0, searchBox and 32 or 0)
        scrollHint.Visible = visibleCount > DROPDOWN_MAX_VISIBLE
        return totalHeight
    end

    handle.row = row
    handle.field = field
    handle.value = multi and currentSelection() or singleValue
    handle.options = choices
    handle.__container = nil

    local isOpen = false
    local outsideConnection

    -- Replace the option list in place. Assigning handle.options directly was
    -- not enough: `choices` is captured when the dropdown is built, so both the
    -- panel and the field text kept showing the old list. The config picker
    -- needs this, since its contents change whenever a config is saved.
    function handle:Refresh(newOptions, keepSelection)
        if newOptions then
            choices = optionsFrom(newOptions)
            handle.options = choices
        end
        if not keepSelection then
            selected = {}
            singleValue = nil
        end
        refreshFieldText()
        if isOpen then
            buildOptions(searchBox and searchBox.Search and searchBox.Search.Text or "")
        end
    end

    function handle:closePanel()
        if not isOpen then return end
        isOpen = false
        if outsideConnection then
            outsideConnection:Disconnect()
            outsideConnection = nil
        end
        Anim.tween(chevronHolder, 0.2, { Rotation = 0 }, Anim.Ease.soft)
        Anim.tween(panel, 0.18, {
            Size = UDim2.fromOffset(panel.AbsoluteSize.X, 0),
            BackgroundTransparency = 1,
        }, Anim.Ease.soft, Anim.Dir.inward)
        task.delay(0.2, function()
            if not isOpen and panel then panel.Visible = false end
        end)
        Anim.tween(field, 0.2, { BackgroundTransparency = 0.2 }, Anim.Ease.soft)
        Anim.tween(fieldStroke, 0.2, { Color = Theme.Border, Transparency = 0.45 }, Anim.Ease.soft)
    end

    function handle:openPanel()
        if isOpen or handle.locked then return end
        isOpen = true

        local totalHeight = buildOptions(searchBox and searchBox.Search.Text or "")
        local anchorPos = field.AbsolutePosition
        local anchorSize = field.AbsoluteSize

        -- The panel lives in the overlay, so its Position is overlay-relative
        -- while AbsolutePosition is screen-space. Subtracting the overlay's own
        -- origin is required; without it the popup rendered offset by wherever
        -- the window happened to sit on screen.
        local origin = overlay.AbsolutePosition
        panel.Position = UDim2.fromOffset(
            math.floor(anchorPos.X + anchorSize.X - origin.X),
            math.floor(anchorPos.Y + anchorSize.Y + 6 - origin.Y)
        )
        panel.Size = UDim2.fromOffset(fieldWidth + 40, 0)
        panel.Visible = true

        Anim.tween(chevronHolder, 0.24, { Rotation = 180 }, Anim.Ease.spring)
        Anim.tween(panel, 0.26, {
            Size = UDim2.fromOffset(fieldWidth + 40, totalHeight),
            BackgroundTransparency = 0.02,
        }, Anim.Ease.out, Anim.Dir.out)
        Anim.tween(field, 0.2, { BackgroundTransparency = 0.05 }, Anim.Ease.soft)
        Anim.tween(fieldStroke, 0.2, { Color = Theme.AccentSoft, Transparency = 0.2 }, Anim.Ease.soft)

        if searchBox then
            searchBox.Search:CaptureFocus()
        end

        outsideConnection = UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1
                and input.UserInputType ~= Enum.UserInputType.Touch then return end
            local pos = input.Position
            local inField = pos.X >= field.AbsolutePosition.X and pos.X <= field.AbsolutePosition.X + field.AbsoluteSize.X
                and pos.Y >= field.AbsolutePosition.Y and pos.Y <= field.AbsolutePosition.Y + field.AbsoluteSize.Y
            local inPanel = pos.X >= panel.AbsolutePosition.X and pos.X <= panel.AbsolutePosition.X + panel.AbsoluteSize.X
                and pos.Y >= panel.AbsolutePosition.Y and pos.Y <= panel.AbsolutePosition.Y + panel.AbsoluteSize.Y
            if not inField and not inPanel then
                handle:closePanel()
            end
        end)
        table.insert(State.Connections, outsideConnection)

        if searchable and searchBox then
            searchBox.Search:GetPropertyChangedSignal("Text"):Connect(function()
                if not isOpen then return end
                buildOptions(searchBox.Search.Text)
            end)
        end
    end

    function handle:togglePanel()
        if isOpen then handle:closePanel() else handle:openPanel() end
    end

    function handle:Set(newValue, skipCallback)
        if multi then
            selected = {}
            if type(newValue) == "table" then
                for _, wanted in ipairs(newValue) do
                    for _, choice in ipairs(choices) do
                        if choice.value == wanted or choice.label == wanted then
                            selected[choice.value] = true
                        end
                    end
                end
            end
            handle.value = currentSelection()
        else
            singleValue = newValue
            handle.value = newValue
        end
        refreshFieldText()
        State.Flags[handle.flag] = handle.value
        if not skipCallback and props.callback then
            task.spawn(props.callback, handle.value)
        end
        if not skipCallback then LIBRARY:queueAutoSave() end
        return handle.value
    end

    handle.__apply = function(newValue)
        handle:Set(newValue, true)
    end

    function handle:Get()
        return handle.value
    end

    function handle:Clear(skipCallback)
        if multi then
            selected = {}
            handle.value = currentSelection()
        else
            singleValue = nil
            handle.value = nil
        end
        refreshFieldText()
        State.Flags[handle.flag] = handle.value
        if not skipCallback and props.callback then
            task.spawn(props.callback, handle.value)
        end
        if not skipCallback then LIBRARY:queueAutoSave() end
    end

    -- "Clear selection" row, only meaningful for multi-select.
    local clearButton
    if multi and props.clearable ~= false then
        clearButton = Build.button(panel, {
            name = "ClearSelection",
            size = UDim2.new(1, 0, 0, 24),
            transparency = 1,
            zindex = 512,
        })
        clearButton.BackgroundColor3 = Theme.Error
        clearButton.BackgroundTransparency = 1
        Build.corner(clearButton, 6)
        clearButton.Position = UDim2.new(0, 6, 1, -30)
        table.insert(optionButtons, clearButton)

        local clearText = Build.text(clearButton, {
            name = "ClearLabel",
            text = "Clear selection",
            size = UDim2.new(1, 0, 1, 0),
            font = Enum.Font.GothamMedium,
            textSize = 11,
            color = Theme.MutedText,
            zindex = 513,
        })
        clearButton.MouseEnter:Connect(function()
            Anim.tween(clearButton, 0.16, { BackgroundTransparency = 0.9 }, Anim.Ease.soft)
            clearText.TextColor3 = Theme.Error
        end)
        clearButton.MouseLeave:Connect(function()
            Anim.tween(clearButton, 0.16, { BackgroundTransparency = 1 }, Anim.Ease.soft)
            clearText.TextColor3 = Theme.MutedText
        end)
        clearButton.MouseButton1Click:Connect(function()
            handle:Clear()
        end)
    end

    field.MouseEnter:Connect(function()
        if isOpen then return end
        Anim.tween(field, 0.18, { BackgroundTransparency = 0.08 }, Anim.Ease.soft)
        Anim.tween(fieldStroke, 0.18, { Transparency = 0.25 }, Anim.Ease.soft)
    end)
    field.MouseLeave:Connect(function()
        if isOpen then return end
        Anim.tween(field, 0.18, { BackgroundTransparency = 0.2 }, Anim.Ease.soft)
        Anim.tween(fieldStroke, 0.18, { Transparency = 0.45 }, Anim.Ease.soft)
    end)
    field.MouseButton1Click:Connect(function()
        handle:togglePanel()
    end)

    refreshFieldText()
    applyLockable(handle, row, { field })
    registerElement(self, handle, props, multi and "multi" or "dropdown")
    handle.value = currentSelection()
    State.Flags[handle.flag] = handle.value

    handle.__refreshTheme = function()
        panel.BackgroundColor3 = Theme.BackgroundSecondary
        panelStroke.Color = Theme.AccentSoft
        field.BackgroundColor3 = Theme.BackgroundTertiary
        fieldStroke.Color = isOpen and Theme.AccentSoft or Theme.Border
        chevron:SetAttribute("BaseColor", Theme.SubText)
        for _, btn in ipairs(optionButtons) do
            if optionData[btn] then
                btn.BackgroundColor3 = Theme.Accent
            end
        end
    end

    -- Dropdowns must be closed and repositioned whenever the page moves.
    table.insert(State.LayoutListeners, function()
        if isOpen then
            local anchorPos = field.AbsolutePosition
            local anchorSize = field.AbsoluteSize
            local origin = overlay.AbsolutePosition
            panel.Position = UDim2.fromOffset(
                math.floor(anchorPos.X + anchorSize.X - origin.X),
                math.floor(anchorPos.Y + anchorSize.Y + 6 - origin.Y)
            )
        end
    end)

    return handle
end

-- Aliases that read naturally in feature code.
function Section:CreateMultiDropdown(props)
    props = props or {}
    props.multi = true
    return self:CreateDropdown(props)
end

function Section:CreateDropdownMulti(props)
    return self:CreateMultiDropdown(props)
end

-- ═══════════════════════════════════════════════════════════════════════════
--  INPUT
-- ═══════════════════════════════════════════════════════════════════════════

function Section:CreateInput(props)
    props = props or {}
    local multiline = props.multiline or props.Multiline or false
    local value = props.value or props.Value or props.default or props.Default or ""
    if props.flag and State.Flags[props.flag] ~= nil then
        value = State.Flags[props.flag]
    end

    local fieldWidth = props.width or props.Width or 150
    local clearable = props.clearable
    if clearable == nil then clearable = props.Clearable end

    local row, label = createRow(self, props, { height = props.description and 46 or ROW_HEIGHT + 4 })
    row.Size = UDim2.new(1, 0, 0, props.description and 46 or ROW_HEIGHT + 4)

    local field = Build.frame(row, {
        name = "Field",
        size = UDim2.fromOffset(fieldWidth, 28),
        position = UDim2.new(1, -fieldWidth, 0, props.description and 16 or 3),
        transparency = 1,
        zindex = 10,
    })
    field.BackgroundColor3 = Theme.BackgroundTertiary
    field.BackgroundTransparency = 0.2
    -- TextBoxes can render long strings outside their nominal bounds.
    field.ClipsDescendants = true
    Build.corner(field, 7)
    local fieldStroke = Build.stroke(field, Theme.Border, 1, 0.45)

    local paddingRight = clearable and 26 or 10

    local textBox = Instance.new("TextBox")
    textBox.Name = "Input"
    textBox.BackgroundTransparency = 1
    textBox.Size = UDim2.new(1, -(paddingRight + 10), 1, 0)
    textBox.Position = UDim2.fromOffset(10, 0)
    textBox.Font = Enum.Font.Gotham
    textBox.TextSize = 12
    textBox.TextColor3 = Theme.Text
    textBox.PlaceholderText = props.placeholder or props.Placeholder or "Type here..."
    textBox.PlaceholderColor3 = Theme.MutedText
    textBox.Text = tostring(value)
    textBox.ClearTextOnFocus = false
    textBox.TextXAlignment = Enum.TextXAlignment.Left
    textBox.TextYAlignment = Enum.TextYAlignment.Center
    textBox.MultiLine = multiline
    textBox.TextWrapped = multiline
    textBox.ZIndex = 11
    textBox.Parent = field

    local clearButton
    local clearGlyph
    if clearable then
        clearButton = Build.button(field, {
            name = "ClearButton",
            size = UDim2.fromOffset(16, 16),
            position = UDim2.new(1, -20, 0.5, 0),
            anchor = Vector2.new(0, 0.5),
            transparency = 1,
            zindex = 12,
            visible = false,
        })
        clearButton.BackgroundTransparency = 1
        clearButton.BackgroundColor3 = Theme.MutedText
        clearButton.AutoButtonColor = false
        clearGlyph = Glyph.new(clearButton, "close", 11, Theme.MutedText, 0.3, 1.6, false)

        clearButton.MouseEnter:Connect(function()
            Glyph.setColor(clearGlyph, Theme.Error)
        end)
        clearButton.MouseLeave:Connect(function()
            Glyph.setColor(clearGlyph, Theme.MutedText)
        end)
    end

    local handle = {}
    handle.value = textBox.Text
    handle.input = textBox

    local focused = false

    local function setFocused(state)
        focused = state
        State.Typing = state
        Anim.tween(field, 0.22, { BackgroundTransparency = state and 0.02 or 0.2 }, Anim.Ease.soft)
        Anim.tween(fieldStroke, 0.22, {
            Color = state and Theme.AccentSoft or Theme.Border,
            Transparency = state and 0.05 or 0.45,
        }, Anim.Ease.soft)
    end

    local function commit(newText, skipCallback)
        newText = tostring(newText or "")
        if props.numeric or props.Numeric then
            local cleaned = newText:gsub("[^%-%d%.]", "")
            if cleaned ~= newText then
                textBox.Text = cleaned
                newText = cleaned
            end
        end
        handle.value = newText
        State.Flags[handle.flag] = newText
        if clearButton then clearButton.Visible = newText ~= "" end
        if not skipCallback and props.callback then
            task.spawn(props.callback, newText)
        end
        if not skipCallback then LIBRARY:queueAutoSave() end
    end

    textBox.Focused:Connect(function() setFocused(true) end)

    textBox.FocusLost:Connect(function(enterPressed)
        setFocused(false)
        commit(textBox.Text, false)
        if enterPressed and props.onEnter then
            task.spawn(props.onEnter, textBox.Text)
        end
    end)

    textBox:GetPropertyChangedSignal("Text"):Connect(function()
        if handle.suppress then return end
        if clearButton then clearButton.Visible = textBox.Text ~= "" end
        -- Live-filter style callbacks (e.g. a search field) want every keystroke.
        if props.live or props.Live then
            handle.value = textBox.Text
            State.Flags[handle.flag] = textBox.Text
            if props.callback then task.spawn(props.callback, textBox.Text) end
        end
    end)

    if clearButton then
        clearButton.MouseButton1Click:Connect(function()
            textBox.Text = ""
            commit("", false)
            clearButton.Visible = false
            textBox:CaptureFocus()
        end)
        clearButton.Visible = textBox.Text ~= ""
    end

    handle.Set = function(self, newValue, skipCallback)
        local text = tostring(newValue == nil and "" or newValue)
        handle.suppress = true
        textBox.Text = text
        handle.suppress = false
        commit(text, skipCallback)
        return handle.value
    end

    handle.__apply = function(newValue)
        handle:Set(newValue, true)
    end

    function handle:Get()
        return handle.value
    end

    function handle:Focus()
        textBox:CaptureFocus()
    end

    field.MouseEnter:Connect(function()
        if focused then return end
        Anim.tween(field, 0.18, { BackgroundTransparency = 0.08 }, Anim.Ease.soft)
        Anim.tween(fieldStroke, 0.18, { Transparency = 0.25 }, Anim.Ease.soft)
    end)
    field.MouseLeave:Connect(function()
        if focused then return end
        Anim.tween(field, 0.18, { BackgroundTransparency = 0.2 }, Anim.Ease.soft)
        Anim.tween(fieldStroke, 0.18, { Transparency = 0.45 }, Anim.Ease.soft)
    end)

    applyLockable(handle, row, { field })
    registerElement(self, handle, props, "input")
    handle.value = textBox.Text
    State.Flags[handle.flag] = handle.value

    handle.__refreshTheme = function()
        textBox.TextColor3 = Theme.Text
        textBox.PlaceholderColor3 = Theme.MutedText
        field.BackgroundColor3 = Theme.BackgroundTertiary
        fieldStroke.Color = focused and Theme.AccentSoft or Theme.Border
    end

    return handle
end

