-- Applies a preset by index. Kept together so the settings row and any external
-- caller go through exactly the same path.
function LIBRARY:applyThemePreset(index, silent)
    local preset = THEME_PRESETS[index]
    if not preset then return false end

    LIBRARY:setAccent(preset[2], true)
    LIBRARY:setGradientMode(preset[3], true)

    if not silent then LIBRARY:queueAutoSave() end
    return true
end

function LIBRARY:listThemePresets()
    local out = {}
    for index, preset in ipairs(THEME_PRESETS) do
        out[index] = { index = index, name = preset[1], accent = preset[2] }
    end
    return out
end

-- ── colour wheel ─────────────────────────────────────────────────────────
-- A saturation/value square plus a hue strip. Cheap to render (both are
-- plain Frames) and avoids any dependency on an image asset.

local function createColourPicker(parent, initial, onChanged)
    initial = initial or Theme.Accent

    local holder = Build.frame(parent, {
        name = "ColourPicker",
        size = UDim2.new(1, 0, 0, 168),
        transparency = 1,
        zindex = 20,
    })
    holder.BackgroundTransparency = 1

    local h, s, v = initial:ToHSV()

    local wheelSize = 128
    local wheel = Build.frame(holder, {
        name = "Wheel",
        size = UDim2.fromOffset(wheelSize, wheelSize),
        transparency = 0,
        zindex = 21,
        clips = true,
    })
    wheel.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
    Build.corner(wheel, 6)
    Build.stroke(wheel, Theme.Border, 1, 0.5)

    -- White → transparent, left to right (saturation)
    local satOverlay = Build.frame(wheel, {
        name = "Saturation",
        size = UDim2.fromScale(1, 1),
        transparency = 0,
        zindex = 22,
    })
    satOverlay.BackgroundColor3 = Color3.new(1, 1, 1)
    local satGradient = Instance.new("UIGradient")
    satGradient.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(1, 1),
    })
    satGradient.Parent = satOverlay

    -- Transparent → black, top to bottom (value)
    local valOverlay = Build.frame(wheel, {
        name = "Value",
        size = UDim2.fromScale(1, 1),
        transparency = 0,
        zindex = 23,
    })
    valOverlay.BackgroundColor3 = Color3.new(0, 0, 0)
    local valGradient = Instance.new("UIGradient")
    valGradient.Rotation = 90
    valGradient.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(1, 0),
    })
    valGradient.Parent = valOverlay

    local cursor = Build.frame(wheel, {
        name = "Cursor",
        size = UDim2.fromOffset(12, 12),
        anchor = Vector2.new(0.5, 0.5),
        transparency = 1,
        zindex = 26,
    })
    cursor.BackgroundTransparency = 1
    Build.stroke(cursor, Color3.new(1, 1, 1), 2, 0)
    Build.corner(cursor, 6)

    -- Hue strip
    local stripWidth = 116
    local strip = Build.frame(holder, {
        name = "Hue",
        size = UDim2.fromOffset(12, stripWidth),
        position = UDim2.fromOffset(wheelSize + 12, 0),
        transparency = 0,
        -- MUST be white. A UIGradient multiplies with the parent's
        -- BackgroundColor3, so the dark default here was multiplying the whole
        -- rainbow down to near-black.
        color = Color3.new(1, 1, 1),
        zindex = 21,
    })
    Build.corner(strip, 6)
    Build.stroke(strip, Theme.Border, 1, 0.5)
    local hueGradient = Instance.new("UIGradient")
    hueGradient.Rotation = 90
    local huePoints = {}
    for i = 0, 6 do
        table.insert(huePoints, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 1, 1)))
    end
    hueGradient.Color = ColorSequence.new(huePoints)
    hueGradient.Parent = strip

    local hueCursor = Build.frame(strip, {
        name = "HueCursor",
        size = UDim2.new(1, 4, 0, 4),
        anchor = Vector2.new(0.5, 0.5),
        transparency = 1,
        zindex = 26,
    })
    hueCursor.BackgroundColor3 = Color3.new(1, 1, 1)
    hueCursor.BackgroundTransparency = 0
    Build.corner(hueCursor, 2)

    local function refreshCursor()
        cursor.Position = UDim2.fromScale(s, 1 - v)
        hueCursor.Position = UDim2.new(0.5, 0, h, 0)
        wheel.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
    end

    local function current()
        return Color3.fromHSV(h, s, v)
    end

    --[[
        emit() updates the local readouts every call, but only pushes the colour
        out to onChanged on a throttle.

        A drag fires UserInputService.InputChanged every frame, and onChanged
        runs setAccent -- which fires every accent listener and repaints the
        whole GUI -- plus a second Window:recolour(). Doing that per sample
        (60+ times a second) is what tanked the framerate while dragging.

        Coalescing to ~20Hz keeps the preview smooth, and the final value is
        always flushed on release so the chosen colour is never dropped.
    ]]
    local EMIT_INTERVAL = 0.05
    local lastEmit = 0
    local pendingColour = nil

    local function emit(fire)
        refreshCursor()
        if not fire or not onChanged then return end

        local now = os.clock()
        if now - lastEmit >= EMIT_INTERVAL then
            lastEmit = now
            pendingColour = nil
            onChanged(current())
        else
            pendingColour = current()
        end
    end

    -- Applies any colour the throttle swallowed. Called on release.
    local function flushEmit()
        if not pendingColour or not onChanged then return end
        local colour = pendingColour
        pendingColour = nil
        lastEmit = os.clock()
        onChanged(colour)
    end

    -- wheel dragging
    local wheelDragging = false
    local wheelHit = Build.hitbox(wheel, { zindex = 30 })

    local function updateFromWheel(pos)
        local rel = Vector2.new(
            (pos.X - wheel.AbsolutePosition.X) / math.max(1, wheel.AbsoluteSize.X),
            (pos.Y - wheel.AbsolutePosition.Y) / math.max(1, wheel.AbsoluteSize.Y)
        )
        s = math.clamp(rel.X, 0, 1)
        v = math.clamp(1 - rel.Y, 0, 1)
        emit(true)
    end

    wheelHit.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        wheelDragging = true
        updateFromWheel(input.Position)
    end)

    local hueDragging = false
    local hueHit = Build.hitbox(strip, { zindex = 30 })

    local function updateFromHue(pos)
        local rel = (pos.Y - strip.AbsolutePosition.Y) / math.max(1, strip.AbsoluteSize.Y)
        h = math.clamp(rel, 0, 1)
        emit(true)
    end

    hueHit.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        hueDragging = true
        updateFromHue(input.Position)
    end)

    table.insert(State.Connections, UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if wheelDragging then updateFromWheel(input.Position) end
        if hueDragging then updateFromHue(input.Position) end
    end))

    table.insert(State.Connections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            local wasDragging = wheelDragging or hueDragging
            wheelDragging = false
            hueDragging = false
            -- Push the last colour the throttle held back.
            if wasDragging then flushEmit() end
        end
    end))

    -- Hex field beneath the wheel
    local hexRow = Build.frame(holder, {
        name = "HexRow",
        size = UDim2.new(0, stripWidth, 0, 26),
        position = UDim2.fromOffset(wheelSize + 12, stripWidth + 8),
        transparency = 1,
        zindex = 21,
    })
    hexRow.BackgroundTransparency = 1

    local hexSwatch = Build.frame(hexRow, {
        name = "Swatch",
        size = UDim2.fromOffset(26, 26),
        transparency = 1,
        zindex = 22,
    })
    hexSwatch.BackgroundColor3 = initial
    hexSwatch.BackgroundTransparency = 0
    Build.corner(hexSwatch, 6)
    Build.stroke(hexSwatch, Theme.Border, 1, 0.4)

    local hexBox = Instance.new("TextBox")
    hexBox.BackgroundColor3 = Theme.BackgroundTertiary
    hexBox.BackgroundTransparency = 0.25
    hexBox.BorderSizePixel = 0
    hexBox.Size = UDim2.new(1, -32, 1, 0)
    hexBox.Position = UDim2.fromOffset(32, 0)
    hexBox.Font = Enum.Font.Code
    hexBox.TextSize = 12
    hexBox.TextColor3 = Theme.Text
    hexBox.Text = "#" .. initial:ToHex()
    hexBox.ClearTextOnFocus = false
    hexBox.TextXAlignment = Enum.TextXAlignment.Center
    hexBox.ZIndex = 23
    hexBox.Parent = hexRow
    local hexCorner = Instance.new("UICorner")
    hexCorner.CornerRadius = UDim.new(0, 6)
    hexCorner.Parent = hexBox

    hexBox.FocusLost:Connect(function()
        local raw = hexBox.Text:gsub("#", ""):gsub("%s", "")
        if #raw == 6 and raw:match("^%x+$") then
            local parsed = Color3.fromHex(raw)
            local ph, ps, pv = parsed:ToHSV()
            h, s, v = ph, ps, pv
            emit(true)
        end
        hexBox.Text = "#" .. current():ToHex()
    end)

    refreshCursor()

    return {
        holder = holder,
        Set = function(_, colour)
            if typeof(colour) ~= "Color3" then return end
            local ph, ps, pv = colour:ToHSV()
            h, s, v = ph, ps, pv
            hexSwatch.BackgroundColor3 = colour
            hexBox.Text = "#" .. colour:ToHex()
            refreshCursor()
        end,
        __setSwatch = function(colour)
            hexSwatch.BackgroundColor3 = colour
            hexBox.Text = "#" .. colour:ToHex()
        end,
    }
end

