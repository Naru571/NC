    -- profile panel, bottom-left
    ----------------------------------------------------------------------
    self.profile = self:buildProfile()

    ----------------------------------------------------------------------
    -- dragging
    --
    -- Frame.Draggable moves the frame it is set ON. It was previously set on a
    -- header hitbox, which meant grabbing the header slid the invisible hitbox
    -- around inside the header while the window sat still. It belongs on the
    -- root. Active must also be true, or the frame never receives the press.
    --
    -- The whole window is now a grab surface: press anywhere that is not a
    -- button and drag. Buttons and text fields still consume their own input,
    -- so nothing below stops working.
    ----------------------------------------------------------------------
    self.root.Active = true
    self.root.Draggable = true

    table.insert(self.connections, RunService.RenderStepped:Connect(function()
        if not self.root.Parent or not self.root.Visible then return end
        local parent = self.root.Parent
        local parentSize = parent.AbsoluteSize
        local parentOrigin = parent.AbsolutePosition
        local rootSize = self.root.AbsoluteSize
        if parentSize.X <= 0 or parentSize.Y <= 0 or rootSize.X <= 0 or rootSize.Y <= 0 then return end

        -- Keep the scaled window inside the current viewport, including when
        -- the viewport is a phone-sized touch screen. Recalculate the fit only
        -- when the viewport changes or the scale slider has changed. The old
        -- version compared and corrected this every frame, which fought the
        -- slider while dragging and could make the window appear to teleport.
        if UI_SCALE_CONTAINER then
            -- Fit against the window's CURRENT size, not the constants: the
            -- green zoom dot makes the window bigger, and fitting a zoomed
            -- window against the base size let it hang off the screen edge.
            local liveW = self.windowWidth or WINDOW_WIDTH
            local liveH = self.windowHeight or WINDOW_HEIGHT
            local fitScale = math.min(parentSize.X / (liveW + 24), parentSize.Y / (liveH + 24))
            local fitChanged = (not self._lastFitScale)
                or math.abs(self._lastFitScale - fitScale) > 0.01
            if fitChanged or self._scaleChanged then
                self._lastFitScale = fitScale
                self._scaleChanged = false
                local wantedScale = math.max(0.55, math.min(Theme.UIScale, fitScale))
                if math.abs(UI_SCALE_CONTAINER.Scale - wantedScale) > 0.01 then
                    UI_SCALE_CONTAINER.Scale = wantedScale
                end
            end
        end

        if self._recolourQueued then
            self._recolourQueued = false
            self:recolour()
        end

        local absolute = self.root.AbsolutePosition
        local localX = absolute.X - parentOrigin.X
        local localY = absolute.Y - parentOrigin.Y
        local maxX = math.max(0, parentSize.X - rootSize.X)
        local maxY = math.max(0, parentSize.Y - rootSize.Y)
        local clampedX = math.clamp(localX, 0, maxX)
        local clampedY = math.clamp(localY, 0, maxY)

        if math.abs(clampedX - localX) > 0.5 or math.abs(clampedY - localY) > 0.5 then
            local anchor = self.root.AnchorPoint
            self.root.Position = UDim2.new(
                0, clampedX + rootSize.X * anchor.X,
                0, clampedY + rootSize.Y * anchor.Y
            )
        end
    end))

    ----------------------------------------------------------------------
    -- overlay layer
    --
    -- Dropdown popups, the search results list and the settings panel all
    -- live here rather than inside the scrolling content frame, so they can
    -- float above the layout without being clipped by it.
    ----------------------------------------------------------------------
    self.overlay = Build.frame(self.body, {
        name = "Overlay",
        size = UDim2.fromScale(1, 1),
        transparency = 1,
        zindex = 400,
    })
    self.overlay.BackgroundTransparency = 1
