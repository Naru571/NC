--  GROUPS  (nested, collapsible blocks inside a section)
-- ═══════════════════════════════════════════════════════════════════════════

local Group = {}
Group.__index = Group

function Section:CreateGroup(props)
    if type(props) == "string" then
        props = { name = props }
    end
    props = props or {}

    -- Capture the section before shadowing `self`. The old code rebound self to
    -- the new Group and then parented the shell to self.contentHolder -- which
    -- the Group does not have -- so the shell was parented to nil and every
    -- CreateGroup call threw. The Settings panel is built almost entirely from
    -- groups, which is why it never appeared.
    local section = self
    local self = setmetatable({}, Group)
    self.title = props.name or props.Name or props.title or "Group"
    self.elements = {}
    self.collapsed = props.collapsed or false
    self.section = section
    self.tab = section.tab

    self.shell = Build.frame(section.contentHolder, {
        name = "Group_" .. self.title,
        size = UDim2.new(1, 0, 0, 0),
        transparency = 1,
        zindex = 5,
    })
    self.shell.BackgroundColor3 = Theme.BackgroundTertiary
    self.shell.BackgroundTransparency = 0.5
    self.corner = Build.corner(self.shell, math.max(4, Theme.Corner - 2))
    self.stroke = Build.stroke(self.shell, Theme.Border, 1, 0.7)

    local layout = Instance.new("UIListLayout")
    layout.FillDirection = Enum.FillDirection.Vertical
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 5)
    layout.Parent = self.shell

    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 8)
    pad.PaddingBottom = UDim.new(0, 9)
    pad.PaddingLeft = UDim.new(0, 10)
    pad.PaddingRight = UDim.new(0, 10)
    pad.Parent = self.shell

    self.shell.AutomaticSize = Enum.AutomaticSize.Y

    -- Header doubles as the collapse toggle.
    local header = Build.button(self.shell, {
        name = "GroupHeader",
        size = UDim2.new(1, 0, 0, 18),
        transparency = 1,
        zindex = 6,
    })
    header.BackgroundTransparency = 1
    header.AutoButtonColor = false

    -- Accent tick, so a group header reads as a heading rather than as just
    -- another row. Without it the title sat at exactly the same indent as the
    -- controls underneath it and the panel read as one flat list.
    local tick = Build.frame(header, {
        name = "GroupTick",
        size = UDim2.fromOffset(3, 11),
        position = UDim2.new(0, 0, 0.5, 0),
        anchor = Vector2.new(0, 0.5),
        transparency = 1,
        zindex = 7,
    })
    tick.BackgroundColor3 = Theme.Accent
    tick.BackgroundTransparency = 0.2
    Build.corner(tick, 2)
    self.tick = tick

    Build.text(header, {
        name = "GroupTitle",
        text = self.title,
        size = UDim2.new(1, -32, 1, 0),
        position = UDim2.fromOffset(11, 0),
        font = Enum.Font.GothamBold,
        textSize = 12,
        color = Theme.SubText,
        align = Enum.TextXAlignment.Left,
        zindex = 7,
    })

    local caretHolder = Build.frame(header, {
        name = "Caret",
        size = UDim2.fromOffset(12, 12),
        position = UDim2.new(1, -12, 0.5, 0),
        anchor = Vector2.new(0, 0.5),
        transparency = 1,
        zindex = 7,
    })
    caretHolder.BackgroundTransparency = 1
    local caret = Glyph.new(caretHolder, "chevron", 12, Theme.SubText, 0.2, 1.8, false)
    caretHolder.Rotation = self.collapsed and -90 or 0

    -- Children live in their own holder so collapsing is a single tween.
    self.holder = Build.frame(self.shell, {
        name = "GroupBody",
        size = UDim2.new(1, 0, 0, 0),
        transparency = 1,
        zindex = 6,
        visible = not self.collapsed,
    })
    self.holder.BackgroundTransparency = 1

    local bodyLayout = Instance.new("UIListLayout")
    bodyLayout.FillDirection = Enum.FillDirection.Vertical
    bodyLayout.SortOrder = Enum.SortOrder.LayoutOrder
    bodyLayout.Padding = UDim.new(0, 4)
    bodyLayout.Parent = self.holder

    self.holder.AutomaticSize = Enum.AutomaticSize.Y

    self.contentHolder = self.holder

    function self:toggle()
        self.collapsed = not self.collapsed
        Anim.tween(caretHolder, 0.26, { Rotation = self.collapsed and -90 or 0 }, Anim.Ease.spring)
        if self.collapsed then
            self.holder.Visible = false
        else
            self.holder.Visible = true
            self.holder.Size = UDim2.new(1, 0, 0, 0)
        end
    end

    header.MouseButton1Click:Connect(function()
        self:toggle()
    end)
    header.MouseEnter:Connect(function()
        Anim.tween(header, 0.18, { BackgroundTransparency = 0.94 }, Anim.Ease.soft)
    end)
    header.MouseLeave:Connect(function()
        Anim.tween(header, 0.18, { BackgroundTransparency = 1 }, Anim.Ease.soft)
    end)

    -- Groups expose the same component constructors as sections, but bound to
    -- their own holder. Rather than duplicate every constructor we temporarily
    -- swap the section's content holder.
    function self:CreateToggle(p) return self:_withHolder(Section.CreateToggle, Section, p) end
    function self:CreateSwitch(p) return self:CreateToggle(p) end
    function self:CreateButton(p) return self:_withHolder(Section.CreateButton, Section, p) end
    function self:CreateSlider(p) return self:_withHolder(Section.CreateSlider, Section, p) end
    function self:CreateDropdown(p) return self:_withHolder(Section.CreateDropdown, Section, p) end
    function self:CreateInput(p) return self:_withHolder(Section.CreateInput, Section, p) end
    function self:CreateLabel(p) return self:_withHolder(Section.CreateLabel, Section, p) end
    function self:CreateParagraph(p) return self:_withHolder(Section.CreateParagraph, Section, p) end
    function self:CreateDivider(p) return self:_withHolder(Section.CreateDivider, Section, p) end

    return self
end

-- Runs a Section constructor against this group's holder.
function Group:_withHolder(method, sectionProto, props)
    local host = setmetatable({
        contentHolder = self.holder,
        title = self.title,
        tab = self.tab,
        baseTransparency = 0.5,
        elements = {},
    }, { __index = sectionProto })

    host.addElement = function(_, handle, metadata)
        table.insert(self.elements, handle)
        if metadata and self.tab then
            metadata.group = self
            metadata.tab = self.tab
            metadata.section = self
            metadata.element = handle
            table.insert(self.tab.window.searchIndex, metadata)
        end
    end

    return method(host, props)
end

function Group:recolour()
    if not self.shell or not self.shell.Parent then return end
    self.shell.BackgroundColor3 = Theme.BackgroundTertiary
    self.stroke.Color = Theme.Border
    if self.tick then self.tick.BackgroundColor3 = Theme.Accent end
end

