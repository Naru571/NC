-- A block of explanatory text. Sizes itself to its content, and can be
-- written incrementally which makes it useful for status readouts.
function Section:CreateParagraph(props)
    props = props or {}
    local row = Build.frame(self.contentHolder, {
        name = "Paragraph_" .. (props.name or props.Name or "text"),
        size = UDim2.new(1, 0, 0, 0),
        transparency = 1,
        zindex = 6,
    })
    row.BackgroundTransparency = 1

    local gutter = 0
    if props.icon or props.Icon then
        local iconHolder = Build.frame(row, {
            size = UDim2.fromOffset(15, 15),
            position = UDim2.fromOffset(0, 2),
            transparency = 1,
            zindex = 7,
        })
        iconHolder.BackgroundTransparency = 1
        local resolved = normaliseAsset(props.icon or props.Icon)
        if resolved then
            local img = Instance.new("ImageLabel")
            img.BackgroundTransparency = 1
            img.Size = UDim2.fromScale(1, 1)
            img.Image = resolved
            img.Visible = false
            img.Parent = iconHolder
            img.Loaded:Connect(function() img.Visible = true end)
        else
            Glyph.new(iconHolder, Glyph.resolve(props.icon or props.Icon, "info"),
                14, Theme.Accent, 0.2, 1.5, false)
        end
        gutter = 22
    end

    local body = Build.text(row, {
        name = "Body",
        text = props.text or props.Text or props.content or props.Content or "",
        size = UDim2.new(1, -gutter, 0, 0),
        position = UDim2.fromOffset(gutter, 0),
        font = Enum.Font.Gotham,
        textSize = props.textSize or 12,
        color = props.color or Theme.SubText,
        align = Enum.TextXAlignment.Left,
        zindex = 7,
        wrap = true,
    })
    -- No AutomaticSize here: it overrides the component we set by hand and
    -- computes the height against whatever width the label happens to have at
    -- that instant, which is 0 before layout settles.
    body.TextWrapped = true
    body.TextYAlignment = Enum.TextYAlignment.Top

    local height = Instance.new("UISizeConstraint")
    height.Parent = row

    local headerOffset = 0
    local heading = props.name or props.Name
    -- An empty string is truthy in Lua, so `if props.name` passed for name = ""
    -- and drew a blank 18px title row that shoved the body down by 20px.
    if heading and heading ~= "" then
        Build.text(row, {
            name = "Title",
            text = heading,
            size = UDim2.new(1, 0, 0, 18),
            font = Enum.Font.GothamBold,
            textSize = 13,
            color = Theme.Text,
            zindex = 7,
        })
        headerOffset = 20
        body.Position = UDim2.fromOffset(gutter, headerOffset)
    end

    local layout = Instance.new("UISizeConstraint")
    layout.Parent = row

    --[[
        Measures the wrapped text against the width the label actually has.

        The old version read body.TextBounds.Y directly, but TextBounds is only
        meaningful once the label's width has resolved -- before layout it is
        measured against a zero width, so a long paragraph reported one line and
        never wrapped. Long descriptions then ran straight off the panel edge and
        were clipped.

        TextService:GetTextSize takes an explicit wrap width, so it works before
        layout too. Falls back to the row's width minus the gutter when the label
        has not been sized yet, and re-measures when the width settles.
    ]]
    local lastWidth = 0

    local function refresh(force)
        local width = body.AbsoluteSize.X
        if width <= 1 then
            width = math.max(1, row.AbsoluteSize.X - gutter)
        end
        if not force and math.abs(width - lastWidth) < 1 then return end
        lastWidth = width

        local measured = TextService:GetTextSize(
            body.Text, body.TextSize, body.Font, Vector2.new(width, 10000)
        )
        local textHeight = math.max(14, math.ceil(measured.Y))
        body.Size = UDim2.new(1, -gutter, 0, textHeight)
        row.Size = UDim2.new(1, 0, 0, textHeight + headerOffset + 2)
    end

    body:GetPropertyChangedSignal("Text"):Connect(function() refresh(true) end)
    -- Re-measure once layout gives the label a real width.
    row:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() refresh(false) end)
    task.defer(function() refresh(true) end)

    local handle = {
        value = body.Text,
        frame = row,
        body = body,
        Set = function(self, newText)
            body.Text = tostring(newText == nil and "" or newText)
            refresh()
        end,
        Get = function() return body.Text end,
    }
    handle.__apply = function(newText)
        body.Text = tostring(newText == nil and "" or newText)
        refresh()
    end

    if props.flag or props.Flag then
        registerElement(self, handle, props, "paragraph")
    end

    return handle
end

-- Non-interactive section heading, for grouping elements inside a section.
