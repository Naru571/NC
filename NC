function Build.scroll(parent, props)
    local scroll = Instance.new("ScrollingFrame")
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel = 0
    scroll.Size = props.size or UDim2.fromScale(1, 1)
    scroll.Position = props.position or UDim2.fromScale(0, 0)
    scroll.CanvasSize = props.canvas or UDim2.new()
    scroll.ScrollBarThickness = props.barThickness or 3
    scroll.ScrollBarImageColor3 = Theme.Accent
    scroll.ScrollBarImageTransparency = props.barTransparency or 0.55
    scroll.ScrollingDirection = props.direction or Enum.ScrollingDirection.Y
    scroll.ElasticBehavior = Enum.ElasticBehavior.WhenScrollable
    scroll.ZIndex = props.zindex or 1
    if props.name then scroll.Name = props.name end
    scroll.Parent = parent

    local layout = Instance.new("UIListLayout")
    layout.FillDirection = Enum.FillDirection.Vertical
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, props.gap or 8)
    layout.Parent = scroll

    if props.padding then
        local pad = Instance.new("UIPadding")
        -- There is no "PaddingAll" property on UIPadding. The old code built the
        -- property name by concatenation and defaulted the side to "All", so
        -- every scroller threw "PaddingAll is not a valid member of UIPadding"
        -- and took the whole tab page down with it. Assign real properties only.
        if props.padSide then
            local prop = "Padding" .. tostring(props.padSide)
            if pad[prop] ~= nil then
                pad[prop] = UDim.new(0, props.padding)
            else
                warn("[NC] Build.scroll: unknown padSide '" .. tostring(props.padSide) .. "'")
            end
        else
            pad.PaddingTop = UDim.new(0, props.padding)
            pad.PaddingBottom = UDim.new(0, props.padding + 8)
            pad.PaddingLeft = UDim.new(0, props.padding)
            pad.PaddingRight = UDim.new(0, props.padding)
        end
        pad.Parent = scroll
    end

    return scroll, layout
end

