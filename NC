--  CONFIG PERSISTENCE
-- ═══════════════════════════════════════════════════════════════════════════

local function configDirectory(sub)
    local base = (sub and sub ~= "" and sub .. "/") or ""
    return "NC/" .. base
end

--[[
    Folder configs live in.

    With Theme.PerGameConfigs on (the default) the folder is namespaced by
    game.PlaceId, so a config saved in one game cannot collide with one saved in
    another -- previously every game shared NC/Configs and a "main" config in one
    place silently overwrote the "main" config in the next.

    Turn it off (Settings > Configs > "Per-game configs") to share one folder
    across every game, which is what the old behaviour did.
]]
local function configScope()
    if Theme.PerGameConfigs == false then return "" end
    local placeId = game and game.PlaceId
    if not placeId or placeId == 0 then return "" end
    return tostring(placeId)
end

local function configFolder()
    local scope = configScope()
    if scope == "" then return "NC/Configs" end
    return "NC/Configs/" .. scope
end

local function configPath(name)
    return configFolder() .. "/" .. (name or State.activeConfig) .. ".json"
end

local function safeWrite(path, contents)
    local ok = pcall(function() writefile(path, contents) end)
    if ok then return true end
    -- Older builds wrote straight into NC/Configs; keep writing there if the
    -- scoped folder could not be created.
    pcall(function() writefile("NC_Configs/" .. path:gsub("^NC/Configs/", ""), contents) end)
    return ok
end

local function safeRead(path)
    local ok, contents = pcall(readfile, path)
    if ok then return contents end
    return nil
end

local function safeMkdir(path)
    pcall(function() makefolder(path) end)
end

local function ensureDirectories()
    safeMkdir("NC")
    safeMkdir("NC/Configs")
    -- Create the per-game scope too, or the first save has nowhere to go.
    local folder = configFolder()
    if folder ~= "NC/Configs" then safeMkdir(folder) end
end

local function listConfigs()
    local names = {}
    local ok, files = pcall(listfiles, configFolder())
    if ok and files then
        for _, file in ipairs(files) do
            local name = file:match("([^/\\]+)%.json$")
            if name then table.insert(names, name) end
        end
    end
    table.sort(names)
    return names
end

function LIBRARY:snapshot()
    local data = { _meta = { version = "1.0.0", saved = os.date("!%Y-%m-%dT%H:%M:%SZ") }, flags = {}, appearance = {} }

    for flag, value in pairs(State.Flags) do
        if type(value) == "table" and value.__multi then
            data.flags[flag] = { __type = "multi", values = value.values }
        elseif typeof(value) == "EnumItem" then
            data.flags[flag] = { __type = "enum", enum = tostring(value.EnumType), name = value.Name }
        elseif typeof(value) == "Color3" then
            data.flags[flag] = { __type = "color", r = value.R, g = value.G, b = value.B }
        else
            data.flags[flag] = value
        end
    end

    data.appearance = {
        -- Color3 is not JSON-encodable, so it is stored as components. Writing
        -- the raw Color3 made every save throw inside HttpService:JSONEncode.
        accent      = { __type = "color", r = Theme.Accent.R, g = Theme.Accent.G, b = Theme.Accent.B },
        gradientMode= Theme.GradientMode,
        uiScale     = Theme.UIScale,
        transparency= Theme.Transparency,
        corner      = Theme.Corner,
        glow        = Theme.GlowIntensity,
        animSpeed   = Theme.AnimationSpeed,
        windowIcon  = State.WindowIcon,
        iconOnly    = State.IconOnly,
        profileHidden = State.ProfileHidden,
        showText    = State.ShowText,
        -- EnumItem is not JSON-encodable either; store the key's name.
        toggleKey   = (typeof(State.ToggleKey) == "EnumItem") and State.ToggleKey.Name or nil,
        notifyCap   = Theme.NotifyCap,
        perGameConfigs = Theme.PerGameConfigs ~= false,
        pillDraggable  = Theme.PillDraggable == true,
        trafficLights  = Theme.TrafficLights ~= false,
    }

    return data
end

function LIBRARY:applySnapshot(data)
    if not data or not data.flags then return false end

    for flag, value in pairs(data.flags) do
        if type(value) == "table" and value.__multi then
            State.Flags[flag] = { __multi = true, values = value.values or {} }
        elseif type(value) == "table" and value.__type == "enum" then
            local enum = Enum[value.enum]
            if enum then State.Flags[flag] = enum[value.name] end
        elseif type(value) == "table" and value.__type == "color" then
            State.Flags[flag] = Color3.new(value.r, value.g, value.b)
        else
            State.Flags[flag] = value
        end
    end

    -- push saved values back into live components
    for flag, element in pairs(State.Elements) do
        if data.flags[flag] ~= nil and element.__apply then
            local value = State.Flags[flag]
            pcall(function() element.__apply(value) end)
        end
    end

    local appearance = data.appearance
    if appearance then
        if appearance.accent then
            local a = appearance.accent
            if typeof(a) == "Color3" then
                LIBRARY:setAccent(a, true)
            else
                -- Stored as { __type = "color", r, g, b } because Color3 has no
                -- JSON representation. Accept either casing on read.
                local r = a.r or a.R
                local g = a.g or a.G
                local b = a.b or a.B
                if r and g and b then
                    LIBRARY:setAccent(Color3.new(r, g, b), true)
                end
            end
        end
        if appearance.gradientMode ~= nil then LIBRARY:setGradientMode(appearance.gradientMode, true) end
        if appearance.uiScale then LIBRARY:setScale(appearance.uiScale, true) end
        if appearance.transparency then LIBRARY:setTransparency(appearance.transparency, true) end
        if appearance.corner then LIBRARY:setCorner(appearance.corner, true) end
        if appearance.glow then LIBRARY:setGlow(appearance.glow, true) end
        if appearance.animSpeed then Theme.AnimationSpeed = appearance.animSpeed end
        if appearance.windowIcon then LIBRARY:setWindowIcon(appearance.windowIcon, true) end
        if appearance.iconOnly ~= nil then LIBRARY:setIconMode(appearance.iconOnly, true) end
        if appearance.showText ~= nil then LIBRARY:setShowPillMode(appearance.showText, true) end
        if appearance.toggleKey ~= nil then LIBRARY:setToggleKey(appearance.toggleKey, true) end
        if appearance.notifyCap ~= nil then
            Theme.NotifyCap = tonumber(appearance.notifyCap) or Theme.NotifyCap
        end
        if appearance.perGameConfigs ~= nil then
            Theme.PerGameConfigs = appearance.perGameConfigs and true or false
        end
        if appearance.pillDraggable ~= nil then
            LIBRARY:setPillDraggable(appearance.pillDraggable, true)
        end
        if appearance.trafficLights ~= nil then
            -- Safe before the window exists: setTrafficLights only records the
            -- value on Theme when there is nothing built yet, and the header
            -- reads it back when it is created.
            LIBRARY:setTrafficLights(appearance.trafficLights, true)
        end
        if appearance.profileHidden ~= nil then LIBRARY:setProfileVisible(not appearance.profileHidden, true) end
    end

    return true
end

local saveDebounceToken = 0
function LIBRARY:queueAutoSave()
    if not State.Config.autoSave then return end
    saveDebounceToken = saveDebounceToken + 1
    local token = saveDebounceToken
    task.delay(State.Config.debounce, function()
        if token ~= saveDebounceToken then return end
        LIBRARY:saveConfig(true)
    end)
end

function LIBRARY:saveConfig(silent)
    ensureDirectories()
    local ok, encoded = pcall(function()
        return HttpService:JSONEncode(LIBRARY:snapshot())
    end)

    if not ok then
        return false, "Encoding failed"
    end

    -- State.activeConfig and State.Config.selected were two separate fields that
    -- were never kept in step: the Settings panel writes activeConfig, while
    -- save/load/delete read Config.selected. Renaming a config in Settings and
    -- hitting Save therefore wrote to the previous name. activeConfig is the
    -- source of truth; Config.selected is mirrored for compatibility.
    local name = State.activeConfig or State.Config.selected or "default"
    State.activeConfig = name
    State.Config.selected = name
    local path = configPath(name)
    writefile(path, encoded)

    if not silent and LIBRARY.Notify then
        LIBRARY:Notify({
            Title = "Config saved",
            Content = "\"" .. name .. "\" written to disk.",
            Type = "success",
            Duration = 3,
        })
    end

    return true
end

function LIBRARY:loadConfig(name, silent)
    name = name or State.activeConfig or State.Config.selected or "default"
    local contents = safeRead(configPath(name))
    if not contents then
        if not silent and LIBRARY.Notify then
            LIBRARY:Notify({ Title = "No config selected", Content = "\"" .. name .. "\" was not found.", Type = "warning" })
        end
        return false
    end

    local ok, data = pcall(function() return HttpService:JSONDecode(contents) end)
    if not ok then
        if not silent and LIBRARY.Notify then
            LIBRARY:Notify({ Title = "Config corrupt", Content = "The file could not be parsed.", Type = "error" })
        end
        return false
    end

    LIBRARY:applySnapshot(data)
    State.Config.selected = name
    State.activeConfig = name

    if not silent and LIBRARY.Notify then
        LIBRARY:Notify({ Title = "Config loaded", Content = "\"" .. name .. "\" applied.", Type = "success" })
    end

    return true
end

function LIBRARY:deleteConfig(name)
    name = name or State.activeConfig or State.Config.selected or "default"
    local ok = pcall(delfile, configPath(name))
    if ok and LIBRARY.Notify then
        LIBRARY:Notify({ Title = "Config deleted", Content = "\"" .. name .. "\" removed.", Type = "info" })
    end
    return ok
end

function LIBRARY:listConfigs() return listConfigs() end

-- ── config export / import ───────────────────────────────────────────────
--
-- A config is just JSON, so it can be shared as a string. The prefix makes an
-- imported blob recognisable and lets importConfig reject arbitrary text with a
-- useful message instead of a JSON parse error.

local EXPORT_PREFIX = "NC1:"

-- Returns a shareable string for the current settings.
function LIBRARY:exportConfig(name)
    local data = LIBRARY:snapshot()
    data._meta = data._meta or {}
    data._meta.name = name or State.activeConfig
    data._meta.exported = os.date("!%Y-%m-%dT%H:%M:%SZ")
    data._meta.scope = configScope()

    local ok, encoded = pcall(function() return HttpService:JSONEncode(data) end)
    if not ok then return nil, "Could not encode the config" end
    return EXPORT_PREFIX .. encoded
end

--[[
    Applies a string produced by exportConfig.

    Accepts the prefixed form or bare JSON, and returns `false, reason` on
    anything that does not look like a config so callers can surface why.
]]
function LIBRARY:importConfig(text, name)
    if type(text) ~= "string" then return false, "Nothing to import" end

    local payload = text:match("^%s*(.-)%s*$")
    if payload:sub(1, #EXPORT_PREFIX) == EXPORT_PREFIX then
        payload = payload:sub(#EXPORT_PREFIX + 1)
    end
    if payload == "" then return false, "Nothing to import" end

    local ok, data = pcall(function() return HttpService:JSONDecode(payload) end)
    if not ok or type(data) ~= "table" then
        return false, "That does not look like an NC config"
    end
    if type(data.flags) ~= "table" and type(data.appearance) ~= "table" then
        return false, "That config has no settings in it"
    end
    data.flags = data.flags or {}

    local applied, err = pcall(function() LIBRARY:applySnapshot(data) end)
    if not applied then
        return false, "Could not apply the config: " .. tostring(err)
    end

    if name and name ~= "" then
        State.activeConfig = name
        State.Config.selected = name
    end
    LIBRARY:queueAutoSave()
    return true
end

-- Puts a config string on the clipboard, with a notification either way.
function LIBRARY:copyConfigToClipboard(name)
    local text, err = LIBRARY:exportConfig(name)
    if not text then
        LIBRARY:Notify({ Title = "Export failed", Content = err or "Unknown error", Type = "error" })
        return false
    end

    local ok = pcall(function()
        if setclipboard then
            setclipboard(text)
        elseif toclipboard then
            toclipboard(text)
        else
            error("no clipboard function")
        end
    end)

    if ok then
        LIBRARY:Notify({
            Title = "Config copied",
            Content = "Paste it anywhere to share, or into Import to restore.",
            Type = "success",
            Duration = 4,
        })
    else
        LIBRARY:Notify({
            Title = "No clipboard access",
            Content = "This executor has no setclipboard, so the config could not be copied.",
            Type = "warning",
            Duration = 5,
        })
    end
    return ok
end

-- ═══════════════════════════════════════════════════════════════════════════
--  THEME APPLICATION
-- ═══════════════════════════════════════════════════════════════════════════

local accentListeners = {}

function LIBRARY:onAccent(fn)
    table.insert(accentListeners, fn)
    return fn
end

local function shiftColor(color, amount)
    local h, s, v = color:ToHSV()
    if amount > 0 then
        v = math.clamp(v + amount * (1 - v), 0, 1)
        s = math.clamp(s + amount * 0.08, 0, 1)
    else
        v = math.clamp(v + amount, 0, 1)
        s = math.clamp(s + amount * 0.05, 0, 1)
    end
    return Color3.fromHSV(h, s, v)
end

local function deriveAccentPalette(accent)
    local h, s, v = accent:ToHSV()
    return {
        accent      = accent,
        secondary   = Color3.fromHSV((h + 0.045) % 1, math.clamp(s * 1.05, 0, 1), math.clamp(v * 0.72, 0, 1)),
        deep        = Color3.fromHSV((h + 0.02) % 1, math.clamp(s * 1.1, 0, 1), math.clamp(v * 0.45, 0, 1)),
        soft        = Color3.fromHSV(h, math.clamp(s * 0.55, 0, 1), math.clamp(v * 1.0 + 0.18, 0, 1)),
        border      = shiftColor(accent, -0.58),
        borderBright= shiftColor(accent, -0.34),
        background  = shiftColor(accent, -0.92),
    }
end

function LIBRARY:setAccent(color, silent)
    if typeof(color) ~= "Color3" then return end
    local p = deriveAccentPalette(color)

    Theme.Accent       = p.accent
    Theme.AccentSecondary = p.secondary
    Theme.AccentDeep   = p.deep
    Theme.AccentSoft   = p.soft
    Theme.Border       = p.border
    Theme.BorderBright = p.borderBright
    -- Keep the whole surface palette tied to the selected accent.  The old
    -- setter changed borders and gradients but left the body/background purple.
    Theme.Background          = p.background
    Theme.BackgroundSecondary = shiftColor(color, -0.84)
    Theme.BackgroundTertiary  = shiftColor(color, -0.72)
    Theme.Surface             = seq(Theme.BackgroundTertiary, Theme.BackgroundSecondary)
    Theme.Gradient     = seq(p.accent, p.secondary)

    if not Theme.GradientMode then
        Theme.Gradient = seq(p.accent, p.accent)
    end

    for _, fn in ipairs(accentListeners) do
        pcall(fn, Theme)
    end

    if not silent then LIBRARY:queueAutoSave() end
end

function LIBRARY:setGradientMode(enabled, silent)
    Theme.GradientMode = enabled and true or false
    if Theme.GradientMode then
        Theme.Gradient = seq(Theme.Accent, Theme.AccentSecondary)
    else
        Theme.Gradient = seq(Theme.Accent, Theme.Accent)
    end
    for _, fn in ipairs(accentListeners) do pcall(fn, Theme) end
    if not silent then LIBRARY:queueAutoSave() end
end

function LIBRARY:setTransparency(amount, silent)
    amount = math.clamp(amount, 0, 0.55)
    Theme.Transparency = amount
    for _, fn in ipairs(accentListeners) do pcall(fn, Theme) end
    if not silent then LIBRARY:queueAutoSave() end
end

function LIBRARY:setScale(scale, silent)
    scale = math.clamp(scale, 0.65, 1.35)
    Theme.UIScale = scale
    -- Scale is changed continuously while the slider is dragged. Do not
    -- restart a spring tween for every pointer sample: that creates a queue
    -- of tweens, visible jitter, and unnecessary frame work. Apply the
    -- latest value directly and let the viewport loop clamp it on resize.
    if UI_SCALE_CONTAINER then
        UI_SCALE_CONTAINER.Scale = scale
    end
    if State.Window then
        State.Window._scaleChanged = true
    end
    if not silent then LIBRARY:queueAutoSave() end
end

function LIBRARY:setCorner(radius, silent)
    radius = math.clamp(radius, 0, 24)
    Theme.Corner = radius
    Theme.CornerLarge = math.clamp(radius + 4, 4, 32)
    for _, fn in ipairs(accentListeners) do pcall(fn, Theme) end
    if not silent then LIBRARY:queueAutoSave() end
end

function LIBRARY:setGlow(intensity, silent)
    Theme.GlowIntensity = math.clamp(intensity, 0, 1)
    for _, fn in ipairs(accentListeners) do pcall(fn, Theme) end
    if not silent then LIBRARY:queueAutoSave() end
end

function LIBRARY:setAnimationSpeed(speed, silent)
    Theme.AnimationSpeed = math.clamp(speed, 0.5, 2)
    if not silent then LIBRARY:queueAutoSave() end
end


-- ── appearance toggles used by the config snapshot ───────────────────────

-- Icon-only mode hides the window title and leaves just the mark.
function LIBRARY:setIconMode(iconOnly, silent)
    State.IconOnly = iconOnly and true or false
    local window = State.Window
    if window and window.title then
        local target = State.IconOnly and 1 or 0
        if window.subtitle then
            Anim.tween(window.subtitle, 0.24, { TextTransparency = target }, Anim.Ease.soft)
        end
        if window.tagRow then
            for _, tag in ipairs(window.tagRow:GetChildren()) do
                if tag:IsA("TextLabel") then
                    Anim.tween(tag, 0.24, { TextTransparency = target }, Anim.Ease.soft)
                end
            end
        end
    end
    if not silent then LIBRARY:queueAutoSave() end
end

-- Controls whether the floating pill shows its label or just the icon.
function LIBRARY:setShowPillMode(showText, silent)
    State.ShowText = showText ~= false
    if State.ShowPill then
        State.ShowPill:setText(State.ShowText and "Show NC" or "")
    end
    if not silent then LIBRARY:queueAutoSave() end
end

-- Shows or hides the bottom-left profile block.
function LIBRARY:setProfileVisible(visible, silent)
    State.ProfileHidden = not visible
    local window = State.Window
    if window and window.setProfileVisible then
        window:setProfileVisible(visible and true or false, silent)
    end
    if not silent then LIBRARY:queueAutoSave() end
end

-- ═══════════════════════════════════════════════════════════════════════════
--  WINDOW ICON
--  Accepts "rbxassetid://123", a bare numeric id, "rbxasset://...", or any
--  already-formed asset string. Falls back to the drawn NC mark when the
--  asset cannot be resolved, so a bad id never leaves a blank hole.
-- ═══════════════════════════════════════════════════════════════════════════

local ICON_ASSET_CACHE = {}

local function normaliseAsset(input)
    if type(input) == "number" then return "rbxassetid://" .. tostring(math.floor(input)) end
    if type(input) ~= "string" then return nil end
    local trimmed = input:match("^%s*(.-)%s*$")
    if trimmed == "" then return nil end
    if trimmed:match("^%d+$") then return "rbxassetid://" .. trimmed end
    if trimmed:match("^rbxassetid://") or trimmed:match("^rbxasset://")
        or trimmed:match("^https?://") or trimmed:match("^data:") then
        return trimmed
    end
    return nil
end

-- The NC mark, drawn as strokes so the library never depends on an asset.
local function createBrandMark(parent, size, color)
    local holder = Build.frame(parent, {
        name = "BrandMark",
        size = UDim2.fromOffset(size, size),
        transparency = 1,
    })
    holder.BackgroundTransparency = 1

    local scale = size / 100
    local stroke = math.max(2, 7.5 * scale)
    local accent = Theme.AccentSoft

    local function bar(x1, y1, x2, y2, tint)
        local dx, dy = x2 - x1, y2 - y1
        local frame = Instance.new("Frame")
        frame.AnchorPoint = Vector2.new(0.5, 0.5)
        frame.Position = UDim2.fromOffset((x1 + x2) / 2 * scale, (y1 + y2) / 2 * scale)
        frame.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy) * scale, stroke)
        frame.Rotation = math.deg(math.atan2(dy, dx))
        frame.BackgroundColor3 = tint or color
        frame.BorderSizePixel = 0
        frame.ZIndex = 2
        frame.Parent = holder
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(1, 0)
        c.Parent = frame
        return frame
    end

    -- N: left stem, diagonal, right stem
    bar(15.5, 30, 15.5, 70)
    bar(15.5, 30, 41.5, 70)
    bar(41.5, 30, 41.5, 70)

    -- C: the major arc, sweeping through the left so the gap opens right.
    local cx, cy, r = 67.5, 50, 17
    local steps = 14
    local prevX, prevY
    for i = 0, steps do
        local angle = math.rad(40 + (i / steps) * 280)
        local px = cx + r * math.cos(angle)
        local py = cy + r * math.sin(angle)
        if prevX then bar(prevX, prevY, px, py, accent) end
        prevX, prevY = px, py
    end

    -- Signature beads on the N vertices, sitting proud of the stroke.
    for _, p in ipairs({ { 15.5, 30 }, { 41.5, 30 }, { 15.5, 70 }, { 41.5, 70 } }) do
        local dot = Instance.new("Frame")
        dot.AnchorPoint = Vector2.new(0.5, 0.5)
        dot.Position = UDim2.fromOffset(p[1] * scale, p[2] * scale)
        dot.Size = UDim2.fromOffset(stroke * 1.15, stroke * 1.15)
        dot.BackgroundColor3 = accent
        dot.BorderSizePixel = 0
        dot.ZIndex = 3
        dot.Parent = holder
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(1, 0)
        c.Parent = dot
    end

    return holder
end

-- Builds the window icon. If `asset` resolves, an ImageLabel carries it and the
-- drawn mark is hidden; otherwise the drawn mark is used. `onFallback` fires
-- when an asset was requested but could not be loaded.
function LIBRARY:buildIcon(parent, size, asset, onFallback, fallbackColor)
    local holder = Build.frame(parent, {
        name = "WindowIcon",
        size = UDim2.fromOffset(size, size),
        transparency = 1,
    })
    holder.BackgroundTransparency = 1
    holder.ClipsDescendants = false

    local mark = createBrandMark(holder, size, fallbackColor or Theme.Text)
    mark.Name = "FallbackMark"

    local resolved = normaliseAsset(asset)
    if resolved then
        local image = Instance.new("ImageLabel")
        image.Name = "AssetIcon"
        image.BackgroundTransparency = 1
        image.Size = UDim2.fromScale(1, 1)
        image.Image = resolved
        image.ImageColor3 = Color3.new(1, 1, 1)
        image.ZIndex = 5
        image.Visible = false
        image.Parent = holder

        mark.Visible = true

        local showAsset = function()
            image.Visible = true
            mark.Visible = false
        end

        local failed = false
        image.Loaded:Connect(function()
            if failed or not image.Parent then return end
            showAsset()
        end)

        -- Give the asset a moment to resolve; if it never loads, keep the mark.
        task.delay(2.5, function()
            if not holder.Parent or not image.Parent then return end
            if not image.IsLoaded and image.ContentImageSize.X <= 0 then
                failed = true
                image:Destroy()
                if onFallback then pcall(onFallback, resolved) end
            end
        end)

        ICON_ASSET_CACHE[resolved] = true
    end

    holder:SetAttribute("AssetId", resolved or "")

    return holder, mark
end

function LIBRARY:setWindowIcon(asset, silent)
    State.WindowIcon = asset
    local resolved = normaliseAsset(asset)

    for _, target in ipairs(State.IconTargets or {}) do
        if target.Parent then
            target:Destroy()
        end
    end
    State.IconTargets = {}

    if State.WindowIconHost and State.WindowIconHost.Parent then
        local host = State.WindowIconHost
        for _, child in ipairs(host:GetChildren()) do child:Destroy() end
        local size = host.AbsoluteSize.X > 0 and host.AbsoluteSize.X or 22
        local icon = LIBRARY:buildIcon(host, size, resolved, function()
            LIBRARY:Notify({
                Title = "Icon unavailable",
                Content = "That asset id did not resolve. Keeping the default mark.",
                Type = "warning",
                Duration = 4,
            })
        end)
        table.insert(State.IconTargets, icon)
    end

    if not silent then
        if resolved then
            LIBRARY:Notify({ Title = "Icon updated", Content = "Window icon set to " .. resolved, Type = "success", Duration = 3 })
        else
            LIBRARY:Notify({ Title = "Icon reset", Content = "Reverted to the default NC mark.", Type = "info", Duration = 3 })
        end
        LIBRARY:queueAutoSave()
    end
end

-- ═══════════════════════════════════════════════════════════════════════════
--  NOTIFICATIONS
-- ═══════════════════════════════════════════════════════════════════════════

local NOTIFY_TYPES = {
    success = { glyph = "success", color = function() return Theme.Success end },
    info    = { glyph = "info",    color = function() return Theme.Info end },
    warning = { glyph = "warning", color = function() return Theme.Warning end },
    error   = { glyph = "error",   color = function() return Theme.Error end },
}

local notifyStack = nil

local function ensureNotifyStack()
    if notifyStack and notifyStack.Parent then return notifyStack end

    local host = State.Gui or gethui()
    notifyStack = Build.frame(host, {
        name = "NC_Notifications",
        -- Fill the available width on phones; the constraint below keeps the
        -- desktop stack compact instead of stretching it across the screen.
        size = UDim2.new(1, -24, 1, 0),
        position = UDim2.new(1, -12, 0, 12),
        transparency = 1,
        zindex = 200,
    })
    notifyStack.BackgroundTransparency = 1
    notifyStack.AnchorPoint = Vector2.new(1, 0)
    notifyStack.Visible = true
    notifyStack.ClipsDescendants = false

    local sizeConstraint = Instance.new("UISizeConstraint")
    sizeConstraint.Name = "MobileWidthLimit"
    sizeConstraint.MaxSize = Vector2.new(320, 1000000)
    sizeConstraint.MinSize = Vector2.new(0, 0)
    sizeConstraint.Parent = notifyStack

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 8)
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
    layout.Parent = notifyStack

    return notifyStack
end

-- ── notification queue ───────────────────────────────────────────────────
--
-- Notifications used to stack forever, so a chatty script could bury the whole
-- screen. The queue keeps at most Theme.NotifyCap cards on screen; older ones
-- park in an off-screen holder behind a "+N more" chip that expands on click.
--
-- Set Theme.NotifyCap to 0 (Settings > Behaviour > "Limit notifications") to
-- turn the cap off and get the old unlimited stack back.

local notifyOverflow = nil   -- off-screen parking frame for hidden cards
local notifyChip = nil       -- the "+N more" button

local function ensureNotifyOverflow()
    if notifyOverflow and notifyOverflow.Parent then return notifyOverflow end
    local host = State.Gui or gethui()
    notifyOverflow = Build.frame(host, {
        name = "NC_NotificationsOverflow",
        -- Parked far off screen rather than merely Visible = false: an invisible
        -- frame still occupies space in a UIListLayout, so hidden cards would
        -- leave gaps in the stack.
        size = UDim2.fromOffset(320, 10),
        position = UDim2.fromOffset(-10000, -10000),
        transparency = 1,
        visible = false,
    })
    notifyOverflow.BackgroundTransparency = 1
    return notifyOverflow
end

local function notifyCap()
    local cap = tonumber(Theme.NotifyCap)
    if cap == nil then cap = 4 end
    return math.max(0, math.floor(cap))
end

local function refreshNotifyQueue()
    local queue = State.NotifyQueue
    if not queue then return end

    -- Drop entries whose card is gone.
    for index = #queue, 1, -1 do
        local entry = queue[index]
        if not entry.card or not entry.card.Parent or entry.dead then
            table.remove(queue, index)
        end
    end

    local stack = ensureNotifyStack()
    local overflow = ensureNotifyOverflow()
    local total = #queue

    local cap = notifyCap()
    local show = total
    if cap > 0 and not State.NotifyExpanded then
        show = math.min(cap, total)
    end

    -- Newest are appended last, so the newest `show` entries stay visible.
    for index, entry in ipairs(queue) do
        local parent = (index > total - show) and stack or overflow
        if entry.card.Parent ~= parent then
            entry.card.Parent = parent
        end
    end

    local hiddenCount = total - show

    if hiddenCount <= 0 then
        if notifyChip and notifyChip.Parent ~= overflow then
            notifyChip.Parent = overflow
        end
        return
    end

    if not notifyChip or not notifyChip.Parent then
        notifyChip = Build.button(stack, {
            name = "NotifyOverflow",
            size = UDim2.new(1, 0, 0, 30),
            transparency = 1,
            zindex = 202,
        })
        notifyChip.BackgroundColor3 = Theme.BackgroundTertiary
