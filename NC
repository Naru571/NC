-- Rebuilds the header mark after the icon has been set or cleared.
function Window:setHeaderIcon(asset)
    if not self.iconHost or not self.iconHost.Parent then return end
    for _, child in ipairs(self.iconHost:GetChildren()) do
        child:Destroy()
    end

    State.WindowIcon = asset
    self.icon = LIBRARY:buildIcon(self.iconHost, 26, asset, function()
        LIBRARY:Notify({
            Title = "Icon unavailable",
            Content = "That asset did not load. Using the built-in NC mark.",
            Type = "warning",
            Duration = 4,
        })
    end, Theme.Text)

    -- Fade the new mark in rather than popping it.
    for _, child in ipairs(self.iconHost:GetChildren()) do
        local was = child.BackgroundTransparency
        child.BackgroundTransparency = 1
        Anim.tween(child, 0.3, { BackgroundTransparency = was or 0 }, Anim.Ease.soft)
        local stroke = child:FindFirstChildOfClass("UIStroke")
        if stroke then
            local target = stroke.Transparency
            stroke.Transparency = 1
            Anim.tween(stroke, 0.3, { Transparency = target }, Anim.Ease.soft)
        end
    end
end

