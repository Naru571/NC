-- Capture the executor's own gethui BEFORE we shadow the name with ours.
--
-- The previous version called `gethui()` from inside its own definition, so it
-- recursed into itself forever; pcall swallowed the stack overflow and the
-- fallback silently took over. The net effect was that the protected container
-- was never used and the UI always landed in PlayerGui.
local EXEC_GETHUI = gethui

local function gethui()
    if type(EXEC_GETHUI) == "function" then
        local ok, hub = pcall(EXEC_GETHUI)
        if ok and typeof(hub) == "Instance" then return hub end
    end
    if syn and syn.protect_gui then
        local ok, core = pcall(function() return CoreGui end)
        if ok and core then return core end
    end
    return LocalPlayer:FindFirstChild("PlayerGui") or CoreGui
end

