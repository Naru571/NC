-- Draws a circular arc out of short bars, so it needs no asset and no
-- UIGradient trickery. Used for the static ring and the rotating spinner.
local function buildArc(parent, diameter, thickness, sweepDegrees, tint, startDeg)
    local holder = Build.frame(parent, {
        name = "Arc",
        size = UDim2.fromOffset(diameter, diameter),
        position = UDim2.fromScale(0.5, 0.5),
        anchor = Vector2.new(0.5, 0.5),
        transparency = 1,
        zindex = 3,
    })
    holder.BackgroundTransparency = 1

    local radius = diameter / 2 - thickness / 2
    local cx, cy = diameter / 2, diameter / 2
    local steps = math.max(4, math.floor(sweepDegrees / 14))
    local prevX, prevY

    for i = 0, steps do
        local angle = math.rad(startDeg + (i / steps) * sweepDegrees)
        local px = cx + radius * math.cos(angle)
        local py = cy + radius * math.sin(angle)
        if prevX then
            local dx, dy = px - prevX, py - prevY
            local seg = Instance.new("Frame")
            seg.AnchorPoint = Vector2.new(0.5, 0.5)
            seg.Position = UDim2.fromOffset((prevX + px) / 2, (prevY + py) / 2)
            -- Overlap each bar slightly so the joins read as one smooth curve.
            seg.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy) + thickness * 0.7, thickness)
            seg.Rotation = math.deg(math.atan2(dy, dx))
            seg.BackgroundColor3 = tint
            seg.BorderSizePixel = 0
            seg.ZIndex = 3
            seg.Parent = holder
            local c = Instance.new("UICorner")
            c.CornerRadius = UDim.new(1, 0)
            c.Parent = seg
        end
        prevX, prevY = px, py
    end

    return holder
end

function LoadingScreen.new(gui, title, subtitle)
    local self = setmetatable({}, LoadingScreen)
    -- Loading is a separate phase. Snapshot its appearance so Settings changes
    -- made after boot can never rewrite an active loading screen.
    self.loadingTransparency = Theme.Transparency
    self.loadingGlow = Theme.GlowIntensity

    self.root = Build.frame(gui, {
        name = "NC_Loading",
        size = UDim2.fromScale(1, 1),
        transparency = 0,
        -- No UICorner: this is a full-bleed backdrop, and rounding it left the
        -- screen corners showing the game through.
        corner = false,
        zindex = 500,
    })
    self.root.BackgroundColor3 = Theme.Background
    self.root.BackgroundTransparency = 0

    local backdropGradient = Build.gradient(self.root, seq(
        Theme.Background,
        shiftColor(Theme.Accent, -0.86),
        Theme.Background
    ), 135)
    self.backdropGradient = backdropGradient

    -- Vignette: two soft bands top and bottom so the eye lands on the centre.
    for _, spec in ipairs({
        { name = "VignetteTop", size = UDim2.new(1, 0, 0.34, 0), pos = UDim2.fromScale(0, 0), flip = true },
        { name = "VignetteBottom", size = UDim2.new(1, 0, 0.34, 0), pos = UDim2.new(0, 0, 1, 0), flip = false },
    }) do
        local band = Build.frame(self.root, {
            name = spec.name,
            size = spec.size,
            position = spec.pos,
            anchor = spec.flip and Vector2.new(0, 0) or Vector2.new(0, 1),
            transparency = 1,
            zindex = 1,
        })
        band.BackgroundColor3 = Color3.new(0, 0, 0)
        band.BackgroundTransparency = 0
        local g = Build.gradient(band, seq(
            Color3.new(0, 0, 0), Color3.new(0, 0, 0)
        ), spec.flip and 90 or 270)
        g.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.35),
            NumberSequenceKeypoint.new(1, 1),
        })
    end

    -- Ambient glow behind the mark. Built from nested discs rather than one
    -- flat circle, which would render as a hard-edged disc parked in the middle
    -- of the screen.
    self.bloom, self.setBloomPeak = buildRadialGlow(self.root, 620, Theme.Accent, {
        name = "Bloom",
        position = UDim2.fromScale(0.5, 0.44),
        peak = 0.09,
        layers = 14,
        zindex = 2,
    })

    self.particleConn = select(2, Build.particles(self.root, 44, Theme.AccentSoft, {
        minSize = 1, maxSize = 3, drift = 0.5, zindex = 3, corner = 0,
    }))

    -- Content sits in its own scaled holder so it still fits a small viewport,
    -- while the backdrop above stays full-screen and unscaled.
    local contentHolder = Build.frame(self.root, {
        name = "ContentHolder",
        size = UDim2.fromScale(1, 1),
        transparency = 1,
        zindex = 4,
    })
    contentHolder.BackgroundTransparency = 1

    self.contentScale = Instance.new("UIScale")
    self.contentScale.Scale = 1
    self.contentScale.Parent = contentHolder

    do
        local camera = Workspace.CurrentCamera
        local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
        -- Only ever scale DOWN. A UIScale grows its subtree from the parent's
        -- top-left, so scaling UP on a large display both magnified the content
        -- and pushed the whole thing off-centre (the title landed at 57.5% of
        -- the width instead of 50%). The content is authored at its natural
        -- size, so on a big screen it should simply stay at 1.
        local fit = math.min(viewport.X / 860, viewport.Y / 600)
        self.contentScale.Scale = math.clamp(math.min(fit, 1), 0.5, 1)
    end

    -- A UIScale multiplies a child's Position along with everything else, so a
    -- child placed at 0.5 of the width renders at 0.5 * scale. Dividing the
    -- scale fractions by the scale itself puts the content back on the true
    -- centre whatever the scale ends up being.
    local contentScaleValue = self.contentScale.Scale

    local centre = Build.frame(contentHolder, {
        name = "Centre",
        -- Height matches the content (mark 150 + type + rail + status = 285) so
        -- the frame's centre is the content's centre. At 312 it was taller than
        -- its own contents, which left everything sitting above the middle.
        size = UDim2.new(0, 460, 0, 290),
        position = UDim2.fromScale(0.5 / contentScaleValue, 0.5 / contentScaleValue),
        anchor = Vector2.new(0.5, 0.5),
        transparency = 1,
        zindex = 4,
    })
    centre.BackgroundTransparency = 1
    self.centre = centre

    ----------------------------------------------------------------
    -- brand mark, inside a ring + rotating spinner
    ----------------------------------------------------------------
    local markHolder = Build.frame(centre, {
        name = "MarkHolder",
        size = UDim2.fromOffset(150, 150),
        position = UDim2.new(0.5, 0, 0, 0),
        anchor = Vector2.new(0.5, 0),
        transparency = 1,
        zindex = 5,
    })
    markHolder.BackgroundTransparency = 1

    -- Both glows use the layered falloff too; as single flat circles they had
    -- the same hard edge as the big bloom.
    self.halo, self.setHaloPeak = buildRadialGlow(markHolder, 150, Theme.Accent, {
        name = "Halo",
        peak = 0.12,
        layers = 10,
        zindex = 2,
    })

    -- faint static ring
    self.ring = buildArc(markHolder, 132, 1, 360, Theme.Border, 0)

    -- the rotating spinner
    self.spinner = buildArc(markHolder, 132, 2.5, 90, Theme.AccentSoft, -90)

    self.markGlow, self.setMarkGlowPeak = buildRadialGlow(markHolder, 120, Theme.Accent, {
        name = "MarkGlow",
        peak = 0.05,
        layers = 10,
        zindex = 2,
    })

    local markSlot = Build.frame(markHolder, {
        name = "MarkSlot",
        size = UDim2.fromOffset(78, 78),
        position = UDim2.fromScale(0.5, 0.5),
        anchor = Vector2.new(0.5, 0.5),
        transparency = 1,
        zindex = 6,
    })
    markSlot.BackgroundTransparency = 1
    self.mark = createBrandMark(markSlot, 78, Theme.Text)

    ----------------------------------------------------------------
    -- type
    ----------------------------------------------------------------
    self.title = Build.text(centre, {
        name = "Title",
        text = title or "NC",
        size = UDim2.new(1, 0, 0, 36),
        position = UDim2.new(0, 0, 0, 162),
        font = Enum.Font.GothamBold,
        textSize = 28,
        color = Theme.Text,
        xalign = Enum.TextXAlignment.Center,
        truncate = Enum.TextTruncate.AtEnd,
        transparency = 1,
        zindex = 5,
    })

    self.subtitle = Build.text(centre, {
        name = "Subtitle",
        text = subtitle or "",
        size = UDim2.new(1, 0, 0, 16),
        position = UDim2.new(0, 0, 0, 200),
        font = Enum.Font.Gotham,
        textSize = 13,
        color = Theme.SubText,
        xalign = Enum.TextXAlignment.Center,
        truncate = Enum.TextTruncate.AtEnd,
        transparency = 1,
        zindex = 5,
    })

    ----------------------------------------------------------------
    -- progress: thicker rail, gradient fill, travelling sheen, head glow
    ----------------------------------------------------------------
    local rail = Build.frame(centre, {
        name = "ProgressRail",
        size = UDim2.new(0, 348, 0, 8),
        position = UDim2.new(0.5, 0, 0, 242),
        anchor = Vector2.new(0.5, 0),
        transparency = 1,
        zindex = 5,
    })
    rail.BackgroundColor3 = Theme.Border
    rail.BackgroundTransparency = 0.62
    Build.corner(rail, 4)
    self.rail = rail

    self.fill = Build.frame(rail, {
        name = "ProgressFill",
        size = UDim2.new(0, 0, 1, 0),
        -- Visible. This was transparency = 1 and nothing ever restored it, so
        -- the bar never actually filled -- all you saw was the travelling sheen
        -- and the head glow riding along an empty track.
        transparency = 0,
        zindex = 6,
    })
    self.fill.BackgroundColor3 = Theme.Accent
    self.fillGradient = Build.gradient(self.fill, seq(Theme.Accent, Theme.AccentSoft), 0)
    Build.corner(self.fill, 4)

    -- sheen that sweeps along whatever portion is filled
    self.fillClip = Build.frame(rail, {
        name = "ProgressClip",
        size = UDim2.new(0, 0, 1, 0),
        transparency = 1,
        zindex = 7,
        clips = true,
    })
    self.fillClip.BackgroundTransparency = 1
    Build.corner(self.fillClip, 4)

    self.shimmer = Build.frame(self.fillClip, {
        name = "Shimmer",
        size = UDim2.fromOffset(46, 8),
        position = UDim2.fromOffset(-46, 0),
        transparency = 1,
        zindex = 8,
    })
    self.shimmer.BackgroundColor3 = Color3.new(1, 1, 1)
    self.shimmer.BackgroundTransparency = 0.72
    Build.corner(self.shimmer, 4)

    -- soft glow riding the leading edge
    self.fillGlow = Build.frame(rail, {
        name = "FillGlow",
        size = UDim2.fromOffset(30, 30),
        position = UDim2.new(0, -15, 0.5, 0),
        anchor = Vector2.new(0.5, 0.5),
        transparency = 1,
        zindex = 9,
    })
    self.fillGlow.BackgroundColor3 = Theme.AccentSoft
    self.fillGlow.BackgroundTransparency = 1
    Build.corner(self.fillGlow, 999)

    self.percent = Build.text(centre, {
        name = "Percent",
        text = "0%",
        size = UDim2.new(0, 52, 0, 20),
        -- Sits just right of the 348px rail, inside the 460px centre frame.
        position = UDim2.new(0.5, 184, 0, 236),
        anchor = Vector2.new(0, 0),
        font = Enum.Font.GothamBold,
        textSize = 15,
        color = Theme.AccentSoft,
        xalign = Enum.TextXAlignment.Left,
        transparency = 1,
        zindex = 6,
    })

    ----------------------------------------------------------------
    -- status line with its own indicator dot
    ----------------------------------------------------------------
    self.statusDot = Build.frame(centre, {
        name = "StatusDot",
        size = UDim2.fromOffset(6, 6),
        position = UDim2.new(0.5, -120, 0, 276),
        anchor = Vector2.new(0.5, 0.5),
        transparency = 1,
        zindex = 6,
    })
    self.statusDot.BackgroundColor3 = Theme.AccentSoft
    Build.corner(self.statusDot, 999)

    self.status = Build.text(centre, {
        name = "Status",
        text = STATUS_STEPS[1].text,
        size = UDim2.new(1, 0, 0, 16),
        position = UDim2.new(0, 0, 0, 269),
        font = Enum.Font.Gotham,
        textSize = 12,
        color = Theme.SubText,
        xalign = Enum.TextXAlignment.Center,
        transparency = 1,
        zindex = 5,
    })

    -- Centres the dot against whatever the status text currently is.
    function self:layoutStatus()
        local text = self.status.Text or ""
        local measured = TextService:GetTextSize(text, 12, Enum.Font.Gotham, Vector2.new(400, 20))
        local total = measured.X + 14
        self.statusDot.Position = UDim2.new(0.5, -total / 2 + 3, 0, 277)
    end
    self:layoutStatus()

    ----------------------------------------------------------------
    -- idle motion
    ----------------------------------------------------------------
    self.conns = {}
    self.clock = 0
    self.spin = 0
    table.insert(self.conns, RunService.RenderStepped:Connect(function(dt)
        if not self.root.Parent then return end
        self.clock = self.clock + dt
        self.spin = self.spin + dt

        local t = (math.sin(self.clock * 1.15) + 1) / 2
        if self.setBloomPeak then
            self.setBloomPeak(0.06 + t * 0.05 * (0.5 + self.loadingGlow * 0.5))
        end
        if self.setHaloPeak then
            self.setHaloPeak(0.07 + t * 0.05 * (0.4 + self.loadingGlow * 0.6))
        end
        if self.setMarkGlowPeak then
            self.setMarkGlowPeak(0.03 + t * 0.05 * (0.4 + self.loadingGlow * 0.6))
        end
        markSlot.Rotation = math.sin(self.spin * 0.5) * 2

        self.spinner.Rotation = (self.spin * 260) % 360
        self.statusDot.BackgroundTransparency = 0.15 + t * 0.45

        -- sheen sweeps across the filled portion
        local span = math.max(1, self.target * 348)
        self.shimmer.Position = UDim2.fromOffset(((self.clock * 150) % (span + 92)) - 46, 0)

        self.backdropGradient.Offset = Vector2.new(math.sin(self.clock * 0.18) * 0.25, 0)
    end))

    -- entrance
    Anim.tween(self.title, 0.55, { TextTransparency = 0 }, Anim.Ease.soft)
    Anim.tween(self.subtitle, 0.55, { TextTransparency = 0 }, Anim.Ease.soft)
    Anim.tween(self.status, 0.4, { TextTransparency = 0 }, Anim.Ease.soft)
    Anim.tween(self.percent, 0.4, { TextTransparency = 0 }, Anim.Ease.soft)
    Anim.tween(self.ring, 0.5, { BackgroundTransparency = 0 }, Anim.Ease.soft)
    Anim.tween(rail, 0.4, { BackgroundTransparency = 0.62 }, Anim.Ease.soft)
    -- Settle from a touch above the centre. Both endpoints divide by the content
    -- scale so the spring lands on the true middle rather than drifting right.
    Anim.tween(self.centre, 0.5, {
        Position = UDim2.fromScale(0.5 / contentScaleValue, 0.5 / contentScaleValue),
    }, Anim.Ease.spring)

    self.progress = 0
    self.target = 0

    return self
end

function LoadingScreen:setProgress(value, statusOverride)
    self.target = math.clamp(value, 0, 1)

    local percentText = tostring(math.floor(self.target * 100 + 0.5)) .. "%"
    self.percent.Text = percentText

    local text = statusOverride
    if not text then
        for _, step in ipairs(STATUS_STEPS) do
            if self.target >= step.at then text = step.text end
        end
    end
    if text and self.status.Text ~= text then
        self.status.Text = text
        self.status.TextTransparency = 0.6
        Anim.tween(self.status, 0.28, { TextTransparency = 0 }, Anim.Ease.soft)
        -- The dot is centred against the text, so it has to move with it.
        if self.layoutStatus then self:layoutStatus() end
    end

    Anim.tween(self.fill, 0.42, { Size = UDim2.new(self.target, 0, 1, 0) }, Anim.Ease.soft)
    -- The sheen is clipped to the filled portion, so the clip has to track it.
    Anim.tween(self.fillClip, 0.42, { Size = UDim2.new(self.target, 0, 1, 0) }, Anim.Ease.soft)
    Anim.tween(self.fillGlow, 0.42, {
        Position = UDim2.new(self.target, 0, 0.5, 0),
        BackgroundTransparency = 0.55,
    }, Anim.Ease.soft)
end

function LoadingScreen:destroy()
    for _, conn in ipairs(self.conns) do
        pcall(function() conn:Disconnect() end)
    end
    if self.particleConn then pcall(function() self.particleConn:Disconnect() end) end
    self.root:Destroy()
end

-- Fades the whole screen out and reports when it is gone.
-- Fades the whole screen out and reports when it is gone.
function LoadingScreen:fadeOut(onComplete)
    -- Stop the idle loop first: it writes bloom/halo transparency every frame
    -- and would fight the fade tweens.
    for _, conn in ipairs(self.conns) do pcall(function() conn:Disconnect() end) end
    self.conns = {}

    -- Same scale compensation as the entrance; this runs from fadeOut, so read
    -- the scale off the instance rather than a local from the constructor.
    local fadeScale = (self.contentScale and self.contentScale.Scale) or 1
    Anim.tween(self.centre, 0.42, {
        Position = UDim2.fromScale(0.5 / fadeScale, 0.45 / fadeScale),
    }, Anim.Ease.soft, Anim.Dir.inward)

    -- Fade every descendant rather than a hand-written list. The old version
    -- listed elements one by one and missed the brand mark, which is a
    -- container of many small frames -- so the logo stayed lit while the rest
    -- of the screen dissolved around it.
    for _, inst in ipairs(self.root:GetDescendants()) do
        if inst:IsA("Frame") or inst:IsA("ImageLabel") then
            if inst.BackgroundTransparency < 1 then
                Anim.tween(inst, 0.32, { BackgroundTransparency = 1 }, Anim.Ease.soft, Anim.Dir.inward)
            end
            if inst:IsA("ImageLabel") and inst.ImageTransparency < 1 then
                Anim.tween(inst, 0.32, { ImageTransparency = 1 }, Anim.Ease.soft, Anim.Dir.inward)
            end
        elseif inst:IsA("TextLabel") or inst:IsA("TextBox") then
            if inst.TextTransparency < 1 then
                Anim.tween(inst, 0.32, { TextTransparency = 1 }, Anim.Ease.soft, Anim.Dir.inward)
            end
        elseif inst:IsA("UIStroke") then
            if inst.Transparency < 1 then
                Anim.tween(inst, 0.32, { Transparency = 1 }, Anim.Ease.soft, Anim.Dir.inward)
            end
        end
    end

    local done = false
    Anim.tween(self.root, 0.5, { BackgroundTransparency = 1 }, Anim.Ease.soft, Anim.Dir.inward)
    task.delay(0.52, function()
        if done then return end
        done = true
        if onComplete then task.spawn(onComplete) end
        self:destroy()
    end)
end

-- ═══════════════════════════════════════════════════════════════════════════
--  LOADING ORCHESTRATION
-- ═══════════════════════════════════════════════════════════════════════════

--[[
    Runs the loading screen, handing each stage to `builders`.

    builders: { { text = "Loading features...", run = function() ... end }, ... }

    Progress is driven across the stages, with a short settle at the end so the
    bar always reads 100% before the fade rather than snapping away.
]]
local function runLoadingSequence(gui, config, builders, onDone)
    local screen = LoadingScreen.new(gui, config.name or "NC", config.subtitle or "")
    State.LoadingScreen = screen

    local stages = builders or {}
    local total = #stages
    local index = 0

    local function advance()
        index = index + 1
        if index > total then
            screen:setProgress(1, "Ready!")
            task.wait(0.55)
            screen:fadeOut(function()
                State.LoadingScreen = nil
                if onDone then onDone() end
            end)
            return
        end

        local stage = stages[index]
        local startFraction = (index - 1) / total
        screen:setProgress(startFraction, stage.text)

        -- animate toward the stage's share while it actually runs
        local settleToken = 0
        settleToken = settleToken + 1
        task.spawn(function()
            local steps = 14
            for step = 1, steps do
                task.wait(0.028)
                if index > total then break end
                local eased = startFraction + (1 / total) * (step / steps) * 0.82
                screen:setProgress(math.min(eased, 0.99), stage.text)
            end
        end)

        if stage.run then
            local ok, err = pcall(stage.run)
            if not ok then
                warn("[NC] loading stage failed: " .. tostring(err))
            end
        end

        task.delay(0.42, advance)
    end

    advance()

    return screen
end

-- ═══════════════════════════════════════════════════════════════════════════
--  DRAGGING
-- ═══════════════════════════════════════════════════════════════════════════

--[[
    Makes `handle` drag `target` with the mouse.

    A press only counts as a click when the cursor barely moved, so dragging a
    control never fires its click handler by accident. Returns a disconnect
    function and a `moved` predicate.
]]
local function makeDraggable(handle, target, options)
    options = options or {}
    local dragging = false
    local dragStart, startPos, startScale
    local moved = false
    local baked = false
    local conns = {}

    -- The window opens anchored at UDim2.fromScale(0.5, 0.5). Keeping that
    -- scale while dragging makes the frame drift as the viewport resizes, and
    -- converting to offsets mid-drag makes it jump. So on the first press we
    -- bake the current on-screen position into pixel offsets once, and every
    -- drag from then on is pure offset arithmetic.
    local function bakeToOffsets()
        if target.Position.X.Scale == 0 and target.Position.Y.Scale == 0 then
            return
        end
        local absPos = target.AbsolutePosition
        local parent = target.Parent
        local parentAbs = parent and parent.AbsolutePosition or Vector2.zero
        local size = target.AbsoluteSize
        local anchor = target.AnchorPoint
        local scale = (UI_SCALE_CONTAINER and UI_SCALE_CONTAINER.Scale) or 1
        -- AbsolutePosition is screen-space; Position offsets are parent-space.
        -- Convert through the current UIScale so baking never teleports the
        -- pill to a corner on scaled/mobile layouts.
        target.Position = UDim2.new(
            0, (absPos.X - parentAbs.X + size.X * anchor.X) / scale,
            0, (absPos.Y - parentAbs.Y + size.Y * anchor.Y) / scale
        )
    end

    table.insert(conns, handle.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        dragging = true
        moved = false
        baked = false
        dragStart = input.Position
        startScale = (UI_SCALE_CONTAINER and UI_SCALE_CONTAINER.Scale) or 1
        -- Do not convert a centered scale position on a simple click. That
        -- conversion was teleporting Show NC before the click was released.
        startPos = target.Position
    end))

    table.insert(conns, UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then return end

        local rawDelta = input.Position - dragStart
        local scale = startScale or 1
        if math.abs(rawDelta.X) > 4 or math.abs(rawDelta.Y) > 4 then
            moved = true
            if not baked then
                -- Bake only once the gesture is definitely a drag. Reset the
                -- origin immediately so the first drag frame cannot jump.
                bakeToOffsets()
                startPos = target.Position
                dragStart = input.Position
                baked = true
                rawDelta = Vector2.zero
            end
        end
        local delta = rawDelta / scale

        local anchor = target.AnchorPoint
        local parentSize = target.Parent and target.Parent.AbsoluteSize or Vector2.new(1920, 1080)
        if options.clamp then
            local width = target.AbsoluteSize.X / scale
            local height = target.AbsoluteSize.Y / scale
            local minX = width * anchor.X
            local minY = height * anchor.Y
            local maxX = math.max(minX, parentSize.X / scale - width * (1 - anchor.X))
            local maxY = math.max(minY, parentSize.Y / scale - height * (1 - anchor.Y))
            local newX = math.clamp(startPos.X.Offset + delta.X, minX, maxX)
            local newY = math.clamp(startPos.Y.Offset + delta.Y, minY, maxY)
            target.Position = UDim2.new(anchor.X, newX, anchor.Y, newY)
        else
            target.Position = UDim2.new(
                anchor.X, startPos.X.Offset + delta.X,
                anchor.Y, startPos.Y.Offset + delta.Y
            )
        end
    end))

    table.insert(conns, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if not dragging then return end
        dragging = false
        if options.onRelease then
            task.spawn(options.onRelease, moved)
        end
    end))

    return function()
        for _, conn in ipairs(conns) do pcall(function() conn:Disconnect() end) end
    end, function() return moved end
end

-- Standard hover treatment shared by every control: brighten, glow, press.
local function attachHover(hit, visual, options)
    options = options or {}
    local glow = options.glow
    local baseStroke = options.stroke
    local hoverColor = options.hoverColor or shiftColor(visual.BackgroundColor3, 0.10)
    local baseColor = visual.BackgroundColor3
    local baseTransparency = options.baseTransparency
    if baseTransparency == nil then baseTransparency = visual.BackgroundTransparency end

    local hovered = false

    local function enter()
        hovered = true
        Anim.tween(visual, 0.16, {
            BackgroundColor3 = options.hoverColor or shiftColor(baseColor, 0.14),
            BackgroundTransparency = math.max(0, baseTransparency - 0.06),
        }, Anim.Ease.gentle)
        if glow then
            Anim.tween(glow, 0.2, { BackgroundTransparency = 1 - 0.28 * (0.35 + Theme.GlowIntensity * 0.65) }, Anim.Ease.gentle)
        end
        if baseStroke then
            Anim.tween(baseStroke, 0.18, { Color = Theme.Accent, Transparency = 0.45 }, Anim.Ease.gentle)
        end
        if options.onEnter then options.onEnter() end
    end

    local function leave()
        hovered = false
        Anim.tween(visual, 0.22, {
            BackgroundColor3 = baseColor,
            BackgroundTransparency = baseTransparency,
        }, Anim.Ease.gentle)
        if glow then
            Anim.tween(glow, 0.25, { BackgroundTransparency = 1 }, Anim.Ease.gentle)
        end
        if baseStroke then
            Anim.tween(baseStroke, 0.2, { Transparency = options.strokeTransparency or 0.7,
                Color = options.strokeColor or Theme.Border }, Anim.Ease.gentle)
        end
        if options.onLeave then options.onLeave() end
    end

    table.insert(State.Connections, hit.MouseEnter:Connect(enter))
    table.insert(State.Connections, hit.MouseLeave:Connect(leave))
    table.insert(State.Connections, hit.MouseButton1Down:Connect(function()
        Anim.tween(visual, 0.09, { Size = options.pressSize or UDim2.new(
            visual.Size.X.Scale * 0.94, visual.Size.X.Offset * 0.94,
            visual.Size.Y.Scale * 0.94, visual.Size.Y.Offset * 0.94
        ) }, Anim.Ease.gentle)
    end))
    table.insert(State.Connections, hit.MouseButton1Up:Connect(function()
        Anim.tween(visual, 0.2, { Size = options.restSize or visual:GetAttribute("RestSize") or visual.Size },
            Anim.Ease.spring)
    end))

    visual:SetAttribute("RestSize", visual.Size)

    return { enter = enter, leave = leave, isHovered = function() return hovered end }
end

-- ═══════════════════════════════════════════════════════════════════════════
--  MINIMISED PILL  —  "Show NC"
-- ═══════════════════════════════════════════════════════════════════════════

local ShowPill = {}
ShowPill.__index = ShowPill

local PILL_WIDTH = 142

function ShowPill.new(gui, onRestore)
    local self = setmetatable({}, ShowPill)

    self.root = Build.frame(gui, {
        name = "NC_ShowPill",
        size = UDim2.fromOffset(PILL_WIDTH, 38),
        position = UDim2.new(0.5, 0, 0, -60),
        anchor = Vector2.new(0.5, 0),
        transparency = 1,
        zindex = 300,
    })
    self.root.BackgroundTransparency = 1
    self.root.ClipsDescendants = false

    -- glow halo, sits behind and pulses
    self.halo = Build.frame(self.root, {
        name = "Halo",
        size = UDim2.new(1, 26, 1, 22),
        position = UDim2.fromScale(0.5, 0.5),
        anchor = Vector2.new(0.5, 0.5),
        transparency = 1,
        zindex = 0,
    })
    self.halo.BackgroundColor3 = Theme.Accent
    self.halo.BackgroundTransparency = 1
    Build.corner(self.halo, 999)

    self.body = Build.frame(self.root, {
        name = "Body",
        size = UDim2.fromScale(1, 1),
        transparency = 1,
        zindex = 2,
    })
    self.body.BackgroundColor3 = Theme.BackgroundSecondary
    self.body.BackgroundTransparency = 1
    Build.corner(self.body, 999)

    self.gradient = Build.gradient(self.body, seq(
        shiftColor(Theme.Accent, -0.62),
        shiftColor(Theme.Accent, -0.86)
    ), 0)

    self.stroke = Build.stroke(self.body, Theme.Accent, 1, 1)

    -- inner sheen that drifts
    self.sheen = Build.frame(self.body, {
        name = "Sheen",
        size = UDim2.new(0, 60, 1, -2),
        position = UDim2.new(0, -60, 0, 1),
        transparency = 1,
        zindex = 3,
    })
    self.sheen.BackgroundColor3 = Theme.AccentSoft
    self.sheen.BackgroundTransparency = 1
    Build.corner(self.sheen, 999)

    local content = Build.frame(self.root, {
        name = "Content",
        size = UDim2.fromScale(1, 1),
        transparency = 1,
        zindex = 5,
    })
    content.BackgroundTransparency = 1
    self.content = content

    local iconHolder = Build.frame(content, {
        name = "IconHolder",
        size = UDim2.fromOffset(18, 18),
        position = UDim2.new(0, 15, 0.5, 0),
        anchor = Vector2.new(0, 0.5),
        transparency = 1,
        zindex = 6,
    })
    iconHolder.BackgroundTransparency = 1
    self.spark = Glyph.new(iconHolder, "sparkle", 18, Theme.AccentSoft, 0, 1.7, true)

    self.label = Build.text(content, {
        name = "Label",
        text = "Show NC",
        size = UDim2.new(1, -46, 1, 0),
        position = UDim2.new(0, 38, 0, 0),
        font = Enum.Font.GothamBold,
        textSize = 13,
        color = Theme.Text,
        xalign = Enum.TextXAlignment.Left,
        transparency = 1,
        zindex = 6,
    })

    -- drifting particles hugging the pill edge
    self.particleConn = select(2, Build.particles(self.root, 10, Theme.AccentSoft, {
        minSize = 1, maxSize = 2, drift = 0.3, zindex = 4, corner = 999,
    }))

    -- The pill is dragged by the clamped makeDraggable below, which moves the
    -- ROOT. Native Draggable is deliberately NOT used here: it moves whichever
    -- frame it is set on, so on this full-size hitbox it slid the invisible
    -- hitbox around inside the pill instead of moving the pill. Putting it on
    -- the root would not help either, because the hitbox covers the root and
    -- consumes the press before the root ever sees it. Clamping also matters
    -- for something this small, which native dragging cannot do.
    self.root.Active = true

    local hit = Build.hitbox(self.root, { zindex = 40 })
    hit.Active = true
    hit.AutoButtonColor = false
    self.hit = hit

    -- Dragging is OPT-IN.
    --
    -- The pill is both the restore button and, previously, its own drag handle.
    -- That meant a slightly imprecise click moved it, and once moved it stayed
    -- wherever it was dropped -- which is what made it look like it teleported
    -- out of nowhere. Off unless Theme.PillDraggable is set.
    self.disconnectDrag = nil

    function self:setDraggable(enabled)
        if enabled then
            if self.disconnectDrag then return end
            self.disconnectDrag = makeDraggable(hit, self.root, {
                clamp = true,
                onRelease = function() end,
            })
        elseif self.disconnectDrag then
            pcall(self.disconnectDrag)
            self.disconnectDrag = nil
        end
    end

    self:setDraggable(Theme.PillDraggable == true)

    local pressOrigin, pressMoved = nil, false
    -- Use InputEnded instead of MouseButton1Click. A drag can suppress the
    -- click event, which previously made the pill disappear without restoring
    -- the window when the user held and released it.

    table.insert(State.Connections, hit.MouseEnter:Connect(function()
        Anim.tween(self.body, 0.2, { BackgroundTransparency = math.max(0, 0.06 - Theme.Transparency) }, Anim.Ease.gentle)
        Anim.tween(self.stroke, 0.2, { Transparency = 0.1 }, Anim.Ease.gentle)
        Anim.tween(self.root, 0.24, {
            Size = UDim2.fromOffset(PILL_WIDTH + 10, 41),
        }, Anim.Ease.spring)
        Anim.tween(self.halo, 0.24, { BackgroundTransparency = 1 - 0.34 * (0.4 + Theme.GlowIntensity * 0.6) }, Anim.Ease.gentle)
    end))

    table.insert(State.Connections, hit.MouseLeave:Connect(function()
        Anim.tween(self.body, 0.24, { BackgroundTransparency = math.max(0, 0.16 - Theme.Transparency) }, Anim.Ease.gentle)
        Anim.tween(self.stroke, 0.24, { Transparency = 0.3 }, Anim.Ease.gentle)
        Anim.tween(self.root, 0.3, { Size = UDim2.fromOffset(PILL_WIDTH, 38) }, Anim.Ease.spring)
        Anim.tween(self.halo, 0.28, { BackgroundTransparency = 1 - 0.16 * (0.4 + Theme.GlowIntensity * 0.6) }, Anim.Ease.gentle)
    end))

    -- Restore on click, but not when the press was actually a drag. The pill is
    -- both the drag handle and the restore button, so we track how far the
    -- pointer travelled between down and up and only treat a near-stationary
    -- press as a click.
    --
    -- Order of events on a real click: MouseButton1Down -> ... -> MouseButton1Up
    -- -> MouseButton1Click. So pressMoved must survive until the click handler
    -- has run; we clear pressOrigin on Up (to stop the global move listener
    -- doing work when nothing is held) but reset pressMoved at the start of the
    -- next Down instead.
    table.insert(State.Connections, hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            pressOrigin = input.Position
            pressMoved = false
        end
    end))

    table.insert(State.Connections, UserInputService.InputChanged:Connect(function(input)
        if not pressOrigin then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        -- Only a real drag suppresses the restore. With dragging switched off
        -- the pill cannot move, so any pointer travel is incidental and must
        -- not swallow the click.
        if not self.disconnectDrag then return end
        local d = input.Position - pressOrigin
        if math.abs(d.X) > 4 or math.abs(d.Y) > 4 then
            pressMoved = true
        end
    end))

    table.insert(State.Connections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if not pressOrigin then return end
        local wasMoved = pressMoved
        pressOrigin = nil
        pressMoved = false
        if not self.visible or wasMoved then return end
        self:playPressFeedback()
        if onRestore then task.spawn(onRestore) end
    end))

    -- idle life: pulse the halo, drift the sheen, float the pill, spin the mark
    self.clock = 0
    self.spin = 0
    table.insert(State.Connections, RunService.RenderStepped:Connect(function(dt)
        if not self.root.Parent or not self.visible then return end
        self.clock = self.clock + dt
        self.spin = self.spin + dt

        local pulse = (math.sin(self.clock * 1.5) + 1) / 2
        self.halo.BackgroundTransparency = 1 - (0.10 + pulse * 0.14) * (0.35 + Theme.GlowIntensity * 0.65)
        self.halo.Size = UDim2.new(1, 22 + pulse * 10, 1, 18 + pulse * 8)

        local sheenX = ((self.clock * 0.22) % 1.6) - 0.3
        self.sheen.Position = UDim2.new(sheenX, 0, 0, 1)

        self.content.Position = UDim2.new(0, 0, 0, math.sin(self.clock * 1.1) * 1.6)

        if self.spark and self.spark.Parent then
            self.spark.Rotation = math.sin(self.spin * 0.7) * 12
        end
    end))

    -- Hidden until minimise. self.visible alone was not enough: the root frame
    -- defaults to Visible = true, so the pill rendered over the loading screen
    -- the moment it was constructed.
    self.visible = false
    self.root.Visible = false
    return self
end

function ShowPill:playPressFeedback()
    Anim.tween(self.root, 0.1, {
        Size = UDim2.fromOffset(PILL_WIDTH * 0.9, 38 * 0.9),
    }, Anim.Ease.gentle)
    Anim.tween(self.halo, 0.1, { BackgroundTransparency = 0.05 }, Anim.Ease.gentle)
    task.delay(0.13, function()
        Anim.tween(self.root, 0.26, { Size = UDim2.fromOffset(PILL_WIDTH, 38) }, Anim.Ease.spring)
    end)
end

-- Drops in from above the top edge with a spring.
function ShowPill:show()
    if self.visible then return end
    self.visible = true
    self.root.Visible = true
    self.root.Position = UDim2.new(0.5, 0, 0, -60)
    self.body.BackgroundTransparency = 1
    self.stroke.Transparency = 1
    self.label.TextTransparency = 1
    self.halo.BackgroundTransparency = 1

    Anim.tween(self.root, 0.6, { Position = UDim2.new(0.5, 0, 0, 18) }, Anim.Ease.spring)
    Anim.tween(self.body, 0.42, { BackgroundTransparency = math.max(0, 0.16 - Theme.Transparency) }, Anim.Ease.soft)
    Anim.tween(self.stroke, 0.42, { Transparency = 0.3 }, Anim.Ease.soft)
    Anim.tween(self.label, 0.42, { TextTransparency = 0 }, Anim.Ease.soft)
    Anim.tween(self.halo, 0.5, { BackgroundTransparency = 1 - 0.16 * (0.4 + Theme.GlowIntensity * 0.6) }, Anim.Ease.soft)
end

-- Lifts back above the top edge and fades.
function ShowPill:hide(onDone)
    if not self.visible then
        if onDone then onDone() end
        return
    end
    self.visible = false

    Anim.tween(self.root, 0.36, { Position = UDim2.new(0.5, 0, 0, -60) }, Anim.Ease.soft, Anim.Dir.inward)
    Anim.tween(self.body, 0.3, { BackgroundTransparency = 1 }, Anim.Ease.soft, Anim.Dir.inward)
    Anim.tween(self.stroke, 0.3, { Transparency = 1 }, Anim.Ease.soft, Anim.Dir.inward)
    Anim.tween(self.label, 0.3, { TextTransparency = 1 }, Anim.Ease.soft, Anim.Dir.inward)
    Anim.tween(self.halo, 0.3, { BackgroundTransparency = 1 }, Anim.Ease.soft, Anim.Dir.inward)

    task.delay(0.38, function()
        self.root.Visible = false
        if onDone then onDone() end
    end)
end

function ShowPill:setText(text)
    self.label.Text = text
end

function ShowPill:recolour()
    self.halo.BackgroundColor3 = Theme.Accent
    self.body.BackgroundColor3 = Theme.BackgroundSecondary
    self.stroke.Color = Theme.Accent
    self.gradient.Color = seq(shiftColor(Theme.Accent, -0.62), shiftColor(Theme.Accent, -0.86))
    self.gradient.Enabled = Theme.GradientMode
    self.sheen.BackgroundColor3 = Theme.AccentSoft
    self.label.TextColor3 = Theme.Text
end

function ShowPill:destroy()
    if self.particleConn then pcall(function() self.particleConn:Disconnect() end) end
    if self.disconnectDrag then pcall(self.disconnectDrag) end
    self.root:Destroy()
end

