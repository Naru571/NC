    -- building it earlier parented the card to nil, so pressing the button
    -- appeared to do nothing.
    ----------------------------------------------------------------------
    self:buildPlayerInfo()

    ----------------------------------------------------------------------
    -- settings panel host, filled lazily
    ----------------------------------------------------------------------
    self.settingsPanel = nil

    ----------------------------------------------------------------------
    -- top-right controls
    --
    -- buildControls was defined but never invoked, so the window shipped with
    -- no search / settings / minimise / close buttons at all. It must run after
    -- the header exists (it parents into self.controls) and before bindSearch,
    -- which reaches for self.searchButton.
    ----------------------------------------------------------------------
    self:buildControls()

    ----------------------------------------------------------------------
    -- macOS-style traffic lights
    --
    -- Runs after buildControls: setTrafficLights parks the X and minimise
    -- buttons, so they have to exist first. It reads Theme.TrafficLights, which
    -- applySnapshot may already have set from a saved config.
    ----------------------------------------------------------------------
    self:buildTrafficLights()

    ----------------------------------------------------------------------
    -- layout listeners
    --
    -- State.LayoutListeners was populated by the dropdown (so an open popup
    -- follows the page as it scrolls) but nothing ever invoked it, so the
    -- callbacks never ran. Pumping them each frame is cheap: each one bails
    -- immediately unless its dropdown is actually open.
    ----------------------------------------------------------------------
    table.insert(self.connections, RunService.RenderStepped:Connect(function()
        if not self.root.Parent then return end
        for _, fn in ipairs(State.LayoutListeners) do
            pcall(fn)
        end
    end))

    -- Theme controls can emit many updates during one drag. Queue one repaint
    -- for the next render frame instead of walking every descendant for every
    -- pointer sample. This keeps colour, transparency, glow and corner sliders
    -- responsive on both desktop and mobile.
    table.insert(accentListeners, function()
        self:queueRecolour()
    end)

    return self
end

