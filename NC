    list.FillDirection = Enum.FillDirection.Vertical
    list.SortOrder = Enum.SortOrder.LayoutOrder
    list.Padding = UDim.new(0, 8)
    list.Parent = scroller

    -- Reuse the Section class, pointed at the panel scroller.
    local settingsSection = setmetatable({
        contentHolder = scroller,
        title = "Settings",
        baseTransparency = 0.4,
        elements = {},
    }, { __index = Section })

    settingsSection.addElement = function() end

    local settingsTab = { name = "Settings", window = self, sections = {} }
    -- Settings elements use the same registration/search path as normal tabs.
    -- Without this, registerElement tried to read settingsSection.tab.name and
    -- aborted the build before configs and behaviour were created.
    settingsSection.tab = settingsTab

    ----------------------------------------------------------------------
    -- heading
    ----------------------------------------------------------------------
    local head = Build.frame(scroller, {
        name = "Head",
        size = UDim2.new(1, 0, 0, 42),
        transparency = 1,
        zindex = 702,
    })
    head.BackgroundTransparency = 1

    Build.text(head, {
        name = "Title",
