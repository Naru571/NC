local function hex(str)
    str = str:gsub("#", "")
    return Color3.fromRGB(
        tonumber(str:sub(1, 2), 16),
        tonumber(str:sub(3, 4), 16),
        tonumber(str:sub(5, 6), 16)
    )
end

local function seq(a, b) return ColorSequence.new(a, b) end
local function numSeq(a, b) return NumberSequence.new(a, b) end

local function interpolate(a, b, alpha)
    if typeof(a) == "Color3" then
        return a:Lerp(b, alpha)
    elseif typeof(a) == "ColorSequence" then
        local keypoints = {}
        local count = math.max(#a.Keypoints, #b.Keypoints)
        for i = 1, count do
            local ka = a.Keypoints[math.min(i, #a.Keypoints)]
            local kb = b.Keypoints[math.min(i, #b.Keypoints)]
            table.insert(keypoints, ColorSequenceKeypoint.new(
                ka.Time + (kb.Time - ka.Time) * alpha,
                ka.Value:Lerp(kb.Value, alpha)
            ))
        end
        return ColorSequence.new(keypoints)
    elseif typeof(a) == "NumberSequence" then
        local keypoints = {}
        local count = math.max(#a.Keypoints, #b.Keypoints)
        for i = 1, count do
            local ka = a.Keypoints[math.min(i, #a.Keypoints)]
            local kb = b.Keypoints[math.min(i, #b.Keypoints)]
            table.insert(keypoints, NumberSequenceKeypoint.new(
                ka.Time + (kb.Time - ka.Time) * alpha,
                ka.Value + (kb.Value - ka.Value) * alpha
            ))
        end
        return NumberSequence.new(keypoints)
    elseif typeof(a) == "UDim" then
        return UDim.new(a.Scale + (b.Scale - a.Scale) * alpha, a.Offset + (b.Offset - a.Offset) * alpha)
    elseif type(a) == "number" then
        return a + (b - a) * alpha
    end
    return b
end

