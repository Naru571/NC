-- Assigned (not declared) so it binds to the forward declaration at the top.
Section = {}
Section.__index = Section

function Section.new(tab, props)
    local self = setmetatable({}, Section)
    props = props or {}

    self.tab = tab
    self.title = props.name or props.Name or props.title or ""
    self.description = props.description or props.Description or ""
    self.icon = props.icon or props.Icon
    self.collapsed = false
    self.elements = {}

    local hasHeader = self.title ~= "" or self.description ~= ""

    self.shell = Build.frame(tab.page, {
        name = "Section_" .. self.title,
        size = UDim2.new(1, 0, 0, 0),
        transparency = 1,
        zindex = 4,
    })
    self.shell.BackgroundColor3 = Theme.BackgroundSecondary
    self.baseTransparency = math.max(0, 0.45 + Theme.Transparency)
    self.shell.BackgroundTransparency = self.baseTransparency
    self.baseTransparency = self.shell.BackgroundTransparency
    self.corner = Build.corner(self.shell, Theme.Corner)
    self.stroke = Build.stroke(self.shell, Theme.Border, 1, 0.65)

    local layout = Instance.new("UIListLayout")
    layout.FillDirection = Enum.FillDirection.Vertical
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 6)
    layout.Parent = self.shell

    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 12)
    pad.PaddingBottom = UDim.new(0, 12)
    pad.PaddingLeft = UDim.new(0, 13)
    pad.PaddingRight = UDim.new(0, 13)
    pad.Parent = self.shell

    -- AutomaticSize is a *property*, not a creatable instance. Calling
    -- Instance.new("AutomaticSize") throws "Unable to create an Instance of
    -- type AutomaticSize" and aborts the entire loading stage.
    self.shell.AutomaticSize = Enum.AutomaticSize.Y
    self.shell.Size = UDim2.new(1, 0, 0, 0)

    if hasHeader then
        local headerRow = Build.frame(self.shell, {
            name = "SectionHeader",
            size = UDim2.new(1, 0, 0, self.description ~= "" and 34 or 20),
            transparency = 1,
            zindex = 5,
        })
        headerRow.BackgroundTransparency = 1

        local textOffset = 0
        if self.icon then
            local iconHolder = Build.frame(headerRow, {
                size = UDim2.fromOffset(16, 16),
                position = UDim2.new(0, 0, 0, 2),
                transparency = 1,
                zindex = 6,
            })
            iconHolder.BackgroundTransparency = 1
            local resolved = normaliseAsset(self.icon)
            if resolved then
                local img = Instance.new("ImageLabel")
                img.BackgroundTransparency = 1
                img.Size = UDim2.fromScale(1, 1)
                img.Image = resolved
                img.Visible = false
                img.Parent = iconHolder
                img.Loaded:Connect(function() img.Visible = true end)
            else
                Glyph.new(iconHolder, Glyph.resolve(self.icon, "grid"),
                    15, Theme.Accent, 0.15, 1.5, false)
            end
            textOffset = 24
        end

        Build.text(headerRow, {
            name = "Title",
            text = self.title,
            size = UDim2.new(1, -textOffset, 0, 17),
            position = UDim2.new(0, textOffset, 0, 0),
            font = Enum.Font.GothamBold,
            textSize = 13,
            color = Theme.Text,
            zindex = 6,
            truncate = Enum.TextTruncate.AtEnd,
        })

        if self.description ~= "" then
            Build.text(headerRow, {
                name = "Description",
                text = self.description,
                size = UDim2.new(1, -textOffset, 0, 15),
                position = UDim2.new(0, textOffset, 0, 17),
                font = Enum.Font.Gotham,
                textSize = 11,
                color = Theme.SubText,
                zindex = 6,
                truncate = Enum.TextTruncate.AtEnd,
            })
        end
    end

    self.contentHolder = self.shell

    return self
end

function Section:addElement(handle, searchMetadata)
    if not handle then return end
    table.insert(self.elements, handle)

    if searchMetadata then
        searchMetadata.tab = self.tab
        searchMetadata.section = self
        searchMetadata.element = handle
        table.insert(self.tab.window.searchIndex, searchMetadata)
    end

    if handle.__container then
        table.insert(self.tab.window.searchIndex, handle.__container)
    end
end

function Section:recolour()
    if not self.shell or not self.shell.Parent then return end
    self.shell.BackgroundColor3 = Theme.BackgroundSecondary
    self.stroke.Color = Theme.Border
    self.corner.CornerRadius = UDim.new(0, Theme.Corner)
end

