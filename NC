-- Removes a card from the queue and re-flows the rest.
local function unregisterNotification(card)
    local queue = State.NotifyQueue
    if not queue then return end
    for index = #queue, 1, -1 do
        if queue[index].card == card then
            queue[index].dead = true
            table.remove(queue, index)
        end
    end
    refreshNotifyQueue()
end

--[[
    Notify({ Title, Content, Type, Duration, Icon })

    Types: "success" | "info" | "warning" | "error"  (default "info")
    Duration defaults to a length derived from the copy: 3s for a short line,
    up to 9s when there is a body paragraph to read.
]]
function LIBRARY:Notify(props)
    if State.Destroyed then return end
    props = props or {}
    -- Rayfield spells the notification icon `Image`. Accept every alias so
    -- scripts written against that API work unchanged.
    props.Icon = props.Icon or props.icon or props.Image or props.image
    local kind = NOTIFY_TYPES[props.Type or props.type or "info"] or NOTIFY_TYPES.info
    local stack = ensureNotifyStack()
    local host = State.Gui or gethui()

    local title = props.Title or props.title or ""
    local content = props.Content or props.content or props.Description or props.description or ""
    local accent = kind.color()
    local glowAmount = Theme.GlowIntensity

    local duration = props.Duration or props.duration
    if not duration then
        local length = #title + #content
        duration = math.clamp(2.6 + length / 26, 3, 9)
    end

    local card = Build.frame(stack, {
        name = "Notification",
        size = UDim2.new(1, 0, 0, content ~= "" and 66 or 52),
        transparency = 1,
        zindex = 201,
    })
    card.BackgroundColor3 = Theme.BackgroundSecondary
    card.BackgroundTransparency = 1
    card.ClipsDescendants = false

    local corner = Build.corner(card, Theme.Corner)
    local gradient = Build.gradient(card, seq(Theme.BackgroundTertiary, Theme.Background))

    local stroke = Build.stroke(card, accent, 1, 1)
    local accentGlow = Build.frame(card, {
        name = "AccentGlow",
        size = UDim2.new(0, 3, 1, -16),
        position = UDim2.new(0, 0, 0.5, 0),
        anchor = Vector2.new(0, 0.5),
        transparency = 1,
        zindex = 3,
    })
    accentGlow.BackgroundColor3 = Theme.Background
    accentGlow.BackgroundTransparency = 1
    Build.corner(accentGlow, 2)
    accentGlow.BackgroundColor3 = accent
    accentGlow.BackgroundTransparency = 1

    local iconHost = Build.frame(card, {
        name = "IconHost",
        size = UDim2.fromOffset(30, 30),
        position = UDim2.new(0, 14, 0.5, 0),
        anchor = Vector2.new(0, 0.5),
        transparency = 1,
        zindex = 4,
    })
    iconHost.BackgroundColor3 = accent
    iconHost.BackgroundTransparency = 0.86
    Build.corner(iconHost, 9)

    if props.Icon or props.icon then
        local custom = tostring(props.Icon or props.icon)
        local resolved = normaliseAsset(custom)
        if resolved then
            local img = Instance.new("ImageLabel")
            img.BackgroundTransparency = 1
            img.Size = UDim2.fromScale(1, 1)
            img.Image = resolved
            img.Parent = iconHost
            img.Visible = false
            img.Loaded:Connect(function() img.Visible = true end)
            task.delay(2, function()
                if img.Parent and not img.IsLoaded then
                    img:Destroy()
                    Glyph.new(iconHost, kind.glyph, 17, accent, 0, nil, false)
                end
            end)
        else
            Glyph.new(iconHost, kind.glyph, 17, accent, 0, nil, false)
        end
    else
        Glyph.new(iconHost, kind.glyph, 17, accent, 0, nil, false)
    end

    local textLeft = 56
    local titleLabel = Build.text(card, {
        name = "Title",
        text = title,
        size = UDim2.new(1, -(textLeft + 16), 0, 18),
        position = UDim2.new(0, textLeft, 0, content ~= "" and 15 or 17),
        font = Enum.Font.GothamBold,
        textSize = 13,
        color = Theme.Text,
        zindex = 5,
        truncate = Enum.TextTruncate.AtEnd,
    })

    if content ~= "" then
        Build.text(card, {
            name = "Content",
            text = content,
            size = UDim2.new(1, -(textLeft + 16), 0, 28),
            position = UDim2.new(0, textLeft, 0, 32),
            font = Enum.Font.Gotham,
            textSize = 12,
            color = Theme.SubText,
            wrapped = true,
            zindex = 5,
            yalign = Enum.TextYAlignment.Top,
        })
    end

    local progress = Build.frame(card, {
        name = "ProgressTrack",
        size = UDim2.new(1, -32, 0, 3),
        position = UDim2.new(0, 16, 1, -10),
        transparency = 1,
        zindex = 5,
    })
    progress.BackgroundColor3 = Theme.BackgroundTertiary
    progress.BackgroundTransparency = 0.28
    Build.corner(progress, 2)

    local progressFill = Build.frame(progress, {
        name = "ProgressFill",
        size = UDim2.fromScale(1, 1),
        transparency = 1,
        zindex = 6,
    })
    progressFill.BackgroundColor3 = accent
    progressFill.BackgroundTransparency = 0.02
    Build.corner(progressFill, 2)

    -- Entrance: slide from the right and fade in together.
    card.Position = UDim2.new(0, 46, 0, 0)
    Anim.tween(card, 0.34, { Position = UDim2.new(0, 0, 0, 0) },
        Anim.Ease.spring, Anim.Dir.out)
    Anim.tween(stroke, 0.34, { Transparency = 0.72 }, Anim.Ease.soft)
    Anim.tween(accentGlow, 0.4, { BackgroundTransparency = 1 - math.min(0.95, 0.55 * (glowAmount + 0.4)) }, Anim.Ease.soft)
    -- UIGradient.Transparency is a NumberSequence, never a number. TweenService
    -- rejects a scalar here at Create() time with "NumberSequence expected, got
    -- number", so the whole notification used to throw on entry. Fade the card's
    -- own solid fill instead and leave the gradient to supply its colour.
    Anim.tween(card, 0.34, { BackgroundTransparency = Theme.Transparency },
        Anim.Ease.soft)
    Anim.tween(titleLabel, 0.3, { TextTransparency = 0 })

    Anim.tween(progressFill, duration, { Size = UDim2.fromScale(0, 1) }, Anim.Ease.linear, Anim.Dir.out)

    local dismissed = false
    local dismiss
    dismiss = function()
        if dismissed then return end
        dismissed = true
        -- Leave the queue first so the stack re-flows immediately rather than
        -- after the 0.28s exit animation.
        unregisterNotification(card)
        Anim.tween(card, 0.26, { Position = UDim2.new(0, 46, 0, 0), BackgroundTransparency = 1 }, Anim.Ease.soft, Anim.Dir.inward)
        Anim.tween(stroke, 0.26, { Transparency = 1 }, Anim.Ease.soft, Anim.Dir.inward)
        Anim.tween(iconHost, 0.26, { BackgroundTransparency = 1 }, Anim.Ease.soft, Anim.Dir.inward)
        task.delay(0.28, function()
            if card then card:Destroy() end
        end)
    end

    task.delay(duration, dismiss)

    local hit = Build.hitbox(card, { zindex = 10 })
    hit.MouseButton1Click:Connect(dismiss)
    -- Keep the stack usable even if a custom icon asset failed to load.
    if not card.Parent then return { dismiss = function() end, frame = nil } end

    table.insert(State.NotifyQueue, { card = card, dismiss = dismiss })
    refreshNotifyQueue()

    return { dismiss = dismiss, frame = card }
end

function LIBRARY:Toast(props)
    props = props or {}
    local label = props.Title or props.title or ""
    local sub = props.Subtitle or props.subtitle or ""
    return LIBRARY:Notify({
        Title = label,
        Content = sub,
        Type = props.Type or props.type or "info",
        Duration = props.Duration or 2.4,
        Icon = props.Icon or props.icon,
    })
end

