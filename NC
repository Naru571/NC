--  GLOBAL FEATURE SEARCH
-- ═══════════════════════════════════════════════════════════════════════════

local SEARCH_RESULT_HEIGHT = 46
local SEARCH_MAX_RESULTS = 8

-- Lower score sorts first. Exact prefix beats word-boundary beats substring.
local function scoreMatch(keywords, name, query)
    if query == "" then return 0 end
    local lname = (name or ""):lower()

    local start = lname:find(query, 1, true)
    if start == 1 then return 1 end
    if start and start > 1 then
        local before = lname:sub(start - 1, start - 1)
        if before == " " or before == "-" or before == "_" then return 2 end
        return 4
    end

    local kstart = keywords:find(query, 1, true)
    if kstart then return 6 end
    return nil
end

-- Scores every query term and keeps the worst (all terms must match).
local function scoreEntry(entry, terms)
    if #terms == 0 then return 0 end
    local total = 0
    for _, term in ipairs(terms) do
        local scored = scoreMatch(entry.keywords or "", entry.name, term)
        if not scored then return nil end
        total = total + scored
    end
    return total
end

function Window:buildSearchResults()
    if self.searchResults then return self.searchResults end

    local panel = Build.frame(self.overlay, {
        name = "SearchResults",
        size = UDim2.new(0, 320, 0, 0),
        transparency = 1,
        zindex = 600,
        visible = false,
    })
    panel.BackgroundColor3 = Theme.BackgroundSecondary
    panel.BackgroundTransparency = 1
    panel.ClipsDescendants = true
    Build.corner(panel, 10)
    local panelStroke = Build.stroke(panel, Theme.AccentSoft, 1, 1)

    local layout = Instance.new("UIListLayout")
    layout.FillDirection = Enum.FillDirection.Vertical
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 1)
    layout.Parent = panel

    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 6)
    pad.PaddingBottom = UDim.new(0, 6)
    pad.PaddingLeft = UDim.new(0, 5)
    pad.PaddingRight = UDim.new(0, 5)
    pad.Parent = panel

    self.searchResults = panel
    self.searchResultsStroke = panelStroke
    self.searchResultButtons = {}
    return panel
end

-- Tears down the current result rows so a new query can rebuild them.
function Window:clearSearchResults()
    for _, button in ipairs(self.searchResultButtons or {}) do
        button:Destroy()
    end
    self.searchResultButtons = {}
end

-- Runs the query and paints the results list. Called on every keystroke.
function Window:runSearch(rawQuery)
    local panel = self:buildSearchResults()
    local query = (rawQuery or ""):lower():gsub("^%s+", ""):gsub("%s+$", "")

    self:clearSearchResults()

    -- Split on whitespace so "walk speed" matches a Walk Speed feature.
    local terms = {}
    for term in query:gmatch("%S+") do
        table.insert(terms, term)
    end

    if #terms == 0 then
        self:setSearchResultsOpen(false)
        return
    end

    local scored = {}
    for _, entry in ipairs(self.searchIndex) do
        -- Every result must still exist; sections can be destroyed at runtime.
        local alive = entry.section and entry.section.shell and entry.section.shell.Parent
        if alive then
            local score = scoreEntry(entry, terms)
            if score then
                table.insert(scored, { entry = entry, score = score })
            end
        end
    end

    table.sort(scored, function(a, b)
        if a.score == b.score then
            return (a.entry.name or "") < (b.entry.name or "")
        end
        return a.score < b.score
    end)

    local shown = math.min(#scored, SEARCH_MAX_RESULTS)

    if shown == 0 then
        local empty = Build.text(panel, {
            name = "NoResults",
            text = "No features match \"" .. query .. "\"",
            size = UDim2.new(1, 0, 0, 34),
            font = Enum.Font.Gotham,
            textSize = 11,
            color = Theme.MutedText,
            zindex = 610,
        })
        table.insert(self.searchResultButtons, empty)
        self:setSearchResultsOpen(true, 46)
        return
    end

    for index = 1, shown do
        local item = scored[index]
        local entry = item.entry

        local button = Build.button(panel, {
            name = "Result_" .. tostring(index),
            size = UDim2.new(1, 0, 0, SEARCH_RESULT_HEIGHT),
            transparency = 1,
            zindex = 605,
        })
        button.BackgroundColor3 = Theme.Accent
        button.BackgroundTransparency = 1
        Build.corner(button, 7)
        table.insert(self.searchResultButtons, button)

        -- Breadcrumb: Tab › Section
        local sectionName = entry.section and entry.section.title or ""
        local crumb = entry.tab and entry.tab.name or ""
        if sectionName ~= "" then
            crumb = crumb .. "  ›  " .. sectionName
        end

        Build.text(button, {
            name = "Feature",
            text = entry.name or "Feature",
            size = UDim2.new(1, -20, 0, 15),
            position = UDim2.fromOffset(11, 7),
            font = Enum.Font.GothamMedium,
            textSize = 12,
            color = Theme.Text,
            align = Enum.TextXAlignment.Left,
            zindex = 607,
            truncate = Enum.TextTruncate.AtEnd,
        })

        Build.text(button, {
            name = "Crumb",
            text = crumb,
            size = UDim2.new(1, -20, 0, 13),
            position = UDim2.fromOffset(11, 23),
            font = Enum.Font.Gotham,
            textSize = 10,
            color = Theme.MutedText,
            align = Enum.TextXAlignment.Left,
            zindex = 607,
            truncate = Enum.TextTruncate.AtEnd,
        })

        -- Kind chip on the right so a slider is distinguishable at a glance.
        local kindHolder = Build.frame(button, {
            name = "KindIcon",
            size = UDim2.fromOffset(13, 13),
            position = UDim2.new(1, -26, 0.5, 0),
            anchor = Vector2.new(0, 0.5),
            transparency = 1,
            zindex = 607,
        })
        kindHolder.BackgroundTransparency = 1
        local kindGlyph = ({
            toggle = "power",
            button = "bolt",
            slider = "grid",
            dropdown = "chevron",
            multi = "grid",
            input = "hash",
            paragraph = "info",
        })[entry.kind or ""] or "sparkle"
        Glyph.new(kindHolder, kindGlyph, 12, Theme.Accent, 0.35, 1.6, false)

        button.MouseEnter:Connect(function()
            Anim.tween(button, 0.16, { BackgroundTransparency = 0.88 }, Anim.Ease.soft)
        end)
        button.MouseLeave:Connect(function()
            Anim.tween(button, 0.16, { BackgroundTransparency = 1 }, Anim.Ease.soft)
        end)
        button.MouseButton1Click:Connect(function()
            self:jumpToResult(entry)
        end)
    end

    local totalHeight = (shown * (SEARCH_RESULT_HEIGHT + 1)) + 12
    self:setSearchResultsOpen(true, totalHeight)
end

function Window:setSearchResultsOpen(open, height)
    local panel = self:buildSearchResults()

    if self._searchResultsOpen == open and not open then return end
    self._searchResultsOpen = open

    if open then
        local bar = self.searchBar
        -- Same overlay-relative correction as the dropdown panel: this panel is
        -- parented to self.overlay, so screen-space AbsolutePosition has to be
        -- rebased against the overlay's origin.
        local origin = self.overlay.AbsolutePosition
        panel.Position = UDim2.fromOffset(
            math.floor(bar.AbsolutePosition.X - origin.X),
            math.floor(bar.AbsolutePosition.Y + bar.AbsoluteSize.Y + 6 - origin.Y)
        )
        panel.Size = UDim2.new(0, math.floor(bar.AbsoluteSize.X), 0, panel.AbsoluteSize.Y)
        panel.Visible = true
        Anim.tween(panel, 0.28, {
            Size = UDim2.new(0, math.floor(bar.AbsoluteSize.X), 0, height or 0),
            BackgroundTransparency = 0.02,
        }, Anim.Ease.out, Anim.Dir.out)
        Anim.tween(self.searchResultsStroke, 0.28, { Transparency = 0.5 }, Anim.Ease.soft)
    else
        Anim.tween(panel, 0.2, {
            Size = UDim2.new(0, panel.AbsoluteSize.X, 0, 0),
            BackgroundTransparency = 1,
        }, Anim.Ease.soft, Anim.Dir.inward)
        Anim.tween(self.searchResultsStroke, 0.2, { Transparency = 1 }, Anim.Ease.soft)
        task.delay(0.22, function()
            if not self._searchResultsOpen then panel.Visible = false end
        end)
    end
end

-- Closes search, switches tab, scrolls the section into view and flashes it.
function Window:jumpToResult(entry)
    local section = entry.section
    local tab = entry.tab
    if not section or not tab then return end

    self:hideSearch()

    -- switch tab
    if self.activeTab ~= tab then
        tab:select()
    end

    -- scroll the section into view once the tab transition has settled
    task.delay(self.activeTab == tab and 0.05 or 0.3, function()
        local page = tab.page
        if not page or not page.Parent then return end
        local target = section.shell
        if not target or not target.Parent then return end

        local y = target.AbsolutePosition.Y - page.AbsolutePosition.Y + page.CanvasPosition.Y
        local maxScroll = math.max(0, page.AbsoluteCanvasSize.Y - page.AbsoluteWindowSize.Y)
        y = math.clamp(y - 12, 0, maxScroll)

        local startY = page.CanvasPosition.Y
        local distance = y - startY
        local duration = 0.4
        local elapsed = 0

        local conn
        conn = RunService.RenderStepped:Connect(function(dt)
            elapsed = elapsed + dt
            local alpha = math.min(1, elapsed / duration)
            -- Quint ease-out, matching the rest of the library.
            local eased = 1 - ((1 - alpha) ^ 5)
            page.CanvasPosition = Vector2.new(page.CanvasPosition.X, startY + (distance * eased))
            if alpha >= 1 then
                conn:Disconnect()
            end
        end)
        table.insert(State.Connections, conn)
    end)

    self:flashSection(section)
end

-- Brief accent pulse on a section, so the eye can find it after a jump.
function Window:flashSection(section)
    if not section or not section.shell then return end
    local shell = section.shell
    local stroke = section.stroke
    if not stroke then return end

    local originalColor = Theme.Border
    stroke.Color = Theme.Accent
    stroke.Transparency = 0
    Anim.tween(shell, 0.24, { BackgroundTransparency = math.max(0, section.baseTransparency - 0.28) }, Anim.Ease.soft)
    Anim.tween(stroke, 0.24, { Transparency = 0 }, Anim.Ease.soft)

    task.delay(0.55, function()
        if not shell.Parent then return end
        Anim.tween(shell, 0.55, { BackgroundTransparency = section.baseTransparency }, Anim.Ease.soft)
        Anim.tween(stroke, 0.55, { Color = originalColor, Transparency = 0.65 }, Anim.Ease.soft)
    end)
end

-- Wires the search field up. Called once from Window.new.
function Window:bindSearch()
    self.searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        if not self.searchOpen then return end
        self:runSearch(self.searchBox.Text)
    end)

    self.searchBox.Focused:Connect(function()
        State.Typing = true
        if self.searchBox.Text ~= "" then
            self:runSearch(self.searchBox.Text)
        end
    end)

    self.searchBox.FocusLost:Connect(function()
        State.Typing = false
    end)

    self.searchClear.MouseButton1Click:Connect(function()
        self:hideSearch()
    end)

    -- Enter jumps to the top hit, which makes search usable by keyboard alone.
    self.searchBox:GetPropertyChangedSignal("Text"):Connect(function() end)
    table.insert(State.Connections, UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode ~= Enum.KeyCode.Return and input.KeyCode ~= Enum.KeyCode.KeypadEnter then return end
        if not self.searchOpen then return end
        if self.searchResultButtons and self.searchResultButtons[1]
            and self.searchResultButtons[1].Name:sub(1, 7) == "Result_" then
            -- Re-run to get the ordered list, then jump to the best match.
            local query = self.searchBox.Text
            if query == "" then return end
            local terms = {}
            for term in query:lower():gmatch("%S+") do table.insert(terms, term) end
            local best, bestScore
            for _, entry in ipairs(self.searchIndex) do
                local alive = entry.section and entry.section.shell and entry.section.shell.Parent
                if alive then
                    local score = scoreEntry(entry, terms)
                    if score and (not bestScore or score < bestScore) then
                        best, bestScore = entry, score
                    end
                end
            end
            if best then self:jumpToResult(best) end
        end
    end))
end

