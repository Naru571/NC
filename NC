-- Human-readable name for a key, used by the settings button.
function LIBRARY:keyLabel(key)
    if typeof(key) ~= "EnumItem" then return "None" end
    return key.Name
end

-- Toggles dragging on the "Show NC" pill. Off by default.
function LIBRARY:setPillDraggable(enabled, silent)
    Theme.PillDraggable = enabled and true or false
    if State.ShowPill and State.ShowPill.setDraggable then
        State.ShowPill:setDraggable(Theme.PillDraggable)
    end
    if not silent then LIBRARY:queueAutoSave() end
end

--[[
    Shows or hides the macOS-style traffic lights in the header.

    Safe to call before the window exists -- applySnapshot reaches this during
    NC:Init, ahead of the build, so the value is recorded on Theme and the
    header reads it back when it is created.
]]
function LIBRARY:setTrafficLights(enabled, silent)
    Theme.TrafficLights = enabled and true or false

    local window = State.Window
    if window and window.setTrafficLights then
        window:setTrafficLights(Theme.TrafficLights, true)
    end

    if not silent then LIBRARY:queueAutoSave() end
end

-- Rebind the show/hide key. Accepts a KeyCode, or its name as a string.
function LIBRARY:setToggleKey(key, silent)
    if type(key) == "string" then
        key = Enum.KeyCode[key]
    end
    if typeof(key) ~= "EnumItem" then return false end
    State.ToggleKey = key
    if not silent then LIBRARY:queueAutoSave() end
    return true
end

--[[
    Waits for the next key press and binds it.

    Runs its own InputBegan rather than reading the bound key, so any key can be
    captured. Escape cancels, and the callback always fires so the settings
    button can refresh its label either way.
]]
function LIBRARY:captureToggleKey(onDone)
    if State.CapturingKey then return end
    State.CapturingKey = true

    local conn
    conn = UserInputService.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        if conn then conn:Disconnect() end
        State.CapturingKey = false

        if input.KeyCode ~= Enum.KeyCode.Escape then
            LIBRARY:setToggleKey(input.KeyCode)
        end
        if onDone then task.spawn(onDone, State.ToggleKey) end
    end)
    table.insert(State.Connections, conn)
end

local function bindHotkeys()
    table.insert(State.Connections, UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if State.Typing then return end
        -- Stand aside while the settings panel is waiting for a rebind.
        if State.CapturingKey then return end
        if not State.ToggleKey then return end
        if input.KeyCode ~= State.ToggleKey then return end

        local window = State.Window
        if not window then return end

        if State.Minimised then
            window:restore()
        elseif State.Open then
            window:close()
        else
            window:open()
        end
    end))
end

-- ── boot sequence ────────────────────────────────────────────────────────

function LIBRARY:Init(config)
    config = config or {}

    -- Accept the friendlier aliases. Window.new reads config.name, but callers
    -- (including the bundled example) pass `title`, so the supplied title was
    -- silently dropped in favour of the built-in default.
    config.name     = config.name or config.Name or config.title or config.Title
    config.subtitle = config.subtitle or config.Subtitle or config.LoadingSubtitle
    if config.autoLoadConfig then State.activeConfig = config.autoLoadConfig end

    -- Show/hide key. Accepts a KeyCode or its name ("N"). `toggleKey = false`
    -- disables the hotkey entirely for scripts that bind their own.
    if config.toggleKey ~= nil then
        if config.toggleKey == false then
            State.ToggleKey = nil
        else
            LIBRARY:setToggleKey(config.toggleKey, true)
        end
    end

    if State.Initialised and not config.allowRerun then
        warn("[NC] already initialised; call NC:Unload() first or pass allowRerun = true")
        return self
    end

    if not config.allowRerun then
        self:Unload()
    end

    State.Initialised = true

    -- Apply the persisted theme before anything is built, so the first frame
    -- is already the right colour instead of flashing purple.
    if config.accent then
        LIBRARY:setAccent(config.accent, true)
    end
    if config.gradientMode ~= nil then
        Theme.GradientMode = config.gradientMode and true or false
    end
    if config.transparency then Theme.Transparency = config.transparency end
    if config.scale then Theme.UIScale = config.scale end
    if config.corner then Theme.Corner = config.corner end
    if config.glow then Theme.GlowIntensity = config.glow end
    if config.animationSpeed then Theme.AnimationSpeed = config.animationSpeed end
    -- Opt in to dragging the "Show NC" pill. Off unless asked for.
    if config.pillDraggable ~= nil then
        Theme.PillDraggable = config.pillDraggable and true or false
    end

    -- Opt out of the macOS-style header dots. On unless turned off.
    if config.trafficLights ~= nil then
        Theme.TrafficLights = config.trafficLights and true or false
    end

    -- Pull the saved appearance in BEFORE the loading screen is built.
    --
    -- The config used to be restored in the final loading stage, which runs
    -- after the loader already exists -- so the loader always appeared in the
    -- default accent and then visibly switched to the user's colour. Every
    -- setter applySnapshot calls is guarded against a nil window, so this is
    -- safe this early.
    if config.autoLoad ~= false then
        local savedName = config.autoLoadConfig or State.activeConfig
        if savedName then
            local contents = safeRead(configPath(savedName))
            if contents then
                local ok, data = pcall(function() return HttpService:JSONDecode(contents) end)
                if ok and type(data) == "table" then
                    pcall(function() LIBRARY:applySnapshot(data) end)
                end
            end
        end
    end

    local gui = Instance.new("ScreenGui")
    gui.Name = config.guiName or FOLDER_NAME
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder = config.displayOrder or 999

    local parented = false
    if gethui then
        local ok, hub = pcall(gethui)
        if ok and hub then
            gui.Parent = hub
            parented = true
        end
    end
    if not parented and syn and syn.protect_gui then
        pcall(function() syn.protect_gui(gui) end)
    end
    if not parented then
        gui.Parent = game:GetService("CoreGui")
    end

    if config.protect and syn and syn.protect_gui then
        pcall(function() syn.protect_gui(gui) end)
    end

    State.Gui = gui
    table.insert(State.Instances, gui)

    local container = createScaleContainer(gui)

    -- The container must stay VISIBLE while loading.
    --
    -- It used to start hidden and only be revealed in the completion callback.
    -- But the loading screen is parented to this container, so hiding it hid
    -- the loading screen too -- the sequence ran invisibly and the UI simply
    -- popped in with no loading screen at all. The loading screen is opaque,
    -- full-screen and at ZIndex 500, so it covers the window while it runs and
    -- then cross-fades into the window's entrance.
    container.Visible = true

    ----------------------------------------------------------------------
    -- loading screen
    ----------------------------------------------------------------------
    local window

    -- The loading screen is parented to the ScreenGui, NOT to the scale
    -- container. Anything inside that container is multiplied by its UIScale,
    -- so at a scale below 1 the full-screen loading backdrop shrank into a
    -- smaller rounded box in the middle of the screen. Keeping it outside means
    -- it always covers, whatever the UI scale; only its content scales, which
    -- the screen handles itself.
    runLoadingSequence(gui, config, {
        -- Step 1 — build the shell while the bar creeps forward.
        {
            text = "Initializing interface...",
            run = function()
                window = Window.new(container, config)
                State.Window = window
                window:bindSearch()
                -- The pill was never constructed, so minimising simply made the
                -- window vanish with no way to bring it back.
                State.ShowPill = ShowPill.new(container, function()
                    window:restore()
                end)
            end,
        },

        -- Step 2 — tabs and their default content.
        {
            text = "Loading components...",
            run = function()
                -- Every later stage depends on stage 1 having produced a window.
                -- Without these guards a failure in stage 1 cascaded into four
                -- confusing "attempt to index nil" errors that buried the real
                -- cause, which is the single warning runLoadingSequence logs.
                if not window then return end
                local build = config.build or config.tabs
                if type(build) == "function" then
                    build(window)
                else
                    -- Declarative fallback: config.tabs as a list of props.
                    for _, tabProps in ipairs(type(build) == "table" and build or {}) do
                        window:CreateTab(tabProps)
                    end
                end
            end,
        },

        -- Step 3 — settings panel, warmed here so the first open is instant.
        {
            text = "Loading features...",
            run = function()
                if not window then return end
                window:buildSettings()
            end,
        },

        -- Step 4 — restore the auto-loaded config and apply the theme.
        {
            text = "Preparing UI...",
            run = function()
                if not window then return end
                if State.Config.autoLoad then
                    local name = config.autoLoadConfig or State.activeConfig
                    if name then
                        pcall(function() LIBRARY:loadConfig(name, true) end)
                        if window.colourPicker then
                            window.colourPicker.Set(window.colourPicker, Theme.Accent)
                        end
                    end
                end
                window:recolour()

                if config.autoSave then
                    State.Config.autoSave = true
                end
            end,
        },
    }, function()
        if not window then
            warn("[NC] the interface failed to build, so it cannot be shown. "
                .. "The real cause is the first 'loading stage failed' warning above.")
            return
        end

        window:open()
        State.Open = true

        if config.ready then
            task.spawn(config.ready, window)
        end

        if config.notifyOnLoad ~= false then
            LIBRARY:Notify({
                Title = "NC loaded",
                Content = "Press " .. LIBRARY:keyLabel(State.ToggleKey) .. " to toggle the interface",
                Type = "success",
                Duration = 4,
            })
        end
    end)

    bindHotkeys()

    return self
end

-- ── convenience wrappers used by feature scripts ─────────────────────────

function LIBRARY:Window()
    return State.Window
end

-- NC:Tab{ name = "Home", icon = "home" }
function LIBRARY:Tab(props)
    if not State.Window then
        warn("[NC] create the interface before adding tabs")
        return nil
    end
    return State.Window:CreateTab(props)
end

-- NC:Section(tab, { name = "Movement" })
function LIBRARY:Section(tab, props)
    if not tab then return nil end
    return tab:CreateSection(props)
end

function LIBRARY:Destroy()
    if State.Destroyed then return end
    State.Destroyed = true

    if State.ShowPill then
        pcall(function() State.ShowPill:destroy() end)
    end

    for _, conn in ipairs(State.Connections) do
        pcall(function() conn:Disconnect() end)
    end
    State.Connections = {}

    for _, inst in ipairs(State.Instances) do
        pcall(function() inst:Destroy() end)
    end
    State.Instances = {}

    if State.Gui then
        pcall(function() State.Gui:Destroy() end)
    end

    State.Window = nil
    State.ShowPill = nil
    State.Open = false
    State.Minimised = false
    State.Initialised = false

    -- Reset the glyph registry, otherwise recolour would walk dead frames.
    Glyph.registry = {}
    State.Elements = {}
    State.Flags = {}
end

-- ═══════════════════════════════════════════════════════════════════════════
--  PLUGIN API
--
--  Lets an external script add its own controls to Settings without editing this
--  file. Register a spec with a build(host) callback; `host` is a group inside
--  the settings panel, so it exposes the same constructors a Section does.
--
--      NC:RegisterPlugin({
--          name = "Auto Farm",
--          description = "Farming options",
--          build = function(host)
--              host:CreateToggle({ name = "Enabled", flag = "AutoFarm", callback = print })
--              host:CreateSlider({ name = "Radius", min = 1, max = 50, value = 10, flag = "FarmRadius" })
--          end,
--      })
--
--  Unregistering destroys the group and every control in it. Flags registered
--  through a plugin are saved and restored exactly like built-in ones.
-- ═══════════════════════════════════════════════════════════════════════════

State.Plugins = {}

-- Builds one plugin's group into the settings panel. Safe to call twice.
function LIBRARY:mountPlugin(plugin)
    local window = State.Window
    local host = window and window.settingsHost
    if not host then return false end
    if plugin.group and plugin.group.shell and plugin.group.shell.Parent then
        return true
    end

    local ok, group = pcall(function()
        -- Collapsed by default: a plugin should not push the built-in settings
        -- off the panel the moment it registers.
        return host:CreateGroup({ name = plugin.name, collapsed = true })
    end)
    if not ok or not group then
        warn("[NC] plugin '" .. tostring(plugin.name) .. "' could not mount: " .. tostring(group))
        return false
    end

    plugin.group = group

    local built, err = pcall(plugin.build, group)
    if not built then
        warn("[NC] plugin '" .. tostring(plugin.name) .. "' failed to build: " .. tostring(err))
    end
    return true
end

-- Mounts every plugin that is not already in the panel. Called by buildSettings
-- so plugins registered before the panel exists still appear.
function LIBRARY:mountAllPlugins()
    for _, plugin in pairs(State.Plugins) do
        LIBRARY:mountPlugin(plugin)
    end
end

--[[
    Registers a plugin.

    spec = {
        name        = "Auto Farm",       -- shown as the group title
        description = "...",             -- optional, currently unused in the UI
        build       = function(host) end -- required
    }

    Returns the plugin record, or nil (with a warning) if the spec is invalid or
    the name is taken.
]]
function LIBRARY:RegisterPlugin(spec)
    if type(spec) ~= "table" or type(spec.build) ~= "function" then
        warn("[NC] RegisterPlugin needs a table with a build(host) function")
        return nil
    end

    local name = tostring(spec.name or spec.Name or ("Plugin " .. tostring(#LIBRARY:listPlugins() + 1)))
    if State.Plugins[name] then
        warn("[NC] a plugin named '" .. name .. "' is already registered")
        return nil
    end

    local plugin = {
        name = name,
        description = spec.description or spec.Description or "",
        build = spec.build,
        group = nil,
    }
    State.Plugins[name] = plugin

    -- Settings may already be built; if so mount immediately rather than waiting
    -- for a rebuild that may never come.
    LIBRARY:mountPlugin(plugin)
    return plugin
end

function LIBRARY:UnregisterPlugin(name)
    local plugin = State.Plugins[name]
    if not plugin then return false end

    if plugin.group and plugin.group.shell then
        pcall(function() plugin.group.shell:Destroy() end)
    end
    State.Plugins[name] = nil
    return true
end

function LIBRARY:listPlugins()
    local out = {}
    for name, plugin in pairs(State.Plugins) do
        out[#out + 1] = {
            name = name,
            description = plugin.description,
            mounted = plugin.group ~= nil,
        }
    end
    table.sort(out, function(a, b) return a.name < b.name end)
    return out
end

-- Aliases, so both NC:Destroy() and NC:Unload() do the obvious thing.
LIBRARY.destroy = LIBRARY.Destroy
LIBRARY.Init = LIBRARY.Init

-- Expose the internals that feature scripts occasionally need.
LIBRARY.Theme = Theme
LIBRARY.State = State
LIBRARY.Glyph = Glyph
LIBRARY.Anim = Anim

-- ═══════════════════════════════════════════════════════════════════════════
--  RAYFIELD-STYLE API
--
--  Lets scripts written against Rayfield Gen2 run largely unchanged: Name,
--  Title, Flag, Callback, CurrentValue, Range, Increment, Options,
--  CurrentOption and MultipleOptions are all understood, and elements may be
--  created straight on a Tab (landing in its most recent section) rather than
--  on a Section.
-- ═══════════════════════════════════════════════════════════════════════════

-- Maps Rayfield's key names onto the ones the constructors here actually read.
-- Cross-checked against every constructor:
--   createRow        name / description / icon
--   CreateToggle     value / flag / callback
--   CreateSlider     min / max / step / value / suffix
--   CreateDropdown   options / default / multi / placeholder
--   CreateInput      placeholder / value / clearable
--   CreateParagraph  text / content / name
local function rayfieldProps(props)
    if type(props) ~= "table" then return props end

    -- Work on a copy so the caller's table is not rewritten underneath them.
    local p = {}
    for key, value in pairs(props) do p[key] = value end

    if p.name == nil then p.name = p.Name or p.Title end
    if p.description == nil then p.description = p.Description end
    if p.icon == nil then p.icon = p.Icon end
    if p.flag == nil then p.flag = p.Flag end
    if p.callback == nil then p.callback = p.Callback end

    if p.value == nil then p.value = p.CurrentValue end
    if p.text == nil then p.text = p.Text or p.Content end

    -- Slider
    if type(p.Range) == "table" then
        if p.min == nil then p.min = p.Range[1] end
        if p.max == nil then p.max = p.Range[2] end
    end
    if p.step == nil then p.step = p.Increment end

    -- Dropdown
    if p.options == nil then p.options = p.Options end
    if p.multi == nil then p.multi = p.MultipleOptions end
    if p.placeholder == nil then p.placeholder = p.PlaceholderText end
    if p.searchable == nil then p.searchable = p.Searchable end
    if p.default == nil then
        local current = p.CurrentOption
        -- Rayfield wraps even single-select values as {"x"}, so unwrap it --
        -- but ONLY for single-selects. A multi-select's table is the real set
        -- of chosen values (CreateDropdown iterates it with ipairs), so
        -- collapsing it to [1] would silently drop every other selection.
        if type(current) == "table" and not p.multi then current = current[1] end
        p.default = current
    end

    return p
end

-- Wraps a Section constructor so it accepts Rayfield's key names. Dropdown is
-- included even though it takes a positional (title, options, config) form as
-- well: rayfieldProps passes a non-table straight through, so that form still
-- works while the table form gains the aliases.
for _, method in ipairs({
    "CreateToggle", "CreateSwitch", "CreateButton", "CreateSlider",
    "CreateDropdown", "CreateMultiDropdown", "CreateDropdownMulti",
    "CreateInput", "CreateParagraph", "CreateLabel", "CreateDivider",
    "CreateGroup", "Dropdown",
}) do
    local original = Section[method]
    if original then
        Section[method] = function(self, props, ...)
            return original(self, rayfieldProps(props or {}), ...)
        end
    end
end

-- The section a Tab-level call lands in: the most recently added one, or a
-- headerless section if the tab has none yet.
local function currentSection(tab)
    local last = tab.sections and tab.sections[#tab.sections]
    if last and last.shell and last.shell.Parent then return last end
    return tab:CreateSection({ name = "" })
end

for _, method in ipairs({
    "CreateToggle", "CreateSwitch", "CreateButton", "CreateSlider",
    "CreateDropdown", "CreateMultiDropdown", "CreateDropdownMulti",
    "CreateInput", "CreateParagraph", "CreateLabel", "CreateDivider",
    "CreateGroup", "Dropdown",
}) do
    Tab[method] = function(self, ...)
        local section = currentSection(self)
        return section[method](section, ...)
    end
end

-- Rayfield's entry point. Stage 1 of the loading sequence runs inline, so the
-- window already exists when this returns and tabs can be added right away.
function LIBRARY:CreateWindow(cfg)
    cfg = cfg or {}
    local saving = cfg.ConfigurationSaving or {}

    self:Init({
        name           = cfg.Name or cfg.name or cfg.Title,
        subtitle       = cfg.LoadingSubtitle or cfg.Subtitle or cfg.subtitle,
        accent         = cfg.Accent or cfg.accent,
        autoSave       = saving.Enabled,
        autoLoadConfig = saving.FileName,
    })

    return State.Window
end

LIBRARY.LoadConfiguration = function(self, name)
    return self:loadConfig(name, true)
end

return LIBRARY
