-- A full-screen holder carrying a UIScale, so every panel scales together
-- without any element needing to know about it.
local function createScaleContainer(gui)
    local container = Build.frame(gui, {
        name = "NC_ScaleContainer",
        size = UDim2.fromScale(1, 1),
        transparency = 1,
        zindex = 1,
    })
    container.BackgroundTransparency = 1

    local scale = Instance.new("UIScale")
    scale.Scale = Theme.UIScale
    scale.Parent = container

    UI_SCALE_CONTAINER = scale
    return container
end

