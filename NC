LIBRARY.Name = "NC"
LIBRARY.Version = "1.0.0"

-- Guard so a double-execute cannot leave two interfaces fighting for input.
local function existingInterface()
    if gethui then
        local ok, hub = pcall(gethui)
        if ok and hub then
            local found = hub:FindFirstChild(FOLDER_NAME)
            if found then return found end
        end
    end
    local core = game:GetService("CoreGui")
    for _, child in ipairs(core:GetChildren()) do
        if child.Name == FOLDER_NAME then return child end
    end
    return nil
end

-- Destroys a previously-built interface, so re-running the script is safe.
function LIBRARY:Unload()
    local old = existingInterface()
    if old then
        pcall(function() old:Destroy() end)
    end
end

LIBRARY.UnloadExisting = LIBRARY.Unload

